# 复制为 .env.payment 并填入真实值；.env.payment 已被 .gitignore 忽略，不要提交。
# 也可以不填 CAM 密钥，脚本会直接使用 CloudBase CLI（cloudbase login）的本机授权登录态。

# ── 虚拟支付（paymentMutation 必填）──
VIRTUAL_PAY_OFFER_ID=
# 部署脚本按 --target 选择对应 AppKey，不再手动填写 VIRTUAL_PAY_ENV，避免环境与密钥错配。
VIRTUAL_PAY_APP_KEY_PRODUCTION=
VIRTUAL_PAY_APP_KEY_SANDBOX=
# 查单兜底用的小程序凭证（paymentMutation 必填）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 支付通知验签（paymentNotify 必填）──
# 自定义随机 Token，必须与小程序后台「消息推送」配置一致
PAYMENT_MESSAGE_TOKEN=

# ── 会员到期提醒（可选；不填时提醒功能静默关闭）──
# 小程序后台「订阅消息」申领的会员到期提醒模板 ID；客户端会从 paymentMutation 自动读取
MEMBERSHIP_TEMPLATE_ID=
# 到期前多少天提醒，默认 3
#MEMBERSHIP_REMIND_DAYS=3
# 模板字段名（在模板详情中查看，默认 thing1/time2/thing3）
#MEMBERSHIP_TITLE_FIELD=thing1
#MEMBERSHIP_DATE_FIELD=time2
#MEMBERSHIP_NOTE_FIELD=thing3
# 调试体验版时改为 developer 或 trial
#MEMBERSHIP_MINIPROGRAM_STATE=

# ── 道具 ID 映射（可选；后台道具 ID 与默认值一致时无需填写）──
#VIRTUAL_PAY_PRODUCT_PLUS_31D=plus_31d_v1
#VIRTUAL_PAY_PRODUCT_PLUS_372D=plus_372d_v1
#VIRTUAL_PAY_PRODUCT_PRO_372D=pro_372d_v1

# ── 静态 CAM 密钥（可选，优先于 CLI 登录态）──
#TENCENTCLOUD_SECRETID=
#TENCENTCLOUD_SECRETKEY=
#TENCENTCLOUD_SESSIONTOKEN=
