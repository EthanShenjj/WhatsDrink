.tab-bar {
  position: fixed;
  z-index: 100;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  display: flex;
  box-sizing: border-box;
  min-height: 112rpx;
  overflow: hidden;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.06);
  border-radius: 56rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 18rpx 48rpx rgba(28, 27, 24, 0.13);
  color: #aaa7a1;
}

.tab-item {
  position: relative;
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 46rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.tab-label {
  overflow: hidden;
  max-width: 100%;
  font-size: 21rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-selected {
  background: #f1eee9;
  color: #1c1b18;
}

.is-selected::after {
  position: absolute;
  bottom: 5rpx;
  width: 26rpx;
  height: 4rpx;
  border-radius: 99rpx;
  background: #9d6548;
  content: "";
}
