.tab-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  min-height: calc(128rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  padding: 10rpx 24rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(211, 195, 188, 0.34);
  background: #fdfcfb;
  box-shadow: 0 -16rpx 44rpx rgba(74, 52, 39, 0.035);
  color: #4f453f;
}

.tab-item {
  position: relative;
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  gap: 6rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.tab-label {
  overflow: hidden;
  max-width: 100%;
  font-size: 20rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-selected {
  color: #97472c;
}

.is-selected::after {
  position: absolute;
  bottom: 4rpx;
  width: 30rpx;
  height: 4rpx;
  border-radius: 99rpx;
  background: #97472c;
  content: "";
}
