.tab-bar {
  position: fixed;
  z-index: 100;
  right: 18rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  left: 18rpx;
  display: flex;
  box-sizing: border-box;
  min-height: 126rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,.9);
  border-radius: 36rpx;
  background: rgba(255,255,255,.94);
  box-shadow: 0 18rpx 54rpx rgba(49,57,121,.2);
  backdrop-filter: blur(24rpx);
}

.tab-item {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 108rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 0;
  transition: transform 180ms ease;
}

.tab-item:active { transform: scale(.95); }

.tab-icon-wrap {
  position: relative;
  display: flex;
  width: 70rpx;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
}

.tab-icon { width: 40rpx; height: 40rpx; opacity: .48; }
.is-selected .tab-icon { opacity: 1; }

.tab-label {
  overflow: hidden;
  max-width: 100%;
  color: #6F7489;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-selected .tab-label { color: #3E47C8; }
.tab-selected-indicator { position: absolute; bottom: 2rpx; width: 24rpx; height: 5rpx; border-radius: 99rpx; background: #5B6CFF; }

.tab-item-add { transform: translateY(-10rpx); }
.tab-item-add:active { transform: translateY(-10rpx) scale(.95); }
.tab-item-add .tab-icon-wrap {
  width: 82rpx;
  height: 82rpx;
  border: 5rpx solid rgba(255,255,255,.96);
  border-radius: 41rpx;
  background: linear-gradient(135deg, #5B76FF, #A88BFF);
  box-shadow: 0 8rpx 22rpx rgba(91,108,255,.24);
}
.tab-add-pin { width: 42rpx; height: 42rpx; filter: brightness(0) invert(1); }
.tab-add-plus { position: absolute; right: 14rpx; bottom: 14rpx; width: 20rpx; height: 20rpx; }
.tab-item-add .tab-label { margin-top: 1rpx; color: #4A4F73; }
