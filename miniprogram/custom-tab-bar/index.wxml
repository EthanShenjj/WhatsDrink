<view wx:if="{{!hidden}}" class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'is-selected' : ''}} {{index === 2 ? 'tab-item-add' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    role="button"
    aria-label="{{item.text}}"
    aria-current="{{selected === index ? 'page' : ''}}"
  >
    <view class="tab-icon-wrap">
      <block wx:if="{{index === 2}}">
        <image class="tab-add-pin" src="/assets/icons/location.svg" mode="aspectFit" aria-hidden="true" />
        <image class="tab-add-plus" src="/assets/icons/add-white.svg" mode="aspectFit" aria-hidden="true" />
      </block>
      <image
        wx:else
        class="tab-icon"
        src="/assets/icons/{{item.icon}}.svg"
        mode="aspectFit"
        aria-hidden="true"
      />
    </view>
    <text class="tab-label">{{item.text}}</text>
    <view wx:if="{{selected === index && index !== 2}}" class="tab-selected-indicator"></view>
  </view>
</view>
