<view wx:if="{{!hidden}}" class="tab-bar-backdrop" aria-hidden="true"></view>
<view wx:if="{{!hidden}}" class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'is-selected' : ''}} {{index === 2 ? 'tab-item-add' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    role="button"
    aria-label="{{item.text}}"
    aria-current="{{selected === index ? 'page' : ''}}"
  >
    <view class="tab-icon-wrap">
      <block wx:if="{{index === 2}}">
        <image class="tab-add-pin" src="/assets/icons/location-white.svg" mode="aspectFit" aria-hidden="true" />
        <image class="tab-add-plus" src="/assets/icons/add-white.svg" mode="aspectFit" aria-hidden="true" />
      </block>
      <image
        wx:else
        class="tab-icon"
        src="/assets/icons/{{item.icon}}{{selected === index ? '-active' : ''}}.svg"
        mode="aspectFit"
        aria-hidden="true"
      />
    </view>
    <text class="tab-label">{{item.text}}</text>
    <view wx:if="{{selected === index && index !== 2}}" class="tab-selected-indicator"></view>
  </view>
</view>

<view wx:if="{{sheetVisible || sheetClosing}}" class="tab-sheet-layer {{sheetClosing ? 'is-closing' : ''}}" catchtouchmove="noop">
  <view class="tab-sheet-mask" bindtap="closeSheet"></view>
  <view class="tab-sheet" role="dialog" aria-label="添加记录">
    <view class="tab-sheet-handle"></view>
    <view class="tab-sheet-option" data-index="3" bindtap="chooseAction" role="button" aria-label="点亮去过的城市">
      <view class="tab-sheet-icon"><local-icon name="sparkles" size="34rpx" /></view>
      <view class="tab-sheet-copy">
        <text class="tab-sheet-title">点亮去过的城市</text>
        <text class="tab-sheet-sub">无需照片和定位，先把地图变成自己的</text>
      </view>
      <text class="tab-sheet-arrow">›</text>
    </view>
    <view class="tab-sheet-option" data-index="0" bindtap="chooseAction" role="button" aria-label="当前位置打卡">
      <view class="tab-sheet-icon is-checkin"><local-icon name="locate-white" size="34rpx" /></view>
      <view class="tab-sheet-copy">
        <text class="tab-sheet-title">当前位置打卡</text>
        <text class="tab-sheet-sub">到店后获取位置，快速记录这次到访</text>
      </view>
      <text class="tab-sheet-arrow">›</text>
    </view>
    <view class="tab-sheet-option" data-index="1" bindtap="chooseAction" role="button" aria-label="手动记录足迹">
      <view class="tab-sheet-icon"><local-icon name="location" size="34rpx" /></view>
      <view class="tab-sheet-copy">
        <text class="tab-sheet-title">手动记录足迹</text>
        <text class="tab-sheet-sub">先留下回忆，也可以稍后补充地图位置</text>
      </view>
      <text class="tab-sheet-arrow">›</text>
    </view>
    <view class="tab-sheet-option" data-index="2" bindtap="chooseAction" role="button" aria-label="添加想去">
      <view class="tab-sheet-icon is-wish"><local-icon name="heart" size="34rpx" /></view>
      <view class="tab-sheet-copy">
        <text class="tab-sheet-title">添加想去</text>
        <text class="tab-sheet-sub">收藏想去的地点，等待实现</text>
      </view>
      <text class="tab-sheet-arrow">›</text>
    </view>
    <button class="tab-sheet-cancel" bindtap="closeSheet">取消</button>
    <view class="tab-sheet-safe"></view>
  </view>
</view>
