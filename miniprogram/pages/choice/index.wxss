.choice-page > .eyebrow,
.choice-page > .display-title {
  display: block;
}

.choice-page > .display-title {
  margin-top: 9rpx;
  font-size: 56rpx;
}

.choice-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.wheel-panel {
  margin-top: 30rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.045);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.wheel-panel-header {
  display: flex;
  min-height: 52rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.wheel-picker {
  display: block;
  width: 100%;
}

.wheel-name-control {
  display: flex;
  width: 100%;
  min-height: var(--control-height);
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 0 20rpx;
  border: 0;
  border-radius: 20rpx;
  background: var(--surface-soft);
  color: var(--ink);
}

.wheel-name {
  display: block;
}

.wheel-control-label {
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  white-space: nowrap;
}

.wheel-name {
  overflow: hidden;
  min-width: 0;
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wheel-panel-footer {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.wheel-actions {
  display: flex;
  flex: 0 0 164rpx;
  justify-content: flex-end;
  gap: 8rpx;
}

.wheel-action-button {
  display: flex;
  width: 78rpx;
  height: 72rpx;
  flex: 0 0 78rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  padding: 0;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--surface-soft);
  color: var(--accent-deep);
  font-size: 20rpx;
  line-height: 1.1;
}

.candidate-copy {
  min-width: 0;
  flex: 1;
}

.candidate-count,
.candidate-summary {
  display: block;
}

.candidate-summary {
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-count {
  color: var(--ink);
  font-size: var(--text-small);
  font-weight: 600;
}

.motion-toggle {
  display: flex;
  min-width: 124rpx;
  min-height: 52rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 99rpx;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1;
  white-space: nowrap;
}

.control-hover {
  opacity: 0.66;
}

.spin-button {
  width: 440rpx;
  min-height: 92rpx;
  margin: 0 auto;
  border-radius: 46rpx;
  font-size: 31rpx;
}

.spin-button.is-spinning {
  opacity: 0.68;
}

.validation {
  display: block;
  margin-top: 18rpx;
  color: var(--danger);
  font-size: var(--text-caption);
  text-align: center;
}

.result-panel {
  margin-top: 38rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.045);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.result-kicker,
.result-name {
  display: block;
}

.result-kicker {
  color: var(--muted);
  font-size: var(--text-caption);
}

.result-name {
  margin: 12rpx 0 26rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.result-panel .secondary-button {
  gap: 10rpx;
  margin: 0 auto;
}
