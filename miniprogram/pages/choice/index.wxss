.choice-page > .eyebrow,
.choice-page > .display-title {
  display: block;
}

.choice-page > .display-title {
  margin-top: 9rpx;
  font-size: 48rpx;
}

.choice-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 27rpx;
  line-height: 42rpx;
}

.mode-switch {
  display: flex;
  width: 480rpx;
  max-width: 100%;
  margin-top: 72rpx;
  padding: 6rpx;
  border-radius: 52rpx;
  background: var(--surface-soft);
}

.mode-tab {
  display: flex;
  min-height: 68rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 46rpx;
  color: var(--muted);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
  transition:
    color 180ms ease,
    background-color 180ms ease,
    box-shadow 180ms ease;
}

.mode-tab.is-active {
  background: var(--accent-action);
  box-shadow: 0 10rpx 24rpx rgba(50, 31, 19, 0.12);
  color: #ffffff;
}

.wheel-panel {
  margin-top: 32rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(211, 195, 188, 0.16);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.wheel-panel-header {
  display: flex;
  min-height: 52rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.wheel-picker {
  display: block;
  width: 100%;
}

.wheel-name-control {
  display: flex;
  width: 100%;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(211, 195, 188, 0.24);
  border-radius: 32rpx;
  background: var(--surface-soft);
  color: var(--ink);
}

.wheel-name {
  display: block;
}

.wheel-control-label {
  color: var(--outline);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  white-space: nowrap;
}

.wheel-name {
  overflow: hidden;
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wheel-panel-footer {
  display: flex;
  min-height: 88rpx;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.wheel-actions {
  display: flex;
  flex: 0 0 208rpx;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 2rpx;
}

.wheel-action-button {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  padding: 0;
  border: 0;
  border-radius: 32rpx;
  background: var(--surface-soft);
  color: var(--accent-deep);
  font-size: 20rpx;
  line-height: 1.1;
}

.candidate-copy {
  min-width: 0;
  flex: 1;
}

.candidate-count,
.candidate-summary {
  display: block;
}

.candidate-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.candidate-count {
  color: var(--ink);
  font-size: var(--text-small);
  font-weight: 600;
}

.motion-toggle {
  display: flex;
  min-width: 124rpx;
  min-height: 52rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 99rpx;
  background: var(--surface-high);
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1;
  white-space: nowrap;
}

.motion-toggle.is-disabled {
  opacity: 0.48;
}

.control-hover {
  opacity: 0.66;
}

.wheel-stage {
  display: flex;
  width: 100%;
  height: 688rpx;
  align-items: center;
  justify-content: center;
}

.wheel-canvas {
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  filter: drop-shadow(0 22rpx 30rpx rgba(77, 52, 39, 0.16));
}

@media (max-height: 760px) {
  .wheel-stage {
    height: 540rpx;
  }

  .wheel-canvas {
    width: 480rpx;
    height: 480rpx;
  }
}

.spin-button {
  width: 520rpx;
  max-width: calc(100% - 80rpx);
  min-height: 104rpx;
  margin: 0 auto;
  border-radius: 52rpx;
  font-size: 31rpx;
}

.spin-button.is-spinning {
  opacity: 0.68;
}

.spin-button.is-result,
.claw-grab-button.is-result {
  background: var(--accent-action);
  font-size: 28rpx;
  white-space: nowrap;
}

.decision-status {
  display: flex;
  min-height: 52rpx;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
  color: var(--accent-deep);
  font-size: 25rpx;
  font-weight: 650;
  opacity: 0;
  text-align: center;
  transition: opacity 180ms ease;
}

.decision-status.is-visible {
  opacity: 1;
}

.retry-button {
  display: block;
  min-height: 52rpx;
  margin: 0 auto;
  padding: 0 28rpx;
  color: var(--accent-deep);
  font-size: 23rpx;
  line-height: 52rpx;
}

.validation {
  display: block;
  margin-top: 18rpx;
  color: var(--danger);
  font-size: var(--text-caption);
  text-align: center;
}

.choice-tip {
  margin-top: 44rpx;
  padding: 32rpx 36rpx;
  border: 1rpx solid rgba(211, 195, 188, 0.24);
  border-radius: 32rpx;
  background: rgba(250, 249, 246, 0.76);
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.claw-experience {
  margin-top: 36rpx;
}

.claw-machine-stage {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 1030rpx;
  border: 1rpx solid rgba(211, 195, 188, 0.16);
  border-radius: 48rpx;
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.claw-machine-image {
  position: absolute;
  top: 0;
  left: 50%;
  width: 566rpx;
  transform: translateX(-50%);
}

.claw-machine-fallback {
  position: absolute;
  top: 24rpx;
  right: 54rpx;
  bottom: 24rpx;
  left: 54rpx;
  overflow: hidden;
  border: 5rpx solid #e7ddd2;
  border-radius: 42rpx;
  background: #fffaf4;
  box-shadow: inset 0 0 44rpx rgba(120, 84, 58, 0.08);
}

.claw-fallback-top {
  display: flex;
  height: 116rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 34rpx;
  border-bottom: 5rpx solid #e7ddd2;
  color: var(--accent-deep);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.claw-fallback-lights {
  display: flex;
  gap: 14rpx;
}

.claw-fallback-lights view {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #321f13;
}

.claw-fallback-lights view:nth-child(2) {
  background: #d37556;
}

.claw-fallback-lights view:nth-child(3) {
  background: #e8d0c0;
}

.claw-fallback-glass {
  position: relative;
  height: 540rpx;
  margin: 28rpx;
  overflow: hidden;
  border: 5rpx solid #e7ddd2;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #ffffff, #f9efe6);
}

.claw-fallback-rail {
  position: absolute;
  top: 40rpx;
  right: 24rpx;
  left: 24rpx;
  height: 12rpx;
  border-radius: 99rpx;
  background: #8a6e5d;
}

.claw-fallback-hook {
  position: absolute;
  top: 48rpx;
  left: 50%;
  width: 78rpx;
  height: 164rpx;
  border-right: 8rpx solid #4d3527;
  border-bottom: 8rpx solid #4d3527;
  border-left: 8rpx solid #4d3527;
  border-radius: 0 0 44rpx 44rpx;
  transform: translateX(-50%);
}

.claw-fallback-cups {
  position: absolute;
  right: 26rpx;
  bottom: 20rpx;
  left: 26rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.claw-fallback-cups view {
  width: 74rpx;
  height: 126rpx;
  border: 5rpx solid #d5b49d;
  border-radius: 12rpx 12rpx 28rpx 28rpx;
  background: linear-gradient(to bottom, #fffdf9 12%, #bc7650 13%, #d9a071 58%, #f2e3d4 59%);
}

.claw-fallback-cups view:nth-child(2),
.claw-fallback-cups view:nth-child(4) {
  height: 104rpx;
  transform: rotate(9deg);
}

.claw-fallback-console {
  position: relative;
  height: 98rpx;
  margin: 0 44rpx;
  border-radius: 28rpx;
  background: #f2e9df;
}

.claw-fallback-stick {
  position: absolute;
  bottom: 20rpx;
  left: 68rpx;
  width: 14rpx;
  height: 60rpx;
  border-radius: 99rpx;
  background: #5f4333;
}

.claw-fallback-stick::before {
  position: absolute;
  top: -22rpx;
  left: -13rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f5eadc;
  box-shadow: 0 4rpx 10rpx rgba(50, 31, 19, 0.16);
  content: "";
}

.claw-fallback-button {
  position: absolute;
  top: 28rpx;
  right: 74rpx;
  width: 52rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #d37556;
  box-shadow: 0 4rpx 8rpx rgba(50, 31, 19, 0.18);
}

.claw-fallback-chute {
  width: 250rpx;
  height: 88rpx;
  margin: 28rpx auto 0;
  border: 5rpx solid #e7ddd2;
  border-radius: 24rpx;
  color: var(--outline);
  font-size: 20rpx;
  line-height: 78rpx;
  text-align: center;
}

.claw-arm {
  position: absolute;
  top: 208rpx;
  left: 50%;
  z-index: 4;
  width: 78rpx;
  transform: translate(-50%, 0);
  transform-origin: 50% 8%;
  transition:
    left 620ms cubic-bezier(0.22, 0.74, 0.22, 1),
    transform 620ms cubic-bezier(0.22, 0.74, 0.22, 1);
}

.phase-lowering .claw-arm {
  transform: translate(-50%, 168rpx);
}

.phase-gripping .claw-arm {
  transform: translate(-50%, 168rpx) scaleX(0.84);
}

.phase-lifting .claw-arm {
  transform: translate(-50%, 0) scaleX(0.84);
}

.phase-releasing .claw-arm,
.phase-rolling .claw-arm,
.phase-won .claw-arm {
  transform: translate(-50%, 0);
}

.claw-prize-window {
  position: absolute;
  top: 392rpx;
  right: 126rpx;
  left: 126rpx;
  z-index: 2;
  overflow: hidden;
  height: 272rpx;
  border-radius: 28rpx;
  transform: translateZ(0);
}

.claw-prize-pool {
  position: relative;
  width: 100%;
  height: 100%;
}

.claw-prize {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100rpx;
  height: 182rpx;
  transform-origin: 50% 92%;
  transition:
    transform 760ms cubic-bezier(0.2, 0.82, 0.22, 1),
    opacity 700ms ease;
}

.claw-prize-image {
  position: absolute;
  inset: 0;
  width: 100%;
}

.claw-prize:nth-child(1) {
  bottom: -30rpx;
  left: 18rpx;
  z-index: 4;
  transform: rotate(-28deg);
}

.claw-prize:nth-child(2) {
  bottom: 20rpx;
  left: 86rpx;
  z-index: 1;
  transform: rotate(18deg) scale(0.88);
}

.claw-prize:nth-child(3) {
  bottom: -38rpx;
  left: 154rpx;
  z-index: 5;
  transform: rotate(-8deg);
}

.claw-prize:nth-child(4) {
  bottom: 14rpx;
  left: 226rpx;
  z-index: 2;
  transform: rotate(24deg) scale(0.9);
}

.claw-prize:nth-child(5) {
  right: 14rpx;
  bottom: -28rpx;
  left: auto;
  z-index: 6;
  transform: rotate(-24deg);
}

.claw-prize:nth-child(6) {
  bottom: 68rpx;
  left: 18rpx;
  z-index: 0;
  transform: rotate(8deg) scale(0.76);
}

.claw-prize:nth-child(7) {
  bottom: 80rpx;
  left: 148rpx;
  z-index: 0;
  transform: rotate(-12deg) scale(0.74);
}

.claw-prize:nth-child(8) {
  right: 18rpx;
  bottom: 72rpx;
  left: auto;
  z-index: 0;
  transform: rotate(6deg) scale(0.76);
}

.claw-prize:nth-child(n + 9) {
  z-index: 0;
  width: 86rpx;
  height: 156rpx;
  opacity: 0.92;
}

.claw-prize:nth-child(9) {
  bottom: 100rpx;
  left: 8rpx;
  transform: rotate(-5deg) scale(0.66);
}

.claw-prize:nth-child(10) {
  bottom: 112rpx;
  left: 76rpx;
  transform: rotate(9deg) scale(0.66);
}

.claw-prize:nth-child(11) {
  bottom: 96rpx;
  left: 144rpx;
  transform: rotate(-10deg) scale(0.66);
}

.claw-prize:nth-child(12) {
  bottom: 112rpx;
  left: 212rpx;
  transform: rotate(7deg) scale(0.66);
}

.claw-prize:nth-child(13) {
  right: 8rpx;
  bottom: 100rpx;
  left: auto;
  transform: rotate(-6deg) scale(0.66);
}

.claw-prize:nth-child(14) {
  bottom: 130rpx;
  left: 42rpx;
  transform: rotate(12deg) scale(0.62);
}

.claw-prize:nth-child(15) {
  bottom: 136rpx;
  left: 110rpx;
  transform: rotate(-8deg) scale(0.62);
}

.claw-prize:nth-child(16) {
  bottom: 128rpx;
  left: 178rpx;
  transform: rotate(6deg) scale(0.62);
}

.claw-prize:nth-child(17) {
  bottom: 136rpx;
  left: 246rpx;
  transform: rotate(-12deg) scale(0.62);
}

.claw-prize:nth-child(18) {
  right: 18rpx;
  bottom: 128rpx;
  left: auto;
  transform: rotate(8deg) scale(0.62);
}

.claw-prize:nth-child(19) {
  bottom: 150rpx;
  left: 104rpx;
  transform: rotate(-4deg) scale(0.56);
}

.claw-prize:nth-child(20) {
  bottom: 150rpx;
  left: 240rpx;
  transform: rotate(-4deg) scale(0.68);
}

.claw-prize.is-grabbing {
  opacity: 0;
  transform: scale(0.7) rotate(0);
}

.claw-carried-prize {
  position: absolute;
  top: 470rpx;
  left: 50%;
  z-index: 5;
  width: 82rpx;
  height: 150rpx;
  opacity: 1;
  transform: translateX(-50%);
  transform-origin: 50% 8%;
  transition:
    top 620ms cubic-bezier(0.22, 0.74, 0.22, 1),
    opacity 520ms ease,
    transform 620ms cubic-bezier(0.22, 0.74, 0.22, 1);
}

.claw-carried-image,
.claw-output-image {
  position: absolute;
  inset: 0;
  width: 100%;
}

.claw-output-label {
  position: absolute;
  top: 82rpx;
  right: 13rpx;
  left: 13rpx;
  z-index: 1;
  overflow: hidden;
  color: #4a2b19;
  font-size: 12rpx;
  font-weight: 700;
  line-height: 14rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phase-lifting .claw-carried-prize {
  top: 302rpx;
}

.phase-releasing .claw-carried-prize {
  top: 700rpx;
  opacity: 0;
  transform: translateX(-50%) rotate(34deg) scale(0.62);
}

.claw-output-prize {
  position: absolute;
  top: 850rpx;
  left: 50%;
  z-index: 8;
  width: 68rpx;
  height: 124rpx;
  transform: translateX(-50%);
  animation: claw-prize-roll 880ms cubic-bezier(0.2, 0.72, 0.24, 1) both;
}

.claw-output-label {
  top: 68rpx;
  right: 10rpx;
  left: 10rpx;
  font-size: 10rpx;
  line-height: 13rpx;
}

@keyframes claw-prize-roll {
  0% {
    opacity: 0;
    transform: translate(-86rpx, -38rpx) rotate(-82deg) scale(0.72);
  }

  18% {
    opacity: 1;
  }

  62% {
    transform: translate(18rpx, 8rpx) rotate(24deg) scale(0.92);
  }

  100% {
    opacity: 1;
    transform: translate(92rpx, 20rpx) rotate(68deg);
  }
}

.claw-controls {
  display: flex;
  width: 480rpx;
  max-width: calc(100% - 64rpx);
  flex-direction: column;
  align-items: center;
  margin: 28rpx auto 0;
}

.claw-grab-button {
  width: 100% !important;
  min-height: 96rpx;
  margin: 0 !important;
  border-radius: 48rpx;
  font-size: 28rpx;
}

.claw-grab-button.is-busy {
  background: #5c4336 !important;
  color: #ffffff !important;
  opacity: 1 !important;
}

.claw-helper {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 36rpx;
  text-align: center;
}

.sr-only {
  position: fixed;
  overflow: hidden;
  width: 1px;
  height: 1px;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}
