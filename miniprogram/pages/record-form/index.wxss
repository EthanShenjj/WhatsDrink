.form-intro {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: var(--text-small);
  line-height: 1.6;
}

.photo-field {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
  margin-top: 44rpx;
}

.photo-preview {
  width: 150rpx;
  height: 150rpx;
  border-radius: 24rpx;
  background: var(--paper-deep);
}

.photo-button {
  display: flex;
  min-height: var(--control-height);
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-control);
  background: rgba(255, 250, 241, 0.4);
  color: var(--ink);
  font-size: var(--text-small);
}

.photo-remove {
  color: var(--danger);
}

.form-section {
  margin-top: 58rpx;
  padding-top: 44rpx;
  border-top: 1rpx solid var(--line);
}

.form-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-note {
  color: var(--muted);
  font-size: var(--text-caption);
}

.required-mark {
  color: var(--danger);
}

.form-stack {
  display: grid;
  gap: 30rpx;
  margin-top: 30rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx 22rpx;
  margin-top: 30rpx;
}

.field-full {
  grid-column: 1 / -1;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.field-value,
.field-input,
.unit-input {
  display: flex;
  width: 100%;
  min-height: var(--control-height);
  align-items: center;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-control);
  background: rgba(255, 250, 241, 0.5);
  font-size: var(--text-body);
}

.unit-input {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
}

.unit-input text {
  color: var(--muted);
  font-size: var(--text-caption);
}

.field-help {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.is-error {
  border-color: var(--danger);
  box-shadow: 0 0 0 2rpx rgba(165, 75, 63, 0.08);
}

.field-error {
  display: block;
  margin-top: 10rpx;
  color: var(--danger);
  font-size: var(--text-caption);
  line-height: 1.45;
}

.note-input {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-control);
  background: rgba(255, 250, 241, 0.5);
  font-size: var(--text-body);
  line-height: 1.7;
}

.submit-button {
  margin-top: 50rpx;
}

.delete-record-button {
  width: 100%;
  margin-top: 24rpx;
  border-color: rgba(165, 75, 63, 0.45);
  color: var(--danger);
}

@media (max-width: 360px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .field-full {
    grid-column: auto;
  }
}
