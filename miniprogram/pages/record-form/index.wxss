.form-intro {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: var(--text-small);
  line-height: 1.6;
}

.photo-field {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 48rpx;
}

.photo-button {
  position: relative;
  display: flex;
  width: 100% !important;
  min-height: 326rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  border: 0;
  border-radius: var(--radius-card);
  background: var(--surface-high);
  box-shadow: var(--shadow-card);
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.photo-button::after {
  border: 0;
}

.photo-preview {
  position: absolute;
  width: 100%;
  height: 100%;
  inset: 0;
}

.photo-button.has-photo::before {
  position: absolute;
  z-index: 1;
  background: rgba(50, 31, 19, 0.28);
  content: "";
  inset: 0;
}

.photo-button-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 18rpx;
}

.has-photo .photo-button-content {
  color: #ffffff;
}

.photo-icon {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 32rpx rgba(74, 52, 39, 0.08);
}

.photo-remove {
  align-self: center;
  color: var(--danger);
}

.form-section {
  margin-top: 32rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(211, 195, 188, 0.16);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.form-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-note {
  color: var(--muted);
  font-size: var(--text-caption);
}

.required-mark {
  color: var(--danger);
}

.form-stack {
  display: grid;
  gap: 32rpx;
  margin-top: 36rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx 20rpx;
  margin-top: 36rpx;
}

.field-full {
  grid-column: 1 / -1;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--outline);
  font-size: var(--text-caption);
  font-weight: 600;
}

.field-value,
.field-input,
.unit-input {
  display: flex;
  width: 100%;
  min-height: var(--control-height);
  align-items: center;
  padding: 0 22rpx;
  border: 0;
  border-radius: 48rpx;
  background: var(--surface-soft);
  font-size: var(--text-body);
}

.unit-input {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
}

.unit-input text {
  color: var(--muted);
  font-size: var(--text-caption);
}

.field-help {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.is-error {
  border-color: var(--danger);
  box-shadow: 0 0 0 2rpx rgba(165, 75, 63, 0.08);
}

.field-error {
  display: block;
  margin-top: 10rpx;
  color: var(--danger);
  font-size: var(--text-caption);
  line-height: 1.45;
}

.note-input {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx;
  border: 0;
  border-radius: var(--radius-control);
  background: var(--surface-soft);
  font-size: var(--text-body);
  line-height: 1.7;
}

.submit-button {
  width: 100% !important;
  max-width: none !important;
  margin-top: 64rpx;
  margin-right: 0 !important;
  margin-left: 0 !important;
}

.cancel-record-button {
  width: 100% !important;
  max-width: none !important;
  margin-top: 20rpx;
  margin-right: 0 !important;
  margin-left: 0 !important;
}

.delete-record-button {
  width: 100%;
  margin-top: 24rpx;
  border: 1rpx solid rgba(186, 26, 26, 0.22);
  background: var(--surface);
  color: var(--danger);
}

@media (max-width: 360px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .field-full {
    grid-column: auto;
  }
}
