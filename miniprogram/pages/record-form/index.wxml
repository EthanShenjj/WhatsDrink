<view class="page-shell form-page">
  <text class="eyebrow">NEW DRINK</text>
  <text class="display-title">{{editingId ? '编辑这一杯' : '记下这一杯'}}</text>
  <text class="form-intro">先记下喝了什么，其他信息都可以稍后补充。</text>

  <view class="photo-field">
    <button class="photo-button {{pendingPhotoPath || photoPath ? 'has-photo' : ''}}" bindtap="choosePhoto">
      <image
        wx:if="{{pendingPhotoPath || photoPath}}"
        class="photo-preview"
        src="{{pendingPhotoPath || photoPath}}"
        mode="aspectFill"
      />
      <view class="photo-button-content">
        <view class="photo-icon">
          <wd-icon name="camera" size="46rpx" />
        </view>
        <text>{{pendingPhotoPath || photoPath ? '更换照片' : '添加照片（可选）'}}</text>
      </view>
    </button>
    <button
      wx:if="{{pendingPhotoPath || photoPath}}"
      class="text-button photo-remove"
      bindtap="removePhoto"
    >
      移除
    </button>
  </view>

  <view class="form-section">
    <view class="form-section-head">
      <text class="section-title">饮品信息</text>
      <text class="section-note"><text class="required-mark">*</text> 为必填</text>
    </view>

    <view class="form-stack">
      <view class="field">
        <text class="field-label">分类</text>
        <picker
          range="{{categoryLabels}}"
          value="{{categoryIndex}}"
          bindchange="changeCategory"
          aria-label="分类，当前为 {{categoryLabels[categoryIndex]}}"
        >
          <view class="field-value">{{categoryLabels[categoryIndex]}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">品牌</text>
        <picker
          range="{{brandLabels}}"
          value="{{brandIndex}}"
          bindchange="changeBrand"
          aria-label="品牌，当前为 {{brandLabels[brandIndex]}}"
        >
          <view class="field-value">{{brandLabels[brandIndex]}}</view>
        </picker>
      </view>

      <view wx:if="{{brandIndex === brandOptions.length}}" class="field">
        <text class="field-label">自定义品牌</text>
        <input
          class="field-input"
          value="{{customBrand}}"
          placeholder="可选"
          aria-label="自定义品牌，可选"
          bindinput="updateCustomBrand"
        />
      </view>

      <view class="field drink-field">
        <text class="field-label">饮品 <text class="required-mark">*</text></text>
        <picker
          range="{{drinkLabels}}"
          value="{{drinkIndex}}"
          bindchange="changeDrink"
          aria-label="饮品，当前为 {{drinkLabels[drinkIndex] || '自定义饮品'}}"
        >
          <view class="field-value {{drinkNameError ? 'is-error' : ''}}">
            {{drinkLabels[drinkIndex] || '自定义饮品'}}
          </view>
        </picker>
      </view>

      <view wx:if="{{drinkIndex === drinkOptions.length}}" class="field">
        <text class="field-label">饮品名称 <text class="required-mark">*</text></text>
        <input
          class="field-input {{drinkNameError ? 'is-error' : ''}}"
          value="{{customDrink}}"
          maxlength="30"
          placeholder="例如：椰香冰拿铁"
          aria-label="饮品名称，必填"
          aria-invalid="{{drinkNameError ? 'true' : 'false'}}"
          bindinput="updateCustomDrink"
        />
        <text
          wx:if="{{drinkNameError}}"
          class="field-error"
          role="alert"
          aria-live="polite"
        >
          {{drinkNameError}}
        </text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">饮用信息</text>
    <view class="form-grid">
      <view class="field">
        <text class="field-label">日期</text>
        <picker
          mode="date"
          value="{{dateValue}}"
          bindchange="changeDate"
          aria-label="日期，当前为 {{dateValue}}"
        >
          <view class="field-value">{{dateValue}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">时间</text>
        <picker
          mode="time"
          value="{{timeValue}}"
          bindchange="changeTime"
          aria-label="时间，当前为 {{timeValue}}"
        >
          <view class="field-value">{{timeValue}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">杯型</text>
        <picker
          range="{{sizeOptions}}"
          value="{{sizeIndex}}"
          bindchange="changeSize"
          aria-label="杯型，当前为 {{sizeOptions[sizeIndex]}}"
        >
          <view class="field-value">{{sizeOptions[sizeIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">温度</text>
        <picker
          range="{{temperatureOptions}}"
          value="{{temperatureIndex}}"
          bindchange="changeTemperature"
          aria-label="温度，当前为 {{temperatureOptions[temperatureIndex]}}"
        >
          <view class="field-value">{{temperatureOptions[temperatureIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">甜度</text>
        <picker
          range="{{sweetnessOptions}}"
          value="{{sweetnessIndex}}"
          bindchange="changeSweetness"
          aria-label="甜度，当前为 {{sweetnessOptions[sweetnessIndex]}}"
        >
          <view class="field-value">{{sweetnessOptions[sweetnessIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">评分</text>
        <picker
          range="{{ratingOptions}}"
          value="{{ratingIndex}}"
          bindchange="changeRating"
          aria-label="评分，当前为 {{ratingOptions[ratingIndex]}}"
        >
          <view class="field-value">{{ratingOptions[ratingIndex]}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">补充记录</text>
    <view class="form-grid">
      <view class="field">
        <text class="field-label">参考热量</text>
        <view class="unit-input {{calorieError ? 'is-error' : ''}}">
          <input
            type="digit"
            value="{{calorieText}}"
            placeholder="可不填"
            aria-label="参考热量，单位千卡，可选"
            aria-invalid="{{calorieError ? 'true' : 'false'}}"
            bindinput="updateCalories"
          />
          <text>千卡</text>
        </view>
        <text class="field-help">仅供记录参考，可修改</text>
        <text
          wx:if="{{calorieError}}"
          class="field-error"
          role="alert"
          aria-live="polite"
        >
          {{calorieError}}
        </text>
      </view>
      <view class="field">
        <text class="field-label">价格</text>
        <view class="unit-input {{priceError ? 'is-error' : ''}}">
          <input
            type="digit"
            value="{{priceText}}"
            placeholder="可不填"
            aria-label="价格，单位元，可选"
            aria-invalid="{{priceError ? 'true' : 'false'}}"
            bindinput="updatePrice"
          />
          <text>元</text>
        </view>
        <text
          wx:if="{{priceError}}"
          class="field-error"
          role="alert"
          aria-live="polite"
        >
          {{priceError}}
        </text>
      </view>
      <view class="field field-full">
        <text class="field-label">备注</text>
        <textarea
          class="note-input"
          value="{{note}}"
          maxlength="200"
          auto-height
          placeholder="今天喝它时，是什么心情？"
          aria-label="备注，可选"
          bindinput="updateNote"
        />
      </view>
    </view>
  </view>

  <button
    class="primary-button submit-button"
    loading="{{authenticating || saving}}"
    disabled="{{authenticating || saving}}"
    bindtap="submit"
  >
    {{authenticating ? '正在登录…' : saving ? '正在保存…' : '保存记录'}}
  </button>
  <button
    class="secondary-button cancel-record-button"
    disabled="{{saving}}"
    bindtap="cancel"
  >
    取消
  </button>
  <button
    wx:if="{{editingId}}"
    class="secondary-button delete-record-button"
    disabled="{{saving}}"
    bindtap="removeCurrentRecord"
  >
    删除这杯记录
  </button>
  <privacy-popup />
</view>
