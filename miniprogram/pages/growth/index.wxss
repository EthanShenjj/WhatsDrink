.growth-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, var(--brand-bg) 0, var(--surface-high) 620rpx, var(--brand-bg) 100%);
}

.growth-intro { display: block; margin-top: 10rpx; color: var(--muted); font-size: 26rpx; }

.state-card {
  display: flex;
  min-height: 330rpx;
  align-items: center;
  margin-top: 34rpx;
  padding: 34rpx 22rpx 24rpx 34rpx;
  border: 1rpx solid rgba(111, 103, 195, 0.1);
  border-radius: 44rpx;
  box-shadow: 0 24rpx 60rpx rgba(70, 69, 137, 0.12);
  overflow: hidden;
}

.state-journey { background: linear-gradient(135deg, #ecefff, #f6eaff); }
.state-explore { background: linear-gradient(135deg, #fff0e2, #ffe7ef); }
.state-discover { background: linear-gradient(135deg, #e5fbff, #e8f2ff); }
.state-highlight { background: linear-gradient(135deg, #fff6cf, #fff0d9); }
.state-companion { background: linear-gradient(135deg, #fff0f7, #ffe4ef); }
.state-dawn { background: linear-gradient(135deg, #fff1df, #f6e6ff); }
.state-copy { min-width: 0; flex: 1; }
.state-kicker { display: block; color: #504b81; font-size: 24rpx; font-weight: 700; }
.state-message { display: block; margin-top: 16rpx; color: #17172c; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.state-metrics { display: flex; flex-wrap: wrap; gap: 10rpx 22rpx; margin-top: 24rpx; color: var(--muted); font-size: 22rpx; }

.goal-card { margin-top: 24rpx; padding: 28rpx 30rpx; }
.goal-head { display: flex; align-items: center; justify-content: space-between; }
.goal-label { color: var(--ink); font-size: 26rpx; font-weight: 700; }
.goal-count { color: var(--brand-primary-deep); font-size: 22rpx; font-weight: 700; }
.goal-copy { display: block; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; }
.goal-track { height: 12rpx; margin-top: 22rpx; border-radius: 99rpx; background: var(--surface-highest); overflow: hidden; }
.goal-progress { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #657ff3, #b894ff); }

.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 50rpx 4rpx 20rpx; }
.section-head view { display: flex; flex-direction: column; }
.section-sub { margin-top: 2rpx; color: var(--muted); font-size: 22rpx; }
.section-action { min-height: 56rpx; padding: 0 18rpx; border-radius: 28rpx; background: #eceaff; color: #655dc2; font-size: 22rpx; font-weight: 700; line-height: 56rpx; }

.monthly-card { display: flex; align-items: center; min-height: 184rpx; padding: 18rpx 24rpx; background: linear-gradient(120deg, #fff, #f1efff); }
.monthly-copy { min-width: 0; flex: 1; margin-left: 14rpx; }
.monthly-title { display: block; color: #2b2944; font-size: 28rpx; font-weight: 700; }
.monthly-summary { display: block; margin-top: 8rpx; color: #716e83; font-size: 22rpx; }
.monthly-meta { display: block; margin-top: 8rpx; color: var(--brand-primary-deep); font-size: 20rpx; font-weight: 600; }
.card-arrow { color: #aaa4bc; font-size: 42rpx; }

.auto-color-option {
  display: flex;
  width: 100% !important;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(70, 65, 86, 0.07);
  text-align: left;
}
.auto-color-option.is-selected { border-color: #7770e8; background: #f6f5ff; }
.auto-color-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.auto-color-title { color: var(--ink); font-size: 27rpx; font-weight: 700; line-height: 1.4; }
.auto-color-description { margin-top: 3rpx; color: var(--muted); font-size: 21rpx; line-height: 1.4; }
.auto-color-status { flex-shrink: 0; color: var(--brand-primary-deep); font-size: 21rpx; font-weight: 700; }

.color-scroll { width: calc(100vw - 32rpx); margin-right: -32rpx; }
.color-list { display: inline-flex; gap: 18rpx; padding: 4rpx 32rpx 18rpx 0; }
.color-card { position: relative; display: flex; width: 242rpx; min-height: 330rpx; align-items: center; flex-direction: column; padding: 18rpx 18rpx 22rpx; border: 2rpx solid transparent; border-radius: 34rpx; box-shadow: 0 12rpx 36rpx rgba(70, 65, 86, 0.08); }
.color-card.is-selected { border-color: #7770e8; }
.color-card.is-locked { filter: grayscale(.65); opacity: .62; }
.color-journey { background: #f1f2ff; }
.color-explore { background: #fff1e8; }
.color-discover { background: #e9faff; }
.color-highlight { background: #fff8d8; }
.color-companion { background: #fff0f6; }
.color-dawn { background: #fff0e4; }
.selected-pill, .locked-pill { position: absolute; z-index: 2; top: 16rpx; right: 14rpx; padding: 5rpx 12rpx; border-radius: 99rpx; background: #726ae1; color: #fff; font-size: 20rpx; font-weight: 700; }
.locked-pill { background: rgba(56, 51, 69, .68); }
.color-name { margin-top: 4rpx; color: #2b293b; font-size: 24rpx; font-weight: 700; }
.color-description { display: -webkit-box; margin-top: 7rpx; color: var(--muted); font-size: 20rpx; line-height: 1.45; text-align: center; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

.expression-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.expression-card { display: flex; min-width: 0; align-items: center; padding: 12rpx 4rpx 16rpx; border: 1rpx solid rgba(91,108,255,.06); border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(68,76,145,.07); flex-direction: column; }
.expression-card.is-locked { filter: grayscale(1); opacity: .48; }
.expression-name { color: #302d41; font-size: 22rpx; font-weight: 700; }
.expression-copy { width: 100%; margin-top: 4rpx; padding: 0 6rpx; color: var(--muted); font-size: 20rpx; line-height: 1.3; text-align: center; }

.hidden-card {
  padding: 8rpx 24rpx;
  background: linear-gradient(145deg, #fff 0%, #fbfaff 100%);
}
.hidden-row { display: flex; min-height: 142rpx; align-items: center; gap: 18rpx; border-bottom: 1rpx solid var(--line); }
.hidden-row:last-child { border-bottom: 0; }
.hidden-mascot {
  position: relative;
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 92rpx;
  border: 1rpx solid rgba(98, 93, 115, .09);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #f2f1f5, #e6e4ea);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.7);
  overflow: hidden;
}
.hidden-mascot-art { display: flex; align-items: center; justify-content: center; }
.hidden-row.is-hidden .hidden-mascot-art { filter: grayscale(1); opacity: .58; }
.hidden-row.is-unlocked .hidden-mascot {
  border-color: rgba(255, 183, 83, .2);
  background: linear-gradient(145deg, #fff4df, #f7e8ff);
  box-shadow: 0 8rpx 24rpx rgba(255, 183, 83, .12);
}
.hidden-mascot-mark {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: #aaa6b1;
  box-shadow: 0 2rpx 6rpx rgba(45, 42, 55, .14);
}
.hidden-copy { min-width: 0; flex: 1; }
.hidden-name { display: block; color: #484653; font-size: 24rpx; font-weight: 700; }
.hidden-row.is-unlocked .hidden-name { color: var(--ink); }
.hidden-hint { display: block; margin-top: 5rpx; color: var(--muted); font-size: 20rpx; line-height: 1.45; }
.hidden-status {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 99rpx;
  background: #f0eef3;
  color: #8a8593;
  font-size: 18rpx;
  font-weight: 600;
}
.hidden-status.is-unlocked { background: #fff0d3; color: #aa6a14; }

.icon-card { padding: 26rpx; }
.icon-preview { display: flex; width: 168rpx; height: 168rpx; align-items: center; justify-content: center; float: left; margin: 0 24rpx 16rpx 0; border-radius: 40rpx; background: linear-gradient(135deg, #678bff, #b690ff); overflow: hidden; }
.icon-explore { background: linear-gradient(135deg, #ffb67e, #f3a8ca); }
.icon-discover { background: linear-gradient(135deg, #7ddced, #a7c8ff); }
.icon-highlight { background: linear-gradient(135deg, #ffd359, #ffac57); }
.icon-companion { background: linear-gradient(135deg, #ff9fc2, #d9a7ff); }
.icon-dawn { background: linear-gradient(135deg, #ffcd96, #edb9ff); }
.icon-copy { min-height: 168rpx; padding-top: 12rpx; }
.icon-title { display: block; color: var(--ink); font-size: 28rpx; font-weight: 700; }
.icon-note { display: block; margin-top: 10rpx; color: var(--muted); font-size: 20rpx; line-height: 1.55; }
.icon-options { width: 100%; clear: both; }
.icon-option-list { display: inline-flex; gap: 16rpx; padding: 12rpx 2rpx 4rpx; }
.icon-option { display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; border: 3rpx solid transparent; border-radius: 28rpx; background: var(--surface-high); overflow: hidden; }
.icon-option.is-active { border-color: #7770e8; }
.icon-option.is-locked { filter: grayscale(1); opacity: .4; }

.plus-card { margin-top: 52rpx; padding: 38rpx 34rpx; border-radius: 36rpx; background: linear-gradient(140deg, #1f2146, #5c54b5 58%, #9871d7); box-shadow: 0 22rpx 54rpx rgba(39, 36, 91, .25); color: #fff; }
.plus-card-inline { margin-top: 26rpx; }
.plus-badge { display: inline-flex; padding: 7rpx 16rpx; border: 1rpx solid rgba(255,255,255,.38); border-radius: 99rpx; background: rgba(255,255,255,.12); font-size: 20rpx; font-weight: 700; }
.plus-title { display: block; margin-top: 20rpx; font-size: 36rpx; font-weight: 700; }
.plus-copy { display: block; margin-top: 10rpx; color: rgba(255,255,255,.8); font-size: 24rpx; line-height: 1.65; }
.plus-button { min-height: 84rpx; margin-top: 28rpx; border-radius: 42rpx; background: #fff; color: #443d9a; font-size: 28rpx; font-weight: 700; line-height: 84rpx; }
.plus-plan-link { min-height: 62rpx; margin-top: 8rpx; border: 0; background: transparent; color: rgba(255,255,255,.88); font-size: 22rpx; font-weight: 600; line-height: 62rpx; text-decoration: underline; }
.plus-plan-link::after { border: 0; }
.plus-footnote { display: block; margin-top: 16rpx; color: rgba(255,255,255,.8); font-size: 20rpx; text-align: center; }

.growth-heavy-anchor { height: 2rpx; }

.report-mask { position: fixed; z-index: 120; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(28, 25, 39, .42); }
.report-panel { display: flex; width: 100%; align-items: center; padding: 18rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 44rpx 44rpx 0 0; background: linear-gradient(180deg, #F3F2FF, var(--brand-bg)); box-shadow: 0 -24rpx 70rpx rgba(26, 22, 48, .2); flex-direction: column; }
.report-handle { width: 72rpx; height: 8rpx; border-radius: 99rpx; background: #d3cddd; }
.report-kicker { margin-top: 26rpx; color: var(--brand-primary-deep); font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.report-title { margin-top: 7rpx; color: #28263a; font-size: 34rpx; font-weight: 700; }
.report-summary { margin-top: 4rpx; color: #6f6a7b; font-size: 24rpx; text-align: center; }
.report-stats { display: grid; width: 100%; grid-template-columns: repeat(3, 1fr); margin-top: 24rpx; padding: 22rpx 0; border-radius: 28rpx; background: rgba(255,255,255,.72); }
.report-stats view { display: flex; align-items: center; color: var(--muted); font-size: 20rpx; flex-direction: column; }
.report-number { color: #413b86; font-size: 32rpx; font-weight: 700; }
.report-close { min-height: 72rpx; margin-top: 22rpx; background: transparent; color: var(--muted); font-size: 22rpx; line-height: 72rpx; }

/* 按压反馈过渡 */
.color-card { transition: opacity 160ms ease; }
