.intro {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.avatar-button {
  display: flex;
  width: 190rpx;
  height: 190rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 70rpx auto 54rpx;
  border: 8rpx solid var(--surface);
  border-radius: 50%;
  background: var(--paper-deep);
  box-shadow: var(--shadow-card);
  color: var(--muted);
  font-size: var(--text-small);
}

.avatar-button image {
  width: 100%;
  height: 100%;
}

.field {
  margin-bottom: 54rpx;
  padding: 28rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.nickname-input {
  width: 100%;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-control);
  background: var(--surface-soft);
  font-size: var(--text-control);
}
