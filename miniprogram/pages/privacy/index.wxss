.privacy-section {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.045);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.privacy-section > text:last-child {
  display: block;
  margin-top: 22rpx;
  color: var(--muted);
  font-size: 27rpx;
  line-height: 1.8;
}
