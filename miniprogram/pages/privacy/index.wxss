.privacy-section {
  margin-top: 32rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.08);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.privacy-section > text:last-child {
  display: block;
  margin-top: 24rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.75;
}

.privacy-settings-button {
  width: 100%;
  margin-top: 34rpx;
}
