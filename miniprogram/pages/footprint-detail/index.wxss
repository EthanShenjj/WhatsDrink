.detail-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.detail-loading,
.detail-photo-placeholder {
  padding: 120rpx 0;
  text-align: center;
}

.detail-visits,
.detail-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.detail-visits-info,
.detail-header-text,
.detail-note {
  display: flex;
  flex-direction: column;
}

.detail-visits-title,
.detail-poi-name {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
}

.detail-visits-sub,
.detail-location,
.detail-note-label {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.detail-visits-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.detail-visits-row {
  display: inline-flex;
  gap: 12rpx;
}

.detail-visit-chip {
  display: inline-flex;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 99rpx;
  background: var(--surface-high);
  color: var(--muted);
  font-size: 24rpx;
}

.detail-visit-chip.is-active {
  background: var(--moss-soft);
  color: var(--moss-deep);
}

.detail-gallery,
.detail-gallery-swiper,
.detail-gallery-item {
  position: relative;
  height: 620rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
}

.detail-gallery {
  margin-bottom: 24rpx;
  background: var(--surface-high);
}

.detail-gallery-image {
  width: 100%;
  height: 100%;
}

.detail-gallery-counter {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 99rpx;
  background: rgba(23, 24, 43, 0.68);
  color: #fff;
  font-size: 22rpx;
}

.detail-photo-placeholder-icon {
  display: block;
  margin-bottom: 12rpx;
  font-size: 56rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.detail-marker-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: var(--shadow-control);
}

.detail-marker-emoji,
.detail-meta-emoji {
  font-size: 34rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
}

.detail-row-text {
  flex: 1;
}

.detail-row-wishlist {
  color: var(--amber-deep);
}

.detail-meta-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-meta-item {
  display: grid;
  grid-template-columns: auto auto;
  align-items: center;
  gap: 2rpx 10rpx;
  min-width: 180rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: var(--surface-soft);
}

.detail-meta-emoji {
  grid-row: 1 / 3;
}

.detail-meta-label {
  color: var(--muted);
  font-size: 20rpx;
}

.detail-meta-value {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}

.detail-note {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.detail-note-text {
  margin-top: 10rpx;
  color: var(--ink-body);
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.detail-convert-button {
  margin: 24rpx 0;
}

.place-ring {
  margin: 30rpx 0;
  padding: 30rpx;
}

.place-ring-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.place-ring-summary {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.place-ring-list {
  margin: 26rpx 0 0 10rpx;
  border-left: 2rpx solid var(--moss-soft);
}

.place-ring-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
  padding: 0 0 24rpx 24rpx;
}

.place-ring-dot {
  position: absolute;
  top: 18rpx;
  left: -9rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--moss);
}

.place-ring-photo {
  width: 70rpx;
  height: 70rpx;
  border-radius: 12rpx;
}

.place-ring-entry-body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.place-ring-date {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 650;
}

.place-ring-note {
  overflow: hidden;
  color: var(--muted);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-ring-compare {
  margin-top: 18rpx;
}

.place-ring-comparison {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.place-ring-compare-side {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--surface-high);
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.5;
}

.place-ring-compare-side image {
  width: 100%;
  height: 150rpx;
  border-radius: 10rpx;
}

.place-ring-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin: 26rpx 0 48rpx;
}

.place-ring-actions button {
  margin: 0;
  font-size: 24rpx;
}

.detail-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  justify-content: space-around;
  padding: 18rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 34rpx rgba(68,76,145,.08);
}

.detail-action {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 6rpx;
  min-width: 130rpx;
  color: var(--ink);
}

.detail-action-label {
  font-size: 21rpx;
}

.detail-action-danger {
  color: var(--danger);
}
