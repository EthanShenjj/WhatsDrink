.detail-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.detail-cover-empty {
  position: relative;
  display: flex;
  overflow: hidden;
  min-height: 330rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 36rpx 24rpx 32rpx 36rpx;
  border: 1rpx solid rgba(91, 108, 255, .1);
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, #EEF1FF 0%, #F4EAFF 62%, #FFF0F7 100%);
  box-shadow: var(--shadow-card);
  transition: transform 160ms ease, opacity 160ms ease;
}

.detail-cover-empty--pressed {
  opacity: .88;
  transform: scale(.985);
}

.detail-cover-copy {
  position: relative;
  z-index: 2;
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
}

.detail-cover-kicker {
  color: var(--brand-primary-deep);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.detail-cover-title {
  max-width: 320rpx;
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.42;
}

.detail-cover-action {
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
  margin-top: 28rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(91, 108, 255, .16);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .78);
  color: var(--brand-primary-deep);
  font-size: 22rpx;
  font-weight: 650;
  box-shadow: 0 6rpx 18rpx rgba(91, 108, 255, .1);
}

.detail-cover-mascot {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 208rpx;
  width: 208rpx;
  height: 240rpx;
  align-items: center;
  justify-content: center;
}

.detail-cover-halo {
  position: absolute;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .58);
  box-shadow: 0 0 0 22rpx rgba(255, 255, 255, .18);
}

.detail-visits,
.detail-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.detail-visits-info,
.detail-header-text,
.detail-note {
  display: flex;
  flex-direction: column;
}

.detail-visits-title,
.detail-poi-name {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
}

.detail-visits-sub,
.detail-location,
.detail-note-label {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.detail-visits-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.detail-visits-row {
  display: inline-flex;
  gap: 12rpx;
}

.detail-visit-chip {
  display: inline-flex;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 99rpx;
  background: var(--surface-high);
  color: var(--muted);
  font-size: 24rpx;
}

.detail-visit-chip.is-active {
  background: var(--moss-soft);
  color: var(--moss-deep);
}

.detail-gallery,
.detail-gallery-swiper,
.detail-gallery-item {
  position: relative;
  height: 620rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
}

.detail-gallery {
  margin-bottom: 24rpx;
  background: var(--surface-high);
}

.detail-gallery::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  height: 150rpx;
  background: linear-gradient(to top, rgba(20, 21, 43, .42), rgba(20, 21, 43, 0));
  content: '';
  pointer-events: none;
}

.detail-gallery-image {
  width: 100%;
  height: 100%;
}

.detail-gallery-counter {
  position: absolute;
  z-index: 2;
  right: 24rpx;
  bottom: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 99rpx;
  background: rgba(23, 24, 43, 0.68);
  color: #fff;
  font-size: 22rpx;
}

.detail-gallery-edit {
  position: absolute;
  bottom: 22rpx;
  left: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .9);
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 650;
  pointer-events: none;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.detail-marker-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: var(--shadow-control);
}

.detail-marker-emoji,
.detail-meta-emoji {
  font-size: 34rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
}

.detail-row-text {
  flex: 1;
}

.detail-row-wishlist {
  color: var(--amber-deep);
}

.detail-meta-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-meta-item {
  display: grid;
  grid-template-columns: auto auto;
  align-items: center;
  gap: 2rpx 10rpx;
  min-width: 180rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: var(--surface-soft);
}

.detail-meta-emoji {
  grid-row: 1 / 3;
}

.detail-meta-label {
  color: var(--muted);
  font-size: 20rpx;
}

.detail-meta-value {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}

.detail-note {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.detail-note-text {
  margin-top: 10rpx;
  color: var(--ink-body);
  font-size: 30rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.detail-convert-button {
  margin: 24rpx 0;
}

.place-ring {
  margin: 44rpx 0 34rpx;
}

.place-ring-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.place-ring-heading-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.place-ring-subtitle {
  margin-top: 2rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.place-ring-count {
  flex: none;
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
}

.place-ring-summary {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.memory-ticket-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
}

.memory-ticket {
  position: relative;
  display: flex;
  overflow: hidden;
  min-height: 310rpx;
  border: 1rpx solid rgba(49, 53, 74, .08);
  border-radius: 28rpx;
  background: #fffdfc;
  box-shadow: 0 18rpx 48rpx rgba(55, 62, 102, .12);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.memory-ticket.is-current {
  box-shadow: 0 20rpx 56rpx rgba(64, 71, 130, .18);
}

.memory-ticket-pressed {
  transform: scale(0.985);
}

.memory-ticket-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: stretch;
  gap: 0;
}

.memory-ticket-media {
  position: relative;
  display: flex;
  overflow: hidden;
  flex: 0 0 38%;
  width: 38%;
  min-height: 310rpx;
  align-items: center;
  justify-content: center;
  background: #5b6cff;
}

.memory-ticket-photo {
  width: 100%;
  height: 100%;
}

.memory-ticket-date-cover {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 310rpx;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  padding: 26rpx 22rpx 54rpx;
  color: #fff;
}

.memory-ticket-cover-date {
  font-size: 45rpx;
  font-weight: 780;
  line-height: 1;
  letter-spacing: -1rpx;
}

.memory-ticket-cover-year {
  margin-top: 10rpx;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
  opacity: .78;
}

.memory-ticket-media-shade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 55%;
  background: linear-gradient(180deg, rgba(16, 17, 22, 0), rgba(16, 17, 22, .68));
}

.memory-ticket-media-mark {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  left: 14rpx;
  display: flex;
  justify-content: space-between;
  color: rgba(255, 255, 255, .92);
  font-size: 17rpx;
  font-weight: 650;
}

.memory-ticket-copy {
  position: relative;
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 28rpx 22rpx 26rpx 24rpx;
}

.memory-ticket-meta {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  min-height: 32rpx;
}

.memory-ticket-admit {
  overflow: hidden;
  color: var(--brand-primary-deep);
  font-size: 20rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-ticket-current {
  flex: none;
  padding: 3rpx 10rpx;
  border-radius: 99rpx;
  background: var(--moss-soft);
  color: var(--moss-deep);
  font-size: 17rpx;
  font-weight: 650;
}

.memory-ticket-place {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.28;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.memory-ticket-details {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  margin-top: auto;
  padding-top: 22rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.memory-ticket-location {
  overflow: hidden;
  min-width: 0;
  flex: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-ticket-full-date {
  flex: none;
  color: var(--ink-body);
  font-weight: 600;
  white-space: nowrap;
}

.memory-ticket-stamp {
  position: absolute;
  right: 22rpx;
  top: 27rpx;
  padding: 3rpx 10rpx;
  border: 2rpx solid rgba(91, 108, 255, .36);
  border-radius: 99rpx;
  color: var(--brand-primary-deep);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transform: rotate(-3deg);
}

.memory-ticket-stub {
  position: relative;
  display: flex;
  flex: 0 0 84rpx;
  width: 84rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-left: 2rpx dashed rgba(89, 94, 120, .28);
  background: #f1f2f7;
  color: var(--ink);
}

.memory-ticket-notch {
  position: absolute;
  left: -14rpx;
  z-index: 2;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: var(--paper);
}

.memory-ticket-notch.is-top { top: -14rpx; }
.memory-ticket-notch.is-bottom { bottom: -14rpx; }

.memory-ticket-stub-label {
  font-size: 16rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
  opacity: .55;
  writing-mode: vertical-rl;
}

.memory-ticket-number {
  margin: 8rpx 0 4rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.memory-ticket-barcode {
  display: flex;
  width: 48rpx;
  height: 68rpx;
  align-items: stretch;
  justify-content: center;
  gap: 2rpx;
  margin-top: 4rpx;
}

.memory-ticket-barcode .bar {
  width: 2rpx;
  background: #252527;
}

.memory-ticket-barcode .bar.is-wide { width: 4rpx; }
.memory-ticket-barcode .bar.is-thin { width: 1rpx; }

.memory-ticket-code {
  position: absolute;
  right: 5rpx;
  bottom: 14rpx;
  left: 5rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 9rpx;
  letter-spacing: -.5rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-ticket-toggle {
  width: 100% !important;
  margin-top: 12rpx;
  min-height: 70rpx;
}

.place-ring-compare {
  margin-top: 18rpx;
}

.place-ring-comparison {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.place-ring-compare-side {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--surface-high);
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.5;
}

.place-ring-compare-image {
  width: 100%;
  height: 150rpx;
  border-radius: 10rpx;
}

.place-ring-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin: 26rpx 0 48rpx;
}

.place-ring-actions .amber-button,
.place-ring-actions .secondary-button {
  margin: 0;
  font-size: 24rpx;
}

.detail-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  justify-content: space-around;
  padding: 18rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 34rpx rgba(68,76,145,.08);
}

.detail-action {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 6rpx;
  min-width: 130rpx;
  color: var(--ink);
}

.detail-action-label {
  font-size: 22rpx;
}

.detail-action-danger {
  color: var(--danger);
}

/* 加载骨架屏 */
.detail-skeleton-media { width: 100%; height: 420rpx; border-radius: var(--radius-card); }

/* 按压反馈过渡 */
.detail-visit-chip { transition: transform 160ms ease, background-color 160ms ease; }
