.share-page { padding-bottom: 80rpx; }
.share-loading { padding: 120rpx 0; text-align: center; }
.share-preview-wrap { margin: 30rpx 0; }
.privacy-card { padding: 28rpx 30rpx; }
.privacy-title-row { display: flex; align-items: center; gap: 16rpx; padding-bottom: 20rpx; }
.privacy-title-row > view { display: flex; flex-direction: column; }
.privacy-title { color: var(--ink); font-size: 29rpx; font-weight: 700; }
.privacy-sub { margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.privacy-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; border-top: 1rpx solid var(--line); color: var(--ink-body); font-size: 26rpx; }
.share-canvas { position: fixed; z-index: -1; left: -2000px; width: 750px; height: 1040px; opacity: 0; }
.share-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 26rpx; }
.share-actions .primary-button { grid-column: 1 / 3; }
.map-share-preview { display: flex; flex-direction: column; gap: 14rpx; margin: 30rpx 0; padding: 38rpx; background: linear-gradient(145deg, #FFFFFF, #F0F1FF); }
.map-share-hero { display: flex; align-items: center; }
.map-share-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.map-share-count { color: var(--brand-primary-deep); font-size: 56rpx; font-weight: 700; }
.map-share-cities { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.share-hint { grid-column: 1 / 3; color: var(--muted); font-size: 20rpx; line-height: 1.5; }
.generated-image { display: block; width: 100%; margin: 28rpx 0; }
