.calendar-page {
  padding-top: 40rpx;
}

.calendar-card,
.selected-day-section {
  border: 1rpx solid rgba(211, 195, 188, 0.16);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.calendar-card {
  padding: 44rpx 30rpx 30rpx;
}

.month-header {
  display: flex;
  min-height: 102rpx;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.month-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.month-kicker {
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.month-title {
  overflow: hidden;
  min-width: 0;
  margin-top: 7rpx;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-button {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--ink);
}

.month-button-hover {
  opacity: 0.62;
}

.weekday-row {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  margin: 0 6rpx;
  border-top: 0;
  border-bottom: 1rpx solid var(--line);
}

.weekday-label {
  width: 14.285714%;
  flex: 0 0 14.285714%;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 12rpx;
}

.day-cell {
  display: flex;
  width: 14.285714%;
  height: 106rpx;
  flex: 0 0 14.285714%;
  align-items: center;
  justify-content: center;
}

.day-cell.is-placeholder {
  pointer-events: none;
}

.day-surface {
  position: relative;
  display: flex;
  width: 72rpx;
  height: 88rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  color: var(--ink);
}

.day-number {
  font-size: 27rpx;
  line-height: 1;
}

.day-cell.is-selected .day-surface {
  background: rgba(255, 219, 208, 0.68);
  color: var(--accent);
}

.day-cell.is-selected .day-number {
  font-size: 34rpx;
  font-weight: 650;
}

.day-cell.is-today .day-number {
  color: var(--accent-deep);
  font-weight: 600;
}

.today-badge {
  position: absolute;
  top: 4rpx;
  right: 0;
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1;
}

.selected-day-dot {
  position: absolute;
  bottom: 9rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
}

.day-stamp {
  position: absolute;
  bottom: 5rpx;
  display: flex;
  width: 32rpx;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef2f2;
}

.stamp-coffee {
  color: #805439;
}

.stamp-milk-tea {
  color: #5f7f8e;
}

.stamp-mixed {
  color: var(--accent-deep);
}

.selected-day-section {
  margin-top: 32rpx;
  padding: 36rpx;
}

.selected-day-head {
  display: flex;
  min-height: var(--control-height);
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.selected-date-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 650;
}

.add-record-button {
  min-height: 66rpx;
  flex-shrink: 0;
  padding: 0 24rpx;
  border-radius: 33rpx;
  background: var(--accent-action);
  color: #fff;
  font-size: 24rpx;
}

.selected-day-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 18rpx 0 24rpx;
  border-bottom: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 24rpx;
}

.summary-number {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 650;
}

.summary-divider {
  width: 1rpx;
  height: 38rpx;
  background: var(--line);
}

.day-list {
  margin-top: 8rpx;
}

.day-row {
  display: grid;
  min-height: 126rpx;
  grid-template-columns: 58rpx 68rpx minmax(0, 1fr) auto;
  gap: 14rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
}

.day-row:last-child {
  border-bottom: 0;
}

.day-time,
.day-calorie,
.day-meta {
  color: var(--muted);
  font-size: 21rpx;
}

.day-image {
  width: 62rpx;
  height: 76rpx;
  border-radius: 14rpx;
  background: var(--paper-deep);
}

.day-main {
  min-width: 0;
}

.day-main text {
  display: block;
}

.day-title,
.day-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-title {
  font-size: 26rpx;
  font-weight: 600;
}

.day-meta {
  margin-top: 7rpx;
}

.day-calorie {
  color: var(--accent-deep);
  white-space: nowrap;
}

.calendar-empty {
  box-shadow: none;
}
