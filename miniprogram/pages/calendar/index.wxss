.calendar-page {
  padding-top: 40rpx;
}

.month-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.month-title {
  overflow: hidden;
  min-width: 0;
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-button {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(239, 227, 209, 0.72);
  color: var(--ink);
}

.month-button-hover {
  opacity: 0.68;
}

.weekday-row {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  border-bottom: 2rpx solid rgba(217, 108, 74, 0.58);
}

.weekday-label {
  width: 14.285714%;
  flex: 0 0 14.285714%;
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 14rpx;
}

.day-cell {
  display: flex;
  width: 14.285714%;
  height: 132rpx;
  flex: 0 0 14.285714%;
  align-items: center;
  justify-content: center;
}

.day-cell.is-placeholder {
  pointer-events: none;
}

.day-surface {
  position: relative;
  display: flex;
  width: 76rpx;
  height: 120rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  color: var(--ink);
}

.day-number {
  font-size: 32rpx;
  line-height: 1;
}

.day-cell.is-selected .day-surface {
  background: rgba(239, 227, 209, 0.8);
  color: var(--accent-deep);
}

.day-cell.is-selected .day-number {
  font-size: 44rpx;
  font-weight: 600;
}

.day-cell.is-today .day-number {
  color: var(--accent-deep);
}

.today-badge {
  position: absolute;
  top: 7rpx;
  right: 3rpx;
  display: flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent-action);
  color: #fffaf1;
  font-family: sans-serif;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}

.selected-day-dot {
  position: absolute;
  bottom: 13rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--accent);
}

.day-stamp {
  position: absolute;
  bottom: 8rpx;
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed currentColor;
  border-radius: 50%;
}

.stamp-coffee {
  color: #6b432b;
}

.stamp-milk-tea {
  color: #527b99;
}

.stamp-mixed {
  border-style: solid;
  color: var(--accent-deep);
}

.selected-day-section {
  margin-top: 22rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid rgba(217, 108, 74, 0.58);
}

.selected-day-head {
  display: flex;
  min-height: var(--control-height);
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.selected-date-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 600;
}

.add-record-button {
  flex-shrink: 0;
}

.selected-day-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 0 26rpx;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: var(--text-body);
}

.summary-number {
  color: var(--accent-deep);
  font-size: 40rpx;
  font-weight: 600;
}

.summary-divider {
  width: 1rpx;
  height: 42rpx;
  background: var(--line);
}

.day-list {
  margin-top: 12rpx;
}

.day-row {
  display: grid;
  min-height: 132rpx;
  grid-template-columns: 66rpx 72rpx minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
}

.day-time {
  color: var(--muted);
  font-size: var(--text-caption);
}

.day-image {
  width: 64rpx;
  height: 82rpx;
  border-radius: 12rpx;
  background: var(--paper-deep);
}

.day-main {
  min-width: 0;
}

.day-main text {
  display: block;
}

.day-title,
.day-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-title {
  font-size: var(--text-body);
  font-weight: 600;
}

.day-meta {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.day-calorie {
  color: var(--muted);
  font-size: var(--text-caption);
  white-space: nowrap;
}

.calendar-empty {
  padding-top: 48rpx;
  padding-bottom: 48rpx;
}
