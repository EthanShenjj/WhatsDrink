.mine-page { padding-bottom: calc(210rpx + env(safe-area-inset-bottom)); }
.mine-overview { overflow: hidden; margin-top: 28rpx; padding: 0; }
.profile-hero { display: flex; min-height: 158rpx; align-items: center; gap: 24rpx; padding: 24rpx 28rpx; transition: background-color 160ms ease; }
.overview-divider { height: 1rpx; margin: 0 28rpx; background: var(--line); }
.profile-avatar { display: flex; width: 112rpx; height: 112rpx; flex: 0 0 112rpx; align-items: center; justify-content: center; border: 5rpx solid #fff; border-radius: 50%; background: var(--surface-high); box-shadow: 0 0 0 1rpx rgba(91,108,255,.12), 0 8rpx 22rpx rgba(39,45,92,.12); color: var(--brand-primary-deep); font-size: 44rpx; font-weight: 700; }
.profile-avatar-empty { background: linear-gradient(145deg, #EEF1FF, #F5EAFF); }
.profile-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.profile-name { color: var(--ink); font-size: 34rpx; font-weight: 700; }
.profile-hint { margin-top: 5rpx; color: var(--muted); font-size: 22rpx; }
.profile-arrow { color: var(--outline); font-size: 42rpx; line-height: 1; }

.membership-wallet { position: relative; display: block; min-height: 356rpx; overflow: hidden; margin-top: 24rpx; padding: 28rpx; border: 1rpx solid rgba(255,255,255,.5); border-radius: 34rpx; background: linear-gradient(135deg, #f9f8f2, #dce5dd); box-shadow: 0 24rpx 58rpx rgba(45,53,48,.15); color: #26352c; }
.membership-wallet::after { position: absolute; right: -100rpx; bottom: -160rpx; width: 390rpx; height: 390rpx; border: 1rpx solid rgba(51,75,61,.13); border-radius: 50%; content: ''; }
.membership-wallet.is-trial, .membership-wallet.is-plus { background: linear-gradient(135deg, #24273f, #4b4c85 58%, #8074aa); box-shadow: 0 24rpx 58rpx rgba(46,45,91,.23); color: #fff; }
.membership-wallet.is-pro { background: linear-gradient(135deg, #2c241b, #665039 56%, #a87a44); box-shadow: 0 24rpx 58rpx rgba(79,57,30,.24); color: #fff8e9; }
.wallet-route { position: absolute; right: 10rpx; top: 68rpx; width: 260rpx; height: 126rpx; opacity: .38; }
.wallet-route::before { position: absolute; top: 52rpx; right: 24rpx; width: 200rpx; height: 60rpx; border-top: 2rpx solid currentColor; border-radius: 50%; content: ''; transform: rotate(-11deg); }
.wallet-route view { position: absolute; width: 12rpx; height: 12rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.wallet-route view:nth-child(1) { top: 40rpx; right: 8rpx; }
.wallet-route view:nth-child(2) { top: 78rpx; right: 108rpx; }
.wallet-route view:nth-child(3) { top: 34rpx; right: 218rpx; }
.wallet-topline, .wallet-footer { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.wallet-brand { display: flex; align-items: center; gap: 12rpx; font-size: 20rpx; font-weight: 680; letter-spacing: 1rpx; }
.wallet-brand view { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border: 1rpx solid currentColor; border-radius: 50%; font-size: 20rpx; }
.membership-pill { flex: none; padding: 6rpx 12rpx; border-radius: 99rpx; background: rgba(38,67,51,.08); font-size: 17rpx; font-weight: 700; }
.is-plus .membership-pill, .is-trial .membership-pill, .is-pro .membership-pill { background: rgba(255,255,255,.16); }
.wallet-heading { position: relative; z-index: 1; display: flex; margin-top: 26rpx; flex-direction: column; }
.membership-title { font-family: Georgia, 'Times New Roman', serif; font-size: 50rpx; font-weight: 650; line-height: 1.08; }
.membership-note { display: block; margin-top: 9rpx; opacity: .72; font-size: 20rpx; line-height: 1.45; }
.wallet-benefits { position: relative; z-index: 1; display: grid; gap: 10rpx; margin-top: 28rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.wallet-benefits > view { display: flex; min-width: 0; align-items: center; gap: 8rpx; padding: 12rpx 9rpx; border-radius: 17rpx; background: rgba(255,255,255,.38); font-size: 17rpx; font-weight: 650; }
.is-plus .wallet-benefits > view, .is-trial .wallet-benefits > view, .is-pro .wallet-benefits > view { background: rgba(255,255,255,.12); }
.wallet-benefit-icon { display: flex; width: 42rpx; height: 42rpx; flex: 0 0 42rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.54); }
.wallet-benefits text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wallet-footer { margin-top: 23rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(39,63,49,.12); font-size: 18rpx; }
.is-plus .wallet-footer, .is-trial .wallet-footer, .is-pro .wallet-footer { border-top-color: rgba(255,255,255,.17); }
.wallet-footer > text:first-child { min-width: 0; overflow: hidden; opacity: .7; text-overflow: ellipsis; white-space: nowrap; }
.membership-action { flex: none; font-size: 19rpx; font-weight: 680; }

.growth-card { display: flex; min-height: 148rpx; align-items: center; gap: 18rpx; margin-top: 28rpx; padding: 18rpx 24rpx 18rpx 18rpx; border: 1rpx solid rgba(91,108,255,.08); border-radius: 32rpx; box-shadow: var(--shadow-card); overflow: hidden; }
.growth-journey { background: linear-gradient(135deg, #EEF1FF, #F5EAFF); }
.growth-explore { background: linear-gradient(135deg, #FFF0E2, #FFE6EF); }
.growth-discover { background: linear-gradient(135deg, #E6FBFF, #E9EFFF); }
.growth-highlight { background: linear-gradient(135deg, #FFF7D3, #FFEAD4); }
.growth-companion { background: linear-gradient(135deg, #FFF0F7, #FFE5EF); }
.growth-dawn { background: linear-gradient(135deg, #FFF1DF, #F5E5FF); }
.growth-card-copy { min-width: 0; flex: 1; }
.growth-label-row { display: flex; align-items: center; gap: 10rpx; }
.growth-label { color: #554FA3; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }
.growth-plus { padding: 3rpx 10rpx; border-radius: 99rpx; background: #4B47A4; color: #fff; font-size: 20rpx; font-weight: 700; }
.growth-title { display: block; margin-top: 6rpx; color: #22243C; font-size: 28rpx; font-weight: 700; }
.growth-goal-text { display: block; overflow: hidden; margin-top: 5rpx; color: #5C62A0; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.growth-card-arrow { flex: none; color: var(--brand-primary-deep); font-size: 42rpx; line-height: 1; }

.stats-card { padding: 26rpx 28rpx 30rpx; }
.stats-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.stats-heading > view { display: flex; flex-direction: column; }
.stats-subtitle { margin-top: 2rpx; color: var(--muted); font-size: 20rpx; }
.stats-hint { flex: none; margin-top: 8rpx; color: var(--brand-primary-deep); font-size: 22rpx; font-weight: 600; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 30rpx; }
.stat-item { display: flex; align-items: center; border-right: 1rpx solid var(--line); flex-direction: column; }
.stat-item:last-child { border-right: 0; }
.stat-number { color: var(--ink); font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.stat-label { margin-top: 6rpx; color: var(--muted); font-size: 20rpx; }
.menu-arrow { color: var(--outline); font-size: 42rpx; line-height: 1; }

.menu-card { margin-top: 28rpx; padding: 4rpx 28rpx; }
.menu-row { display: flex; min-height: 96rpx; align-items: center; gap: 18rpx; border-bottom: 1rpx solid var(--line); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: var(--surface-high); }
.menu-label { flex: 1; color: var(--ink); font-size: 28rpx; }
.menu-hint { padding: 4rpx 10rpx; border-radius: 99rpx; background: var(--surface-high); color: var(--muted); font-size: 20rpx; }
.version-label { display: block; margin-top: 36rpx; color: var(--muted); font-size: 20rpx; text-align: center; }

/* 按压反馈过渡 */
.membership-card,
.growth-card { transition: opacity 160ms ease; }
.menu-row { transition: background-color 160ms ease; }
