.mine-page { padding-bottom: calc(210rpx + env(safe-area-inset-bottom)); }
.mine-page > brand-card { display: block; margin-top: 28rpx; }
.profile-hero { display: flex; min-height: 176rpx; align-items: center; gap: 24rpx; padding: 28rpx; }
.profile-avatar { display: flex; width: 112rpx; height: 112rpx; flex: 0 0 112rpx; align-items: center; justify-content: center; border: 5rpx solid rgba(255,255,255,.7); border-radius: 50%; background: rgba(255,255,255,.2); color: #fff; font-size: 44rpx; font-weight: 700; }
.profile-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.profile-name { color: #fff; font-size: 34rpx; font-weight: 700; }
.profile-hint { margin-top: 5rpx; color: rgba(255,255,255,.76); font-size: 22rpx; }
.profile-arrow { color: rgba(255,255,255,.72); font-size: 42rpx; line-height: 1; }

.growth-card { display: flex; min-height: 258rpx; align-items: center; margin-top: 28rpx; padding: 28rpx 14rpx 26rpx 30rpx; border: 1rpx solid rgba(91,108,255,.08); border-radius: 32rpx; box-shadow: var(--shadow-card); overflow: hidden; }
.growth-journey { background: linear-gradient(135deg, #EEF1FF, #F5EAFF); }
.growth-explore { background: linear-gradient(135deg, #FFF0E2, #FFE6EF); }
.growth-discover { background: linear-gradient(135deg, #E6FBFF, #E9EFFF); }
.growth-highlight { background: linear-gradient(135deg, #FFF7D3, #FFEAD4); }
.growth-companion { background: linear-gradient(135deg, #FFF0F7, #FFE5EF); }
.growth-dawn { background: linear-gradient(135deg, #FFF1DF, #F5E5FF); }
.growth-card-copy { min-width: 0; flex: 1; }
.growth-label-row { display: flex; align-items: center; gap: 10rpx; }
.growth-label { color: #554FA3; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }
.growth-plus { padding: 3rpx 10rpx; border-radius: 99rpx; background: #4B47A4; color: #fff; font-size: 16rpx; font-weight: 700; }
.growth-title { display: block; margin-top: 10rpx; color: #22243C; font-size: 31rpx; font-weight: 700; }
.growth-message { display: block; margin-top: 7rpx; color: #6F7489; font-size: 21rpx; line-height: 1.5; }
.growth-goal { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 17rpx; color: #5C62A0; font-size: 18rpx; font-weight: 600; }
.growth-goal > text:first-child { overflow: hidden; min-width: 0; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.growth-goal-arrow { flex: none; color: #3E47C8; }

.stats-card { margin-top: 28rpx; padding: 30rpx; }
.stats-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.stats-heading > view { display: flex; flex-direction: column; }
.stats-subtitle { margin-top: 2rpx; color: var(--muted); font-size: 20rpx; }
.stats-hint { flex: none; margin-top: 8rpx; color: var(--brand-primary-deep); font-size: 21rpx; font-weight: 600; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 30rpx; }
.stat-item { display: flex; align-items: center; border-right: 1rpx solid var(--line); flex-direction: column; }
.stat-item:last-child { border-right: 0; }
.stat-number { color: var(--ink); font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.stat-label { margin-top: 6rpx; color: var(--muted); font-size: 20rpx; }
.stats-secondary { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.stats-secondary text { padding: 7rpx 14rpx; border-radius: 99rpx; background: var(--surface-high); color: var(--muted); font-size: 18rpx; }

.annual-card { display: flex; min-height: 126rpx; align-items: center; gap: 18rpx; padding: 24rpx 28rpx; }
.annual-icon { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: #E7E9FF; }
.annual-copy-wrap { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.annual-title { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.annual-copy { margin-top: 3rpx; color: var(--muted); font-size: 21rpx; }
.annual-arrow, .menu-arrow { color: var(--outline); font-size: 42rpx; line-height: 1; }

.menu-card { margin-top: 28rpx; padding: 4rpx 28rpx; }
.menu-row { display: flex; min-height: 96rpx; align-items: center; gap: 18rpx; border-bottom: 1rpx solid var(--line); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: var(--surface-high); }
.menu-label { flex: 1; color: var(--ink); font-size: 27rpx; }
.menu-hint { padding: 4rpx 10rpx; border-radius: 99rpx; background: var(--surface-high); color: var(--muted); font-size: 18rpx; }
.data-actions { margin-top: 28rpx; padding: 4rpx 28rpx; }
.data-action-row { display: flex; min-height: 108rpx; align-items: center; gap: 18rpx; }
.data-action-row.is-disabled { opacity: .48; }
.data-action-icon { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 64rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: var(--surface-high); }
.data-action-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3rpx; }
.data-action-title { color: var(--ink-body); font-size: 27rpx; font-weight: 500; line-height: 38rpx; }
.data-action-hint { color: var(--muted); font-size: 20rpx; line-height: 30rpx; }
.version-label { display: block; margin-top: 36rpx; color: var(--muted); font-size: 20rpx; text-align: center; }
