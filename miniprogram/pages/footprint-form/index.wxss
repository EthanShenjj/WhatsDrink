.form-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.form-loading {
  padding: 120rpx 0;
  text-align: center;
}

.form-wishlist-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--amber-soft);
}

.form-wishlist-tag {
  padding: 4rpx 16rpx;
  border-radius: 99rpx;
  background: var(--amber);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.form-wishlist-hint {
  flex: 1;
  color: var(--amber-deep);
  font-size: 24rpx;
  line-height: 1.5;
}

.form-section {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.form-field {
  margin-top: 28rpx;
}

.form-field:first-child {
  margin-top: 0;
}

.form-field-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.form-field-required {
  color: var(--danger);
  font-size: 22rpx;
}

.form-field-hint {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 400;
}

.form-poi-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form-poi-input {
  flex: 1;
  height: var(--control-height);
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  color: var(--ink-body);
  font-size: 28rpx;
}

.form-poi-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 1rpx solid var(--moss);
  border-radius: var(--radius-sm);
  background: var(--moss-soft);
  color: var(--moss-deep);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.form-poi-button::after {
  border: 0;
}

.form-address-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  min-height: 64rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.28);
  border-radius: var(--radius-sm);
  background: var(--brand-surface-tint);
  color: var(--brand-primary-deep);
}

.form-address-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 1.4;
}

.form-address-clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(23, 24, 43, 0.08);
  color: var(--muted);
  font-size: 24rpx;
}

.form-date-shortcuts {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.form-date-chip {
  padding: 8rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 99rpx;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 500;
}

.form-date-chip.is-active {
  border-color: var(--brand-primary);
  background: var(--brand-surface-tint);
  color: var(--brand-primary-deep);
  font-weight: 600;
}

.form-upload-retry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  background: rgba(199, 78, 99, 0.08);
  color: var(--danger);
  font-size: 24rpx;
}

.form-upload-retry-button {
  min-height: 56rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  border-radius: 99rpx;
  background: var(--danger);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.form-upload-retry-button::after {
  border: 0;
}

.form-draft-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--brand-surface-tint);
}

.form-draft-text {
  flex: 1;
  color: var(--brand-primary-deep);
  font-size: 24rpx;
  line-height: 1.5;
}

.form-draft-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-draft-restore,
.form-draft-discard {
  min-height: 56rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 99rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.form-draft-restore {
  background: var(--brand-primary);
  color: #ffffff;
}

.form-draft-discard {
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--muted);
}

.form-draft-restore::after,
.form-draft-discard::after {
  border: 0;
}

.form-optional-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form-optional-summary {
  color: var(--muted);
  font-size: 24rpx;
}

.form-field-divided {
  border-top: 1rpx solid var(--line);
  padding-top: 32rpx;
  margin-top: 32rpx;
}

.form-date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  color: var(--ink-body);
  font-size: 28rpx;
}

.form-optional {
  padding: 0;
}

.form-optional-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}

.form-optional-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.form-optional-arrow {
  color: var(--muted);
  font-size: 40rpx;
  font-weight: 300;
  transform: rotate(90deg);
  transition: transform 200ms ease;
}

.form-optional-arrow.is-open {
  transform: rotate(-90deg);
}

.form-optional > view:not(.form-optional-toggle) {
  padding: 0 32rpx 32rpx;
}

/* 横向滚动区通栏到卡片边缘，右侧渐隐提示还有更多内容 */
.form-scroll-wrap {
  position: relative;
  margin: 0 -32rpx;
}

.form-scroll-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 64rpx;
  background: linear-gradient(to left, var(--surface), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.form-chips-scroll {
  width: 100%;
  white-space: nowrap;
}

.form-chips-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 32rpx 8rpx;
}

.form-category-chip {
  flex-shrink: 0;
  gap: 6rpx;
  padding: 10rpx 22rpx;
}

.form-category-emoji {
  font-size: 26rpx;
}

.form-tags-input-row {
  display: flex;
  gap: 16rpx;
}

.form-tag-input {
  flex: 1;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  font-size: 28rpx;
}

.form-tag-add-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 32rpx;
  border: 1rpx solid var(--moss);
  border-radius: var(--radius-sm);
  background: var(--moss-soft);
  color: var(--moss-deep);
  font-size: 26rpx;
  font-weight: 600;
}

.form-tag-add-button::after {
  border: 0;
}

.form-tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.form-tag-chip {
  gap: 8rpx;
  padding: 6rpx 12rpx 6rpx 18rpx;
}

.form-tag-remove {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1;
}

.form-note {
  box-sizing: border-box;
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  color: var(--ink-body);
  font-size: 28rpx;
  line-height: 1.6;
}

.form-marker-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.form-marker-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.form-marker-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.form-marker-preview-text {
  font-size: 22rpx;
}

.form-marker-colors {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.form-marker-color-swatch {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.form-marker-color-swatch.is-active {
  outline: 4rpx solid var(--ink);
  outline-offset: 2rpx;
}

.form-marker-color-check {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.form-marker-emojis-scroll {
  width: 100%;
  white-space: nowrap;
}

.form-marker-emojis-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 32rpx 8rpx;
}

.form-marker-emoji-swatch {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  font-size: 36rpx;
}

.form-marker-emoji-swatch.is-active {
  border-color: var(--brand-primary);
  background: var(--brand-surface-tint);
  box-shadow: 0 0 0 3rpx rgba(91, 108, 255, 0.18);
}

.form-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 56rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(247, 248, 255, 0), var(--paper) 55%);
  pointer-events: auto;
}

.form-delete-button {
  margin-top: 16rpx;
  min-height: var(--control-height);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--danger);
  font-size: 26rpx;
  font-weight: 600;
}

.form-delete-button::after {
  border: 0;
}

.form-success-layer { position: fixed; z-index: 200; inset: 0; display: flex; align-items: center; justify-content: center; padding: 42rpx; }
.form-success-mask { position: absolute; inset: 0; background: rgba(23,24,43,.46); backdrop-filter: blur(8rpx); }
.form-success-panel { position: relative; width: 100%; animation: form-success-in 260ms cubic-bezier(.2,.85,.3,1.15) both; }
@keyframes form-success-in { from { opacity: 0; transform: translateY(28rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
