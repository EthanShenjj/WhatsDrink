<view class="page-shell profile-page">
  <view class="profile-head">
    <view
      class="avatar-frame"
      catchtap="editProfile"
      role="button"
      aria-label="头像，点击编辑个人资料"
      hover-class="avatar-frame-hover"
    >
      <view class="avatar">
        <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <wd-icon wx:else name="user" size="72rpx" />
      </view>
      <view class="avatar-camera-badge">
        <wd-icon name="camera" size="22rpx" />
      </view>
    </view>
    <view class="profile-copy">
      <text class="profile-name">{{profile.nickname || '饮品记录者'}}</text>
      <text class="profile-subtitle">认真记录生活里的每一杯</text>
    </view>
    <view
      class="edit-profile"
      bindtap="editProfile"
      role="button"
      aria-label="编辑个人资料"
      hover-class="row-hover"
    >
      编辑资料
    </view>
  </view>

  <view class="week-section">
    <text class="section-title hand-underline">本周饮品</text>
    <view class="week-strip" role="list" aria-label="本周饮品记录">
      <view
        wx:for="{{weekDays}}"
        wx:key="key"
        class="week-day {{item.isToday ? 'is-today' : ''}}"
        role="listitem"
        aria-label="周{{item.weekday}}，{{item.day}}日，{{item.count}}杯{{item.isToday ? '，今天' : ''}}"
      >
        <text class="week-label">{{item.weekday}}</text>
        <text class="week-number">{{item.day}}</text>
        <view class="week-stamp {{item.count ? 'has-drink' : ''}}">
          <wd-icon wx:if="{{item.count}}" name="drink" size="24rpx" />
        </view>
      </view>
    </view>
    <view class="week-summary">
      <wd-icon name="drink" size="44rpx" />
      <text>本周 <text class="accent-number">{{weekCount}}</text> 杯 · 已知热量 <text class="accent-number">{{weekCalories}}</text> 千卡</text>
    </view>
    <text wx:if="{{weekUnknownCalories}}" class="unknown-note">
      另有 {{weekUnknownCalories}} 杯未填写热量
    </text>
  </view>

  <view class="settings-list">
    <text class="settings-group-label">提醒、记录与隐私</text>
    <view
      class="settings-row {{reminderBusy ? 'is-busy' : ''}}"
      bindtap="subscribeReminder"
      role="button"
      aria-label="订阅今晚八点的饮品记录提醒"
      hover-class="row-hover"
    >
      <wd-icon name="calendar" size="42rpx" />
      <text>订阅今晚提醒</text>
      <text class="settings-hint">
        {{reminderStatus && reminderStatus.remainingCount ? '可提醒 ' + reminderStatus.remainingCount + ' 次' : (reminderStatus && !reminderStatus.configured ? '待配置' : '20:00')}}
      </text>
    </view>
    <view
      class="settings-row"
      bindtap="openCalendar"
      role="button"
      aria-label="打开记录日历"
      hover-class="row-hover"
    >
      <wd-icon name="calendar" size="42rpx" />
      <text>记录日历</text>
      <wd-icon name="chevron-right" size="36rpx" />
    </view>
    <view
      class="settings-row"
      bindtap="openPrivacy"
      role="button"
      aria-label="打开数据与隐私"
      hover-class="row-hover"
    >
      <wd-icon name="secured" size="42rpx" />
      <text>数据与隐私</text>
      <wd-icon name="chevron-right" size="36rpx" />
    </view>
  </view>

  <view class="danger-zone">
    <text class="settings-group-label danger-label">数据管理</text>
    <view
      class="settings-row settings-row-danger"
      bindtap="clearRecords"
      role="button"
      aria-label="清除全部记录，不可恢复"
      hover-class="row-hover"
    >
      <wd-icon name="delete" size="42rpx" />
      <text>清除记录</text>
      <text class="settings-hint">不可恢复</text>
    </view>
    <view
      class="settings-row settings-row-danger"
      bindtap="removeAccount"
      role="button"
      aria-label="注销账号，永久删除"
      hover-class="row-hover"
    >
      <wd-icon name="logout" size="42rpx" />
      <text>注销账号</text>
      <text class="settings-hint">永久删除</text>
    </view>
  </view>
</view>

<privacy-popup />
