.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 10rpx -32rpx 0;
  padding: 42rpx 44rpx 62rpx;
  background: linear-gradient(145deg, #eeebe5 0%, #f6f3ee 68%, #eee6de 100%);
}

.avatar {
  display: flex;
  width: 126rpx;
  height: 126rpx;
  flex: 0 0 126rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 8rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(28, 27, 24, 0.08);
  color: var(--ink);
}

.avatar image {
  width: 100%;
  height: 100%;
}

.profile-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.profile-name {
  overflow: hidden;
  max-width: 100%;
  font-size: 42rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-subtitle {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.edit-profile {
  display: flex;
  min-width: 112rpx;
  min-height: 60rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  padding: 0 20rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.12);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.week-section,
.settings-list,
.danger-zone {
  border: 1rpx solid rgba(28, 27, 24, 0.045);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.week-section {
  position: relative;
  margin-top: -28rpx;
  padding: 30rpx 24rpx 26rpx;
}

.week-strip {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-top: 24rpx;
}

.week-day {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 30rpx;
}

.week-day.is-today {
  background: #ede5df;
  color: var(--accent-deep);
}

.week-label {
  color: var(--muted);
  font-size: 20rpx;
}

.week-number {
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 500;
}

.week-stamp {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  margin-top: 11rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.12);
  border-radius: 50%;
  color: #fff;
}

.week-stamp.has-drink {
  border-color: var(--accent);
  background: var(--accent);
}

.week-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 24rpx;
}

.accent-number {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 650;
}

.unknown-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
  text-align: center;
}

.settings-list,
.danger-zone {
  overflow: hidden;
  margin-top: 24rpx;
  padding: 10rpx 28rpx 0;
}

.danger-zone {
  margin-top: 20rpx;
}

.settings-group-label {
  display: block;
  padding: 18rpx 0 8rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.settings-row {
  display: grid;
  width: 100%;
  min-height: 102rpx;
  grid-template-columns: 44rpx minmax(0, 1fr) 34rpx;
  gap: 18rpx;
  align-items: center;
  justify-items: start;
  margin: 0;
  padding: 0 2rpx;
  border-bottom: 1rpx solid var(--line);
  background: transparent;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 500;
  text-align: left;
}

.settings-row > text:nth-child(2) {
  justify-self: start;
}

.settings-row > wd-icon:last-child,
.settings-hint {
  justify-self: end;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row-danger {
  grid-template-columns: 46rpx minmax(0, 1fr) auto;
}

.settings-hint {
  color: var(--muted);
  font-size: 20rpx;
  text-align: right;
}

.row-hover {
  opacity: 0.62;
}

.login-sheet-layer {
  position: fixed;
  z-index: 900;
  inset: 0;
}

.login-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 27, 24, 0.42);
}

.login-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 40rpx 0;
  border-radius: 38rpx 38rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -20rpx 60rpx rgba(28, 27, 24, 0.14);
}

.login-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 30rpx;
  border-radius: 999rpx;
  background: #d9d5cf;
}

.login-sheet-title {
  display: block;
  font-size: 38rpx;
  font-weight: 650;
  text-align: center;
}

.login-sheet-description {
  display: block;
  max-width: 580rpx;
  margin: 14rpx auto 0;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.login-avatar-button {
  display: flex;
  width: 148rpx;
  height: 148rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 34rpx auto;
  padding: 0;
  border: 6rpx solid #f4f1ed;
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--accent-deep);
}

.login-avatar-button image {
  width: 100%;
  height: 100%;
}

.login-avatar-placeholder {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
}

.login-avatar-placeholder text {
  font-size: 18rpx;
}

.login-nickname-field {
  padding: 0 4rpx;
}

.login-field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.login-nickname-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--surface-soft);
  font-size: 28rpx;
}

.login-sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 20rpx;
  margin-top: 32rpx;
}

.login-cancel-button,
.login-confirm-button {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.login-cancel-button {
  border: 1rpx solid var(--line);
  background: var(--surface-soft);
  color: var(--ink);
}

.login-confirm-button {
  background: var(--accent-action);
  color: #ffffff;
}

.login-cancel-button[disabled],
.login-confirm-button[disabled] {
  opacity: 0.6;
}

.login-sheet-safe-bottom {
  height: calc(28rpx + env(safe-area-inset-bottom));
}

@media (max-width: 360px) {
  .profile-head {
    gap: 18rpx;
    padding-right: 32rpx;
    padding-left: 32rpx;
  }

  .avatar {
    width: 112rpx;
    height: 112rpx;
    flex-basis: 112rpx;
  }

  .profile-name {
    font-size: 36rpx;
  }

  .profile-subtitle {
    display: none;
  }

  .edit-profile {
    min-width: 100rpx;
    padding: 0 14rpx;
  }

  .login-sheet {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .login-avatar-button {
    margin-top: 24rpx;
    margin-bottom: 24rpx;
  }
}
