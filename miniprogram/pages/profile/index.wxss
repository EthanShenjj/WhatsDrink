.profile-head {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 24rpx;
  padding: 8rpx 0 56rpx;
  background: transparent;
}

.avatar-frame {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  flex: 0 0 152rpx;
  border-radius: 50%;
}

.avatar-frame-hover {
  transform: scale(0.97);
  opacity: 0.88;
}

.avatar {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 5rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  background: var(--surface-high);
  box-shadow:
    0 12rpx 30rpx rgba(74, 52, 39, 0.13),
    0 0 0 1rpx rgba(125, 77, 54, 0.08);
  color: var(--accent-deep);
}

.avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-camera-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #f3efe9;
  border-radius: 50%;
  background: var(--accent-deep);
  box-shadow: 0 6rpx 14rpx rgba(74, 52, 39, 0.18);
  color: #ffffff;
}

.profile-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.profile-name {
  overflow: hidden;
  max-width: 100%;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-subtitle {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.edit-profile {
  display: flex;
  min-width: 112rpx;
  min-height: 60rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  padding: 0 20rpx;
  border: 0;
  border-radius: 30rpx;
  background: var(--surface-high);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.week-section,
.settings-list,
.danger-zone {
  border: 1rpx solid rgba(211, 195, 188, 0.16);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.week-section {
  position: relative;
  margin-top: 0;
  padding: 36rpx 30rpx 30rpx;
}

.week-strip {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-top: 24rpx;
}

.week-day {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 30rpx;
}

.week-day.is-today {
  background: rgba(255, 219, 208, 0.55);
  color: var(--accent);
}

.week-label {
  color: var(--muted);
  font-size: 20rpx;
}

.week-number {
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 500;
}

.week-stamp {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  margin-top: 11rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.12);
  border-radius: 50%;
  color: #fff;
}

.week-stamp.has-drink {
  border-color: var(--accent-soft);
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.week-summary {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--surface-high);
  color: var(--muted);
  font-size: 24rpx;
}

.accent-number {
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 650;
}

.unknown-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
  text-align: center;
}

.settings-list,
.danger-zone {
  overflow: hidden;
  margin-top: 24rpx;
  padding: 12rpx 30rpx 0;
}

.danger-zone {
  margin-top: 20rpx;
}

.settings-group-label {
  display: block;
  padding: 18rpx 0 8rpx;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.settings-row {
  display: grid;
  width: 100%;
  min-height: 102rpx;
  grid-template-columns: 44rpx minmax(0, 1fr) 34rpx;
  gap: 18rpx;
  align-items: center;
  justify-items: start;
  margin: 0;
  padding: 0 2rpx;
  border-bottom: 1rpx solid var(--line);
  background: transparent;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 500;
  text-align: left;
}

.settings-row > text:nth-child(2) {
  justify-self: start;
}

.settings-row > wd-icon:last-child,
.settings-hint {
  justify-self: end;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row-danger {
  grid-template-columns: 46rpx minmax(0, 1fr) auto;
}

.settings-hint {
  color: var(--outline);
  font-size: 20rpx;
  text-align: right;
}

.row-hover {
  opacity: 0.62;
}

.settings-row.is-busy {
  opacity: 0.48;
  pointer-events: none;
}

.login-sheet-layer {
  position: fixed;
  z-index: 900;
  inset: 0;
}

.login-sheet-mask {
  position: absolute;
  inset: 0;
  animation: login-mask-in 180ms ease-out both;
  background: rgba(28, 27, 24, 0.5);
}

.login-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 16rpx 36rpx 0;
  border-radius: 44rpx 44rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -24rpx 80rpx rgba(28, 27, 24, 0.18);
  color: var(--ink);
  animation: login-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.login-sheet-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 32rpx;
  border-radius: 999rpx;
  background: #d8d4cd;
}

.login-sheet-header {
  padding: 0 4rpx;
}

.login-sheet-kicker {
  display: block;
  color: var(--accent);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.login-sheet-title {
  display: block;
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.login-sheet-description {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.login-avatar-section {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  align-items: center;
  gap: 28rpx;
  margin: 32rpx 0 0;
  padding: 4rpx;
}

.login-avatar-button {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 120rpx;
  height: 120rpx;
  min-width: 120rpx;
  flex: 0 0 120rpx;
  align-items: center;
  justify-content: center;
  overflow: visible;
  margin: 0;
  padding: 0;
  border: 4rpx solid var(--surface);
  border-radius: 50%;
  background: #eee7de;
  box-shadow: 0 10rpx 26rpx rgba(84, 61, 47, 0.14);
  color: var(--accent-deep);
  line-height: 1;
}

.login-avatar-button::after {
  border: 0;
}

.login-avatar-button image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.login-avatar-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.login-avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -4rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--surface);
  border-radius: 50%;
  background: var(--accent-deep);
  color: #ffffff;
}

.login-avatar-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
  justify-content: center;
  line-height: 1.3;
}

.login-avatar-title {
  overflow: hidden;
  width: 100%;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-avatar-hint {
  margin-top: 6rpx;
  color: #8a857d;
  font-size: 21rpx;
}

.login-avatar-action {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 600;
}

.login-nickname-field {
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.login-field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.login-field-label {
  color: #4e4b46;
  font-size: 23rpx;
  font-weight: 600;
}

.login-field-required {
  color: var(--accent);
  font-size: 20rpx;
}

.login-nickname-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 94rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #fbfaf8;
  font-size: 28rpx;
}

.login-sheet-actions {
  display: flex;
  align-items: stretch;
  flex-direction: column;
  margin-top: 30rpx;
}

.login-confirm-button {
  display: flex;
  box-sizing: border-box;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 20rpx;
  border-radius: 47rpx;
  background: var(--accent-action);
  box-shadow: 0 12rpx 24rpx rgba(28, 27, 24, 0.16);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
}

.login-cancel-button {
  display: flex;
  box-sizing: border-box;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0 0 !important;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.login-cancel-button::after,
.login-confirm-button::after {
  border: 0;
}

.login-cancel-button[disabled],
.login-confirm-button[disabled] {
  opacity: 0.6;
}

.login-sheet-footnote {
  display: block;
  margin-top: 20rpx;
  color: #aaa59d;
  font-size: 19rpx;
  line-height: 1.4;
  text-align: center;
}

.login-sheet-safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

@keyframes login-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes login-sheet-in {
  from {
    transform: translateY(36rpx);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@media (max-width: 360px) {
  .profile-head {
    gap: 18rpx;
    padding-right: 32rpx;
    padding-left: 32rpx;
  }

  .avatar-frame {
    width: 116rpx;
    height: 116rpx;
    flex-basis: 116rpx;
  }

  .avatar-camera-badge {
    width: 38rpx;
    height: 38rpx;
  }

  .profile-name {
    font-size: 36rpx;
  }

  .profile-subtitle {
    display: none;
  }

  .edit-profile {
    min-width: 100rpx;
    padding: 0 14rpx;
  }

  .login-sheet {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .login-sheet-title {
    font-size: 38rpx;
  }

  .login-avatar-section {
    gap: 22rpx;
  }
}
