.profile-head {
  display: flex;
  align-items: center;
  gap: 34rpx;
  padding: 18rpx 0 34rpx;
}

.avatar {
  display: flex;
  width: 148rpx;
  height: 148rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(217, 108, 74, 0.45);
  border-radius: 50%;
  background: rgba(239, 227, 209, 0.75);
  outline: 8rpx solid rgba(248, 241, 229, 0.8);
}

.avatar image {
  width: 100%;
  height: 100%;
}

.profile-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.profile-name {
  font-size: 46rpx;
  font-weight: 600;
}

.edit-profile {
  margin-top: 16rpx;
  border-bottom: 4rpx solid rgba(217, 108, 74, 0.45);
}

.week-section {
  margin-top: 48rpx;
}

.week-strip {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
  margin-top: 34rpx;
}

.week-day {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  border-radius: 28rpx;
}

.week-day.is-today {
  background: rgba(239, 227, 209, 0.78);
  color: var(--accent-deep);
}

.week-label {
  font-size: var(--text-caption);
}

.week-number {
  margin-top: 12rpx;
  font-size: 34rpx;
}

.week-stamp {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
  border: 2rpx dashed rgba(93, 59, 38, 0.2);
  border-radius: 50%;
  color: #fff8ee;
}

.week-stamp.has-drink {
  border-color: var(--blue);
  background: var(--blue);
}

.week-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 36rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  color: #674a37;
  font-size: 27rpx;
}

.accent-number {
  color: var(--accent-deep);
  font-size: 38rpx;
  font-weight: 600;
}

.unknown-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: var(--text-caption);
  text-align: center;
}

.settings-list {
  margin-top: 46rpx;
}

.danger-zone {
  margin-top: 40rpx;
}

.settings-group-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.danger-label {
  color: var(--danger);
}

.settings-row {
  display: grid;
  width: 100%;
  min-height: 104rpx;
  grid-template-columns: 50rpx minmax(0, 1fr) 40rpx;
  gap: 20rpx;
  align-items: center;
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--line);
  background: transparent;
  color: var(--ink);
  font-size: var(--text-body);
  text-align: left;
}

.settings-row-danger {
  color: var(--danger);
  grid-template-columns: 50rpx minmax(0, 1fr) auto;
}

.settings-hint {
  color: var(--muted);
  font-size: var(--text-caption);
  text-align: right;
}
