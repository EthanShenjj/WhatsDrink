<view class="share-page">
  <view wx:if="{{ticket}}" class="ticket-card">
    <text class="ticket-kicker">SHIGUANGJI · MEMORY TICKET</text>
    <text class="ticket-title">{{ticket.name}}</text>
    <text class="ticket-date">{{ticket.date || '一段值得记住的时光'}}</text>
    <view class="ticket-divider"></view>
    <text wx:if="{{ticket.location}}" class="ticket-meta">{{ticket.location}}</text>
    <text wx:if="{{ticket.code}}" class="ticket-code">{{ticket.code}}</text>
    <text class="ticket-footer">拾光迹 · 把生活留在地图上</text>
  </view>
  <view wx:else class="ticket-missing">票根链接已失效</view>
  <button class="explore-button" bindtap="onExplore">打开拾光迹</button>
</view>
