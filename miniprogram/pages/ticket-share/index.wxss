page { background: #f4f5ff; }
.share-page { padding: 64rpx 36rpx; }
.ticket-card { display: flex; flex-direction: column; min-height: 570rpx; padding: 48rpx 42rpx; border-radius: 36rpx; background: #fff; box-shadow: 0 22rpx 60rpx rgba(63, 70, 152, .12); }
.ticket-kicker { color: #6572dd; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.ticket-title { margin-top: 72rpx; color: #20263e; font-size: 48rpx; font-weight: 700; line-height: 1.3; }
.ticket-date { margin-top: 16rpx; color: #6d7694; font-size: 26rpx; }
.ticket-divider { margin: 72rpx 0 32rpx; border-top: 2rpx dashed #dfe2f2; }
.ticket-meta { color: #39425f; font-size: 27rpx; }
.ticket-code { margin-top: 16rpx; color: #8d95ad; font-size: 21rpx; letter-spacing: 1rpx; }
.ticket-footer { margin-top: auto; padding-top: 48rpx; color: #596aff; font-size: 22rpx; }
.ticket-missing { padding: 100rpx 20rpx; color: #69718d; text-align: center; }
.explore-button { margin-top: 44rpx; border-radius: 20rpx; background: #596aff; color: #fff; font-size: 28rpx; }
