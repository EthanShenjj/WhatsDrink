.time-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.time-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 22rpx;
}

.time-capsule-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 92rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.16);
  border-radius: 24rpx;
  background: linear-gradient(100deg, #FFFFFF 0%, #F5F5FF 100%);
  transition: opacity 160ms ease, transform 160ms ease;
}

.time-capsule-entry--pressed {
  opacity: 0.78;
  transform: scale(0.985);
}

.time-capsule-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--brand-surface-tint);
}

.time-capsule-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
}

.time-capsule-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.time-capsule-description {
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.time-capsule-arrow {
  color: var(--brand-primary-deep);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.memory-drop-section {
  margin-bottom: 38rpx;
}

.memory-drop-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.memory-drop-kicker {
  display: block;
  margin-bottom: 2rpx;
  color: var(--brand-primary-deep);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.memory-drop-caption {
  padding-bottom: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.memory-drop-wrap {
  position: relative;
  margin: 0 -32rpx;
}

.memory-drop-wrap.is-single {
  margin: 0;
}

.memory-drop-scroll {
  white-space: nowrap;
}

.memory-drop-row {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 32rpx;
}

.memory-drop-wrap.is-single .memory-drop-row {
  display: flex;
  width: 100%;
  padding: 0;
}

.memory-drop-wrap.is-single .memory-drop-card {
  width: 100%;
}

.memory-drop-wrap.is-single .memory-drop-fade {
  display: none;
}

.memory-drop-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 28rpx;
  background: linear-gradient(to left, var(--paper), rgba(247, 248, 255, 0));
  pointer-events: none;
}

.memory-drop-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 620rpx;
  height: 260rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.12);
  border-radius: 26rpx;
  background: var(--surface);
  box-shadow: 0 12rpx 34rpx rgba(52, 60, 118, 0.08);
  overflow: hidden;
  white-space: normal;
}

.memory-drop-card::before,
.memory-drop-card::after {
  position: absolute;
  left: 196rpx;
  z-index: 2;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--paper);
  content: '';
}

.memory-drop-card::before { top: -11rpx; }
.memory-drop-card::after { bottom: -11rpx; }

.memory-drop-mascot {
  display: flex;
  flex: 0 0 206rpx;
  width: 206rpx;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #EEF0FF 0%, #F9EFFF 100%);
}

.memory-drop-image {
  flex: 0 0 206rpx;
  width: 206rpx;
  height: 100%;
}

.memory-drop-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  padding: 26rpx 26rpx 22rpx 30rpx;
  border-left: 2rpx dashed #E3E5F2;
}

.memory-drop-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.memory-drop-kind {
  color: var(--brand-primary-deep);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.memory-drop-number {
  color: #B1B5C7;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.memory-drop-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.memory-drop-note {
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-drop-action {
  margin-top: auto;
  color: var(--brand-primary-deep);
  font-size: 21rpx;
  font-weight: 600;
}

.time-view-switcher {
  position: relative;
  display: flex;
  width: 100%;
  border-bottom: 1rpx solid var(--line);
}

.time-view-option {
  position: relative;
  flex: 1;
  padding: 16rpx 20rpx 20rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.time-view-option.is-active {
  color: var(--ink);
}

.time-view-option.is-active::after {
  position: absolute;
  right: 28%;
  bottom: -1rpx;
  left: 28%;
  height: 5rpx;
  border-radius: 99rpx 99rpx 0 0;
  background: var(--brand-primary);
  content: '';
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 2rpx 18rpx;
}

.month-nav-copy,
.month-nav-actions,
.month-nav-stepper {
  display: flex;
  align-items: center;
}

.month-nav-copy {
  gap: 14rpx;
}

.month-nav-actions {
  gap: 16rpx;
}

.month-nav-stepper {
  height: 58rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--surface);
}

.month-nav-btn {
  display: flex;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
}

.month-nav-arrow {
  margin-top: -4rpx;
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink-body);
}

.month-nav-divider {
  width: 1rpx;
  height: 28rpx;
  background: var(--line);
}

.month-nav-label {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.month-nav-count {
  padding: 5rpx 12rpx;
  border-radius: 99rpx;
  background: var(--surface-high);
  color: var(--brand-primary-deep);
  font-size: 19rpx;
  font-weight: 600;
}

.month-nav-today {
  color: var(--brand-primary-deep);
  font-size: 20rpx;
  font-weight: 600;
  transition: opacity 160ms ease-out;
}

/* 占位隐藏而不是移除，避免「回到今天」出现/消失时把下方内容顶得跳动 */
.month-nav-today.is-hidden {
  opacity: 0;
  pointer-events: none;
}

.calendar-wrapper {
  padding: 24rpx 20rpx 26rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.1);
  border-radius: 28rpx;
  background: var(--surface);
  box-shadow: 0 10rpx 32rpx rgba(55, 62, 112, 0.06);
}

.timeline-section {
  margin-top: 36rpx;
}

.timeline-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.all-timeline {
  margin-top: 40rpx;
}

.timeline-groups {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-left: 28rpx;
}

.timeline-groups::before {
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 8rpx;
  width: 2rpx;
  background: #D9DDFF;
  content: '';
}

.timeline-group {
  position: relative;
}

.timeline-group-date {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.timeline-group-date .muted {
  font-size: 22rpx;
  font-weight: 400;
}

.timeline-dot {
  position: absolute;
  top: 15rpx;
  left: -27rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid var(--paper);
  border-radius: 50%;
  background: var(--brand-primary);
  box-shadow: 0 0 0 3rpx #D9DDFF;
}

.timeline-group-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 列表加载骨架屏 */
.timeline-skeleton { display: block; }
.timeline-skeleton-card { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.timeline-skeleton-thumb { flex: 0 0 200rpx; width: 200rpx; height: 200rpx; }
.timeline-skeleton-body { flex: 1; padding-top: 12rpx; }

/* 按压反馈过渡 */
.time-view-option,
.month-nav-btn,
.memory-drop-card { transition: opacity 160ms ease, transform 160ms ease; }

/* 掉落卡片图片淡入 */
.memory-drop-image { opacity: 0; transition: opacity 280ms ease; }
.memory-drop-image.is-loaded { opacity: 1; }

/* 月度相册：以一张完整相册页承载月份、封面与照片日历。 */
.time-view-switcher {
  margin-bottom: 26rpx;
}

.month-nav-actions {
  flex: none;
  gap: 12rpx;
}

.month-nav-btn {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E3E5EC;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(29, 33, 55, 0.05);
}

.month-nav-arrow {
  margin: -5rpx 0 0;
  color: #252632;
  font-size: 42rpx;
  font-weight: 500;
}

.month-nav-today {
  color: var(--brand-primary-deep);
  font-size: 20rpx;
  font-weight: 600;
}

.album-stage {
  position: relative;
  height: 310rpx;
  margin: 8rpx 0 20rpx;
}

.album-cover {
  position: absolute;
  box-sizing: border-box;
  width: 178rpx;
  height: 226rpx;
  padding: 12rpx 12rpx 13rpx;
  border: 1rpx solid rgba(40, 42, 55, 0.06);
  border-radius: 8rpx;
  background: #FFFDF8;
  box-shadow: 0 14rpx 28rpx rgba(42, 44, 70, 0.14), 0 2rpx 5rpx rgba(42, 44, 70, 0.08);
  transform-origin: center bottom;
}

.album-cover-image {
  position: relative;
  width: 100%;
  height: 156rpx;
  border-radius: 3rpx;
  background: #ECEAF0;
  overflow: hidden;
}

.album-cover-photo,
.album-cover-placeholder {
  width: 100%;
  height: 100%;
}

.album-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ECEBFA 0%, #F6F0F4 100%);
}

.album-cover-caption {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  padding: 10rpx 2rpx 0;
}

.album-cover-title {
  color: #414253;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.album-cover-date {
  color: #9793A0;
  font-size: 12rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.album-cover-tape {
  position: absolute;
  top: -9rpx;
  left: 52rpx;
  z-index: 2;
  width: 74rpx;
  height: 24rpx;
  background: rgba(123, 120, 232, 0.44);
  box-shadow: 0 2rpx 5rpx rgba(63, 61, 138, 0.12);
  transform: rotate(-2deg);
}

.album-cover--left {
  top: 62rpx;
  left: 14rpx;
  z-index: 1;
  transform: rotate(-7deg);
}

.album-cover--middle {
  top: 24rpx;
  left: 154rpx;
  z-index: 2;
  transform: rotate(5deg);
}

.album-cover--front {
  top: 60rpx;
  left: 274rpx;
  z-index: 4;
  transform: rotate(-2deg);
}

.album-cover--right {
  top: 36rpx;
  left: 420rpx;
  z-index: 3;
  transform: rotate(8deg);
}

.album-film-strip {
  position: absolute;
  right: 26rpx;
  bottom: 5rpx;
  z-index: 6;
  display: flex;
  box-sizing: border-box;
  min-width: 220rpx;
  max-width: 282rpx;
  height: 70rpx;
  gap: 6rpx;
  align-items: center;
  padding: 9rpx 12rpx;
  border: 1rpx solid rgba(40, 42, 55, 0.06);
  border-radius: 7rpx;
  background: #FFFDF8;
  box-shadow: 0 10rpx 20rpx rgba(42, 44, 70, 0.15);
  overflow: hidden;
  transform: rotate(4deg);
}

.album-film-strip::before,
.album-film-strip::after {
  position: absolute;
  top: 7rpx;
  bottom: 7rpx;
  width: 3rpx;
  border-radius: 99rpx;
  background: #7B78E8;
  content: '';
  opacity: 0.7;
}

.album-film-strip::before { left: 6rpx; }
.album-film-strip::after { right: 6rpx; }

.album-film-frame {
  width: 54rpx;
  height: 48rpx;
  flex: none;
  border-radius: 2rpx;
  background: #ECEAF0;
  overflow: hidden;
}

.album-film-photo {
  width: 100%;
  height: 100%;
}

.album-film-empty {
  display: flex;
  width: 100%;
  flex-direction: column;
  padding: 0 10rpx;
}

.album-film-empty-title {
  color: #414253;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.album-film-empty-date {
  margin-top: 2rpx;
  color: #9793A0;
  font-size: 12rpx;
  letter-spacing: 1rpx;
}

/* 今日回忆退居内容区，不再与月度相册争夺首屏焦点。 */
.memory-drop-section {
  margin: 48rpx 0 0;
}

.memory-drop-heading {
  align-items: baseline;
  margin-bottom: 16rpx;
}

.memory-drop-scroll {
  width: calc(100% + 64rpx);
  margin: 0 -32rpx;
}

.memory-drop-row {
  gap: 16rpx;
  padding: 0 32rpx;
}

.memory-drop-card {
  width: 500rpx;
  height: 176rpx;
  border: 1rpx solid #E8EAF1;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.memory-drop-card::before,
.memory-drop-card::after {
  display: none;
}

.memory-drop-image,
.memory-drop-mascot {
  width: 156rpx;
  height: 100%;
  flex: 0 0 156rpx;
}

.memory-drop-copy {
  padding: 24rpx;
  border-left: 0;
}

.memory-drop-title {
  margin-top: 8rpx;
  font-size: 25rpx;
}

/* 相册封面单独承担纪念感；月份与日历恢复为中文工具层级。 */
.album-hero {
  padding: 4rpx 16rpx 0;
  border: 1rpx solid #ECEEF4;
  border-radius: 30rpx;
  background: linear-gradient(155deg, #FFFFFF 0%, #FBFAF7 100%);
  box-shadow: 0 12rpx 34rpx rgba(38, 43, 72, 0.06);
  overflow: hidden;
}

.album-hero .album-stage {
  height: 300rpx;
  margin: 0;
}

.month-nav {
  margin: 24rpx 2rpx 16rpx;
}

.month-nav-stepper {
  overflow: hidden;
}

.month-nav-stepper .month-nav-btn {
  width: 58rpx;
  height: 58rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.album-stage.is-animated .album-cover,
.album-stage.is-animated .album-film-strip {
  will-change: transform;
}

@keyframes album-sway-left {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(-7deg); }
  50% { transform: translate3d(4rpx, -8rpx, 0) rotate(-4deg); }
}

@keyframes album-sway-middle {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(5deg); }
  50% { transform: translate3d(-3rpx, -10rpx, 0) rotate(2deg); }
}

@keyframes album-sway-front {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(-2deg); }
  50% { transform: translate3d(2rpx, -7rpx, 0) rotate(1deg); }
}

@keyframes album-sway-right {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(8deg); }
  50% { transform: translate3d(-4rpx, -8rpx, 0) rotate(5deg); }
}

@keyframes album-sway-film {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(4deg); }
  50% { transform: translate3d(5rpx, -5rpx, 0) rotate(2deg); }
}

.album-stage.is-animated .album-cover--left { animation: album-sway-left 4.8s ease-in-out infinite; }
.album-stage.is-animated .album-cover--middle { animation: album-sway-middle 5.4s ease-in-out -1.1s infinite; }
.album-stage.is-animated .album-cover--front { animation: album-sway-front 4.3s ease-in-out -2s infinite; }
.album-stage.is-animated .album-cover--right { animation: album-sway-right 5s ease-in-out -0.6s infinite; }
.album-stage.is-animated .album-film-strip { animation: album-sway-film 3.9s ease-in-out -1.6s infinite; }

@media (prefers-reduced-motion: reduce) {
  .album-cover,
  .album-film-strip {
    animation: none;
  }
}
