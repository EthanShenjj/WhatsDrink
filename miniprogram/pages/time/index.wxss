.time-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.time-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 32rpx;
}

.time-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.time-state-card { display: flex; min-height: 246rpx; align-items: center; padding: 28rpx 18rpx 24rpx 30rpx; }
.time-state-copy { display: flex; min-width: 0; flex: 1; align-items: flex-start; flex-direction: column; }
.time-state-kicker { color: var(--brand-primary-deep); font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.time-state-title { margin-top: 8rpx; color: var(--ink); font-size: 31rpx; font-weight: 700; }
.time-state-message { margin: 6rpx 0 18rpx; color: var(--muted); font-size: 21rpx; line-height: 1.5; }
.time-page > brand-card { display: block; margin-bottom: 38rpx; }

.time-capsule-button {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  margin: 0;
  border: 1rpx solid var(--line);
  border-radius: 99rpx;
  background: var(--surface);
  color: var(--brand-primary-deep);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.time-capsule-button::after {
  border: 0;
}

.memory-drop-section {
  margin-bottom: 34rpx;
}

.memory-drop-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.memory-drop-heading .muted {
  font-size: 21rpx;
}

.memory-drop-scroll {
  white-space: nowrap;
}

.memory-drop-row {
  display: inline-flex;
  gap: 18rpx;
}

.memory-drop-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 420rpx;
  min-height: 248rpx;
  padding: 20rpx;
  white-space: normal;
}

.memory-drop-mascot { display: flex; height: 160rpx; align-items: center; justify-content: center; margin-bottom: 14rpx; border-radius: 20rpx; background: linear-gradient(135deg, #EEF0FF, #F7EDFF); }

.memory-drop-image {
  width: 100%;
  height: 160rpx;
  margin-bottom: 14rpx;
  border-radius: 14rpx;
}

.memory-drop-kind {
  color: var(--brand-primary-deep);
  font-size: 20rpx;
  font-weight: 700;
}

.memory-drop-title {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.memory-drop-note {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time-view-switcher {
  display: flex;
  width: 100%;
  padding: 8rpx;
  border-radius: 99rpx;
  background: var(--surface-high);
}

.time-view-option {
  flex: 1;
  padding: 14rpx 20rpx;
  border-radius: 99rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.time-view-option.is-active {
  background: var(--brand-gradient);
  box-shadow: 0 6rpx 18rpx rgba(91,108,255,.22);
  color: #fff;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 16rpx;
}

.month-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface);
  box-shadow: var(--shadow-control);
}

.month-nav-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--brand-primary-deep);
}

.month-nav-label {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.month-nav-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.month-nav-today {
  text-align: center;
  color: var(--brand-primary-deep);
  font-size: 20rpx;
  font-weight: 600;
}

.calendar-wrapper {
  padding: 24rpx 16rpx;
}

.calendar-meta {
  margin: 16rpx 8rpx 0;
  text-align: right;
  font-size: 22rpx;
}

.timeline-section {
  margin-top: 48rpx;
}

.timeline-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline-loading {
  padding: 40rpx 0;
  text-align: center;
}

.all-timeline {
  margin-top: 40rpx;
}

.timeline-groups {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-left: 28rpx;
}

.timeline-groups::before {
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 8rpx;
  width: 2rpx;
  background: #D9DDFF;
  content: '';
}

.timeline-group {
  position: relative;
}

.timeline-group-date {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.timeline-group-date .muted {
  font-size: 22rpx;
  font-weight: 400;
}

.timeline-dot {
  position: absolute;
  top: 15rpx;
  left: -27rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid var(--paper);
  border-radius: 50%;
  background: var(--brand-primary);
  box-shadow: 0 0 0 3rpx #D9DDFF;
}

.timeline-group-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
