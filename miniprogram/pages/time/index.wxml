<view class="page-shell time-page">
  <view class="time-header">
    <text class="eyebrow">TIMELINE</text>
    <view class="time-title-row">
      <text class="display-title">我的时光</text>
      <button class="time-capsule-button" hover-class="time-capsule-button--pressed" bindtap="onCapsuleTap">
        <local-icon name="clock-brand" size="28rpx" />
        <text>时光胶囊</text>
      </button>
    </view>
  </view>

  <brand-card wx:if="{{growth}}" variant="tint" interactive ariaLabel="查看本周小拾状态" bind:tap="onGrowthTap">
    <view class="time-state-card">
      <view class="time-state-copy">
        <text class="time-state-kicker">本周小拾状态</text>
        <text class="time-state-title">{{growth.weeklyTitle}}</text>
        <text class="time-state-message">{{growth.weeklyMessage}}</text>
        <growth-state-chip state="{{growth.activeColorId}}" label="{{growth.nextGoalText}}" interactive="{{false}}" />
      </view>
      <ip-mascot state="{{growth.activeColorId}}" expression="companion" size="172rpx" motion="none" label="本周的小拾" />
    </view>
  </brand-card>

  <view wx:if="{{memoryDrops.length}}" class="memory-drop-section">
    <view class="memory-drop-heading">
      <text class="section-title">今日掉落</text>
      <text class="muted">过去的记忆，今天重新遇见</text>
    </view>
    <view class="memory-drop-wrap {{memoryDrops.length === 1 ? 'is-single' : ''}}">
      <scroll-view scroll-x class="memory-drop-scroll" show-scrollbar="{{false}}">
        <view class="memory-drop-row">
          <view wx:for="{{memoryDrops}}" wx:key="id" class="memory-drop-card card" hover-class="press-dim" role="button" data-id="{{item.id}}" bindtap="onMemoryDropTap">
            <image wx:if="{{item.footprint.photos.length}}" class="memory-drop-image {{memoryImgLoaded[item.id] ? 'is-loaded' : ''}}" src="{{item.footprint.photos[0]}}" mode="aspectFill" data-id="{{item.id}}" bindload="onMemoryImgLoad" />
            <view wx:else class="memory-drop-mascot"><ip-mascot state="companion" expression="happy" size="126rpx" label="重新遇见记忆的小拾" /></view>
            <text class="memory-drop-kind">{{item.kind === 'anniversary' ? '周年记忆' : '最近的回忆'}}</text>
            <text class="memory-drop-title">{{item.title}}</text>
            <text wx:if="{{item.footprint.note}}" class="memory-drop-note">{{item.footprint.note}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="memory-drop-fade" aria-hidden="true"></view>
    </view>
  </view>

  <view class="time-view-switcher">
    <view
      class="time-view-option {{viewMode === 'calendar' ? 'is-active' : ''}}"
      hover-class="press-dim"
      role="button"
      data-mode="calendar"
      bindtap="onViewModeTap"
    >日历</view>
    <view
      class="time-view-option {{viewMode === 'timeline' ? 'is-active' : ''}}"
      hover-class="press-dim"
      role="button"
      data-mode="timeline"
      bindtap="onViewModeTap"
    >时间线</view>
  </view>

  <block wx:if="{{viewMode === 'calendar'}}">
    <view class="month-nav">
      <view class="month-nav-btn" hover-class="press-scale" bindtap="onPrevMonth" role="button" aria-label="上个月">
        <text class="month-nav-arrow">‹</text>
      </view>
      <view class="month-nav-center">
        <text class="month-nav-label">{{monthLabel}}</text>
        <text
          class="month-nav-today {{selectedKey !== todayKey ? '' : 'is-hidden'}}"
          hover-class="press-dim"
          bindtap="onTodayJump"
        >回到今天</text>
      </view>
      <view class="month-nav-btn" hover-class="press-scale" bindtap="onNextMonth" role="button" aria-label="下个月">
        <text class="month-nav-arrow">›</text>
      </view>
    </view>

    <view
      class="calendar-wrapper card"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <calendar-grid
        cells="{{cells}}"
        year="{{year}}"
        month="{{month}}"
        selectedKey="{{selectedKey}}"
        bind:select="onCellSelect"
      ></calendar-grid>
    </view>

    <view class="calendar-meta">
      <text class="muted">本月共 {{monthFootprintCount}} 个足迹</text>
    </view>

    <view class="timeline-section">
      <view class="timeline-header">
        <text class="section-title hand-underline">{{selectedDateLabel}}</text>
        <text class="muted" wx:if="{{selectedFootprints.length}}">· {{selectedFootprints.length}} 个足迹</text>
      </view>

      <view wx:if="{{selectedFootprints.length}}" class="timeline-list">
        <footprint-card
          wx:for="{{selectedFootprints}}"
          wx:key="id"
          footprint="{{item}}"
          bind:tap="onFootprintTap"
        ></footprint-card>
        <button
          wx:if="{{selectedFootprints.length < selectedFootprintTotal}}"
          class="text-button"
          bindtap="onLoadMoreSelected"
        >加载更多（{{selectedFootprints.length}} / {{selectedFootprintTotal}}）</button>
      </view>

      <ip-feedback
        wx:elif="{{!loading}}"
        type="empty"
        state="journey"
        expression="think"
        title="这一天还没有足迹"
        description="为这一天留下一段值得回味的记忆"
        actionText="去添加"
        bind:action="onAddFootprint"
      ></ip-feedback>

      <view wx:else class="timeline-skeleton">
        <view class="skeleton-card timeline-skeleton-card" wx:for="{{[0, 1]}}" wx:key="*this">
          <view class="skeleton sk-thumb timeline-skeleton-thumb"></view>
          <view class="timeline-skeleton-body">
            <view class="skeleton sk-line" style="width: 72%;"></view>
            <view class="skeleton sk-line" style="width: 52%; margin-top: 18rpx;"></view>
            <view class="skeleton sk-line" style="width: 36%; margin-top: 18rpx;"></view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="all-timeline">
    <ip-feedback
      wx:if="{{empty && !loading}}"
      type="empty"
      state="journey"
      expression="depart"
      title="时间线还是空的"
      description="记录第一处地点后，回忆会在这里按时间生长"
      actionText="添加足迹"
      bind:action="onAddFootprint"
    ></ip-feedback>
    <view wx:elif="{{loading}}" class="timeline-skeleton">
      <view class="skeleton-card timeline-skeleton-card" wx:for="{{[0, 1]}}" wx:key="*this">
        <view class="skeleton sk-thumb timeline-skeleton-thumb"></view>
        <view class="timeline-skeleton-body">
          <view class="skeleton sk-line" style="width: 72%;"></view>
          <view class="skeleton sk-line" style="width: 52%; margin-top: 18rpx;"></view>
          <view class="skeleton sk-line" style="width: 36%; margin-top: 18rpx;"></view>
        </view>
      </view>
    </view>
    <view wx:else class="timeline-groups">
      <view
        wx:for="{{timelineGroups}}"
        wx:key="key"
        wx:for-item="group"
        class="timeline-group"
      >
        <view class="timeline-group-date">
          <view class="timeline-dot"></view>
          <text>{{group.label}}</text>
          <text class="muted">{{group.total}} 个地点</text>
        </view>
        <view class="timeline-group-cards">
          <footprint-card
            wx:for="{{group.footprints}}"
            wx:key="id"
            wx:for-item="footprint"
            footprint="{{footprint}}"
            bind:tap="onFootprintTap"
          ></footprint-card>
          <button
            wx:if="{{group.footprints.length < group.total}}"
            class="text-button"
            data-key="{{group.key}}"
            bindtap="onTimelineGroupMore"
          >加载这一天的更多记录</button>
        </view>
      </view>
    </view>
  </view>

  <privacy-popup></privacy-popup>
</view>
