<view class="page-shell time-page">
  <view class="time-header">
    <text class="eyebrow">TIMELINE</text>
    <text class="display-title">我的时光</text>
  </view>

  <view
    class="time-capsule-entry"
    hover-class="time-capsule-entry--pressed"
    bindtap="onCapsuleTap"
    role="button"
    aria-label="打开时光胶囊"
  >
    <view class="time-capsule-icon">
      <local-icon name="clock-brand" size="30rpx" />
    </view>
    <view class="time-capsule-copy">
      <text class="time-capsule-title">时光胶囊</text>
      <text class="time-capsule-description">封存此刻，留给未来开启</text>
    </view>
    <text class="time-capsule-arrow">›</text>
  </view>

  <view class="time-view-switcher">
    <view
      class="time-view-option {{viewMode === 'calendar' ? 'is-active' : ''}}"
      hover-class="press-dim"
      role="button"
      data-mode="calendar"
      bindtap="onViewModeTap"
    >日历</view>
    <view
      class="time-view-option {{viewMode === 'timeline' ? 'is-active' : ''}}"
      hover-class="press-dim"
      role="button"
      data-mode="timeline"
      bindtap="onViewModeTap"
    >时间线</view>
  </view>

  <block wx:if="{{viewMode === 'calendar'}}">
    <view class="album-hero">
      <view class="album-stage {{albumMotionEnabled ? 'is-animated' : ''}}" aria-hidden="true">
        <view class="album-cover album-cover--left">
          <view class="album-cover-image">
            <image wx:if="{{monthPreviewPhotos[0]}}" class="album-cover-photo" src="{{monthPreviewPhotos[0]}}" mode="aspectFill" lazy-load />
            <view wx:else class="album-cover-placeholder">
              <ip-mascot state="companion" expression="happy" size="76rpx" motion="none" label="默认 Lumi 相册封面" />
            </view>
          </view>
          <view class="album-cover-caption">
            <text class="album-cover-title">拾光 01</text>
            <text class="album-cover-date">{{monthLabel}}</text>
          </view>
        </view>
        <view class="album-cover album-cover--middle">
          <view class="album-cover-image">
            <image wx:if="{{monthPreviewPhotos[1]}}" class="album-cover-photo" src="{{monthPreviewPhotos[1]}}" mode="aspectFill" lazy-load />
            <view wx:else class="album-cover-placeholder">
              <ip-mascot state="companion" expression="happy" size="76rpx" motion="none" label="默认 Lumi 相册封面" />
            </view>
          </view>
          <view class="album-cover-caption">
            <text class="album-cover-title">沿途 02</text>
            <text class="album-cover-date">LIFEMAP</text>
          </view>
        </view>
        <view class="album-cover album-cover--front">
          <view class="album-cover-tape"></view>
          <view class="album-cover-image">
            <image wx:if="{{monthPreviewPhotos[2]}}" class="album-cover-photo" src="{{monthPreviewPhotos[2]}}" mode="aspectFill" lazy-load />
            <view wx:else class="album-cover-placeholder">
              <ip-mascot state="companion" expression="happy" size="76rpx" motion="none" label="默认 Lumi 相册封面" />
            </view>
          </view>
          <view class="album-cover-caption">
            <text class="album-cover-title">本月拾光</text>
            <text class="album-cover-date">{{monthLabel}}</text>
          </view>
        </view>
        <view class="album-cover album-cover--right">
          <view class="album-cover-image">
            <image wx:if="{{monthPreviewPhotos[3]}}" class="album-cover-photo" src="{{monthPreviewPhotos[3]}}" mode="aspectFill" lazy-load />
            <view wx:else class="album-cover-placeholder">
              <ip-mascot state="companion" expression="happy" size="76rpx" motion="none" label="默认 Lumi 相册封面" />
            </view>
          </view>
          <view class="album-cover-caption">
            <text class="album-cover-title">留迹 04</text>
            <text class="album-cover-date">MEMORY</text>
          </view>
        </view>
        <view class="album-film-strip">
          <view wx:for="{{monthPreviewPhotos}}" wx:key="*this" class="album-film-frame">
            <image class="album-film-photo" src="{{item}}" mode="aspectFill" lazy-load />
          </view>
          <view wx:if="{{!monthPreviewPhotos.length}}" class="album-film-empty">
            <text class="album-film-empty-title">LIFEMAP</text>
            <text class="album-film-empty-date">{{monthLabel}} · 待显影</text>
          </view>
        </view>
      </view>
    </view>

    <view class="month-nav">
      <view class="month-nav-copy">
        <text class="month-nav-label">{{monthLabel}}</text>
        <text class="month-nav-count">{{monthFootprintCount}} 个足迹</text>
      </view>
      <view class="month-nav-actions">
        <text
          class="month-nav-today {{selectedKey !== todayKey ? '' : 'is-hidden'}}"
          hover-class="press-dim"
          bindtap="onTodayJump"
        >回到今天</text>
        <view class="month-nav-stepper">
          <view class="month-nav-btn" hover-class="press-scale" bindtap="onPrevMonth" role="button" aria-label="上个月">
            <text class="month-nav-arrow">‹</text>
          </view>
          <view class="month-nav-divider"></view>
          <view class="month-nav-btn" hover-class="press-scale" bindtap="onNextMonth" role="button" aria-label="下个月">
            <text class="month-nav-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <view
      class="calendar-wrapper"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <calendar-grid
        cells="{{cells}}"
        year="{{year}}"
        month="{{month}}"
        selectedKey="{{selectedKey}}"
        bind:select="onCellSelect"
      ></calendar-grid>
    </view>

    <view class="timeline-section">
      <view class="timeline-header">
        <text class="section-title hand-underline">{{selectedDateLabel}}</text>
        <text class="muted" wx:if="{{selectedFootprints.length}}">· {{selectedFootprints.length}} 个足迹</text>
      </view>

      <view wx:if="{{selectedFootprints.length}}" class="timeline-list">
        <footprint-card
          wx:for="{{selectedFootprints}}"
          wx:key="id"
          footprint="{{item}}"
          bind:tap="onFootprintTap"
        ></footprint-card>
        <button
          wx:if="{{selectedFootprints.length < selectedFootprintTotal}}"
          class="text-button"
          bindtap="onLoadMoreSelected"
        >加载更多（{{selectedFootprints.length}} / {{selectedFootprintTotal}}）</button>
      </view>

      <ip-feedback
        wx:elif="{{!loading}}"
        type="empty"
        state="journey"
        expression="think"
        title="这一天还没有足迹"
        description="为这一天留下一段值得回味的记忆"
        actionText="去添加"
        bind:action="onAddFootprint"
      ></ip-feedback>

      <view wx:else class="timeline-skeleton">
        <view class="skeleton-card timeline-skeleton-card" wx:for="{{[0, 1]}}" wx:key="*this">
          <view class="skeleton sk-thumb timeline-skeleton-thumb"></view>
          <view class="timeline-skeleton-body">
            <view class="skeleton sk-line" style="width: 72%;"></view>
            <view class="skeleton sk-line" style="width: 52%; margin-top: 18rpx;"></view>
            <view class="skeleton sk-line" style="width: 36%; margin-top: 18rpx;"></view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="all-timeline">
    <ip-feedback
      wx:if="{{empty && !loading}}"
      type="empty"
      state="journey"
      expression="depart"
      title="时间线还是空的"
      description="记录第一处地点后，回忆会在这里按时间生长"
      actionText="添加足迹"
      bind:action="onAddFootprint"
    ></ip-feedback>
    <view wx:elif="{{loading}}" class="timeline-skeleton">
      <view class="skeleton-card timeline-skeleton-card" wx:for="{{[0, 1]}}" wx:key="*this">
        <view class="skeleton sk-thumb timeline-skeleton-thumb"></view>
        <view class="timeline-skeleton-body">
          <view class="skeleton sk-line" style="width: 72%;"></view>
          <view class="skeleton sk-line" style="width: 52%; margin-top: 18rpx;"></view>
          <view class="skeleton sk-line" style="width: 36%; margin-top: 18rpx;"></view>
        </view>
      </view>
    </view>
    <view wx:else class="timeline-groups">
      <view
        wx:for="{{timelineGroups}}"
        wx:key="key"
        wx:for-item="group"
        class="timeline-group"
      >
        <view class="timeline-group-date">
          <view class="timeline-dot"></view>
          <text>{{group.label}}</text>
          <text class="muted">{{group.total}} 个地点</text>
        </view>
        <view class="timeline-group-cards">
          <footprint-card
            wx:for="{{group.footprints}}"
            wx:key="id"
            wx:for-item="footprint"
            footprint="{{footprint}}"
            bind:tap="onFootprintTap"
          ></footprint-card>
          <button
            wx:if="{{group.footprints.length < group.total}}"
            class="text-button"
            data-key="{{group.key}}"
            bindtap="onTimelineGroupMore"
          >加载这一天的更多记录</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{memoryDrops.length}}" class="memory-drop-section">
    <view class="memory-drop-heading">
      <text class="section-title">今天想起</text>
      <text class="memory-drop-caption">过去的记忆，今天重新遇见</text>
    </view>
    <scroll-view scroll-x class="memory-drop-scroll" show-scrollbar="{{false}}">
      <view class="memory-drop-row">
        <view wx:for="{{memoryDrops}}" wx:key="id" class="memory-drop-card" hover-class="press-dim" role="button" data-id="{{item.id}}" bindtap="onMemoryDropTap">
          <image wx:if="{{item.footprint.photoCount || item.footprint.photos.length}}" class="memory-drop-image {{memoryImgLoaded[item.id] ? 'is-loaded' : ''}}" src="{{(item.footprint.photoThumbs && item.footprint.photoThumbs[0]) || item.footprint.photos[0]}}" mode="aspectFill" lazy-load data-id="{{item.id}}" bindload="onMemoryImgLoad" />
          <view wx:else class="memory-drop-mascot"><ip-mascot state="companion" expression="happy" size="104rpx" label="重新遇见记忆的 Lumi" /></view>
          <view class="memory-drop-copy">
            <text class="memory-drop-kind">{{item.kind === 'anniversary' ? '周年记忆' : '最近的回忆'}}</text>
            <text class="memory-drop-title">{{item.title}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <privacy-popup></privacy-popup>
</view>
