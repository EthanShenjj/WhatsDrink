<view class="map-page theme-{{settings.theme}}" style="--status-bar: {{statusBarHeight}}px;">
  <!-- Full screen map -->
  <map
    wx:if="{{mapVisible}}"
    id="sgjMap"
    class="map-canvas"
    longitude="{{center.longitude}}"
    latitude="{{center.latitude}}"
    scale="{{scale}}"
    subkey="{{mapStyleSubkey}}"
    layer-style="{{mapLayerStyle}}"
    markers="{{markers}}"
    circles="{{growthCircles}}"
    polygons="{{provincePolygons}}"
    show-location="{{false}}"
    enable-rotate="{{false}}"
    enable-overlooking="{{true}}"
    enable-3D="{{false}}"
    show-compass="{{false}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onMarkerTap"
    bindregionchange="onRegionChange"
    binderror="onMapError"
    bindabilityfail="onMapAbilityFail"
    bindupdated="onMapUpdated"
  >
    <cover-view slot="callout">
      <block wx:for="{{markers}}" wx:key="id">
        <cover-view wx:if="{{item.photo}}" marker-id="{{item.id}}" class="photo-marker-callout">
          <cover-image class="photo-marker-image" src="{{item.photo}}" mode="aspectFill" />
          <cover-view class="photo-marker-caption">
            <cover-view class="photo-marker-title">{{item.title}}</cover-view>
          </cover-view>
        </cover-view>
      </block>
    </cover-view>
  </map>

  <view wx:if="{{!loading && !mapTilesReady && !mapLoadFailed && !mapLoadDelayed}}" class="map-runtime-status">
    <view class="map-loading-dot"></view>
    <text>地图加载中…</text>
  </view>

  <view wx:if="{{mapLoadFailed}}" class="map-runtime-error">
    <text class="map-runtime-error-title">地图暂时没有加载出来</text>
    <text class="map-runtime-error-copy">请检查网络后重试，足迹数据不会丢失</text>
    <button class="map-runtime-retry" bindtap="retryMapLoad">重新加载地图</button>
  </view>
  <view wx:if="{{dataLoadFailed && !loading}}" class="map-runtime-error map-data-error">
    <text class="map-runtime-error-title">足迹暂时没加载出来</text>
    <text class="map-runtime-error-copy">已加载的记录会保留，请检查网络后重试</text>
    <button class="map-runtime-retry" bindtap="retryFootprints">重新加载足迹</button>
  </view>
  <view wx:if="{{locationStatus === 'locating' && !mapLoadFailed && !dataLoadFailed}}" class="map-runtime-status map-locating-status">
    <view class="map-loading-dot"></view><text>正在获取当前位置…</text>
  </view>
  <view wx:if="{{!mapLoadFailed && !dataLoadFailed && (locationStatus === 'denied' || locationStatus === 'failed')}}" class="map-runtime-status is-delayed {{mode === 'lighting' ? 'is-lighting' : ''}}" bindtap="onLocate" role="button" aria-label="获取当前位置">
    <text>{{locationStatus === 'denied' ? '定位未开启，点击开启当前位置' : '暂未获取到当前位置，点击重试'}}</text>
  </view>
  <view wx:if="{{!mapLoadFailed && mapLoadDelayed && locationStatus !== 'denied' && locationStatus !== 'failed'}}" class="map-runtime-status is-delayed {{mode === 'lighting' ? 'is-lighting' : ''}}" bindtap="retryMapLoad" role="button" aria-label="重新加载地图">
    <text>地图未显示？点击重新加载</text>
  </view>

  <!-- Top safe area + mode switcher -->
  <view class="map-topbar">
    <view class="map-status-spacer"></view>
    <view class="map-topbar-row">
      <view class="mode-switcher">
        <view
          class="mode-pill {{mode === 'visited' ? 'is-active visited' : ''}}"
          hover-class="press-scale"
          data-mode="visited"
          bindtap="onModeTap"
          role="button"
          aria-label="足迹"
        >
          <local-icon name="location" size="28rpx" />
          <text class="mode-pill-label">足迹</text>
        </view>
        <view
          class="mode-pill {{mode === 'wishlist' ? 'is-active wishlist' : ''}}"
          hover-class="press-scale"
          data-mode="wishlist"
          bindtap="onModeTap"
          role="button"
          aria-label="想去"
        >
          <local-icon name="heart" size="28rpx" />
          <text class="mode-pill-label">想去</text>
        </view>
        <view
          class="mode-pill {{mode === 'lighting' ? 'is-active lighting' : ''}}"
          hover-class="press-scale"
          data-mode="lighting"
          bindtap="onModeTap"
          role="button"
          aria-label="查看点亮地图"
        >
          <local-icon name="sparkles" size="28rpx" />
          <text class="mode-pill-label">点亮</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部浮层栈：状态信息在上，快捷打卡固定靠近底部导航。 -->
  <view class="map-bottom-stack {{checkinVisible || checkinClosing || detailVisible || detailClosing || filterVisible || recordSheetVisible ? 'is-covered' : ''}}">
  <view wx:if="{{clusterTotal}}" class="unplaced-panel">
    <view class="unplaced-head">
      <text class="unplaced-title">聚合中的足迹</text>
      <text class="unplaced-count">{{clusterTotal}}</text>
      <text class="unplaced-head-action" bindtap="onClusterClose">关闭</text>
    </view>
    <scroll-view scroll-y class="unplaced-list">
      <view wx:for="{{clusterItems}}" wx:key="id" class="unplaced-row" data-id="{{item.id}}" bindtap="onClusterItemTap">
        <view class="unplaced-copy">
          <text class="unplaced-name">{{item.poiName}}</text>
          <text class="unplaced-date">{{item.dateLabel || item.locationLabel}}</text>
        </view>
        <text class="unplaced-arrow">›</text>
      </view>
    </scroll-view>
    <view wx:if="{{clusterItems.length < clusterTotal}}" class="unplaced-more" bindtap="onClusterLoadMore">加载更多</view>
  </view>
  <view wx:if="{{unplacedTotal && mode !== 'lighting' && !clusterTotal}}" class="unplaced-panel">
    <view class="unplaced-head">
      <text class="unplaced-title">{{mode === 'wishlist' ? '想去的地方' : '待补充位置'}}</text>
      <text class="unplaced-count">{{unplacedTotal}}</text>
    </view>
    <scroll-view scroll-y class="unplaced-list">
      <view
        wx:for="{{unplacedFootprints}}"
        wx:key="id"
        class="unplaced-row {{selectedWishlistId === item.id ? 'is-selected' : ''}}"
        hover-class="press-dim"
        data-id="{{item.id}}"
        bindtap="onUnplacedTap"
        role="button"
        aria-label="{{mode === 'wishlist' && item.canFocusOnMap ? '查看' : '为'}} {{item.poiName}} {{mode === 'wishlist' && item.canFocusOnMap ? '在地图上的位置' : '补充位置'}}"
      >
        <view class="unplaced-thumb">
          <image wx:if="{{item.photo}}" class="unplaced-photo" src="{{item.photo}}" mode="aspectFill" lazy-load />
          <view wx:else class="unplaced-placeholder">
            <ip-mascot state="companion" expression="happy" size="68rpx" motion="none" label="默认 Lumi 足迹封面" />
          </view>
        </view>
        <view class="unplaced-copy">
          <text class="unplaced-name">{{item.poiName}}</text>
          <view class="unplaced-meta">
            <text class="unplaced-status {{item.isWishlist ? 'is-wishlist' : ''}}">{{item.statusLabel}}</text>
            <text class="unplaced-date">{{mode === 'wishlist' ? item.locationLabel : (item.dateLabel || item.locationLabel)}}</text>
          </view>
        </view>
        <view wx:if="{{mode === 'wishlist' && !item.hasExactLocation}}" class="unplaced-edit" data-id="{{item.id}}" catchtap="onUnplacedEdit" role="button" aria-label="为 {{item.poiName}} 补充精确位置">补位置</view>
        <text wx:else class="unplaced-arrow">›</text>
      </view>
    </scroll-view>
    <view wx:if="{{unplacedFootprints.length < unplacedTotal}}" class="unplaced-more" bindtap="onUnplacedLoadMore">加载更多</view>
  </view>

  <view wx:if="{{modeEmpty && !loading && !dataLoadFailed && mode !== 'lighting'}}" class="map-empty">
    <ip-mascot state="{{growth.activeColorId || 'journey'}}" expression="think" size="104rpx" motion="none" label="正在等你出发的 Lumi" />
    <view class="map-empty-copy">
      <text class="map-empty-title">{{modeEmptyTitle}}</text>
      <text class="map-empty-description">{{modeEmptyDescription}}</text>
    </view>
    <view
      class="map-empty-action {{activeFilterCount ? 'is-clear-filter' : mode === 'visited' ? 'is-city-entry' : ''}}"
      hover-class="press-scale"
      bindtap="onEmptyAction"
      role="button"
      aria-label="{{activeFilterCount ? '清除筛选' : mode === 'wishlist' ? '收藏想去地点' : '点亮去过的城市'}}"
    >
      <text wx:if="{{activeFilterCount}}">清除筛选</text>
      <text wx:elif="{{mode === 'visited'}}">点亮去过的城市</text>
      <local-icon wx:else name="add-white" size="34rpx" />
    </view>
  </view>

  <cover-view
    wx:if="{{mode === 'visited' && tabReady && !modeEmpty && !recordSheetVisible && !checkinVisible && !checkinClosing && !detailVisible && !detailClosing && !filterVisible}}"
    class="map-checkin-cta {{checkinPressed ? 'map-checkin-cta--pressed' : ''}}"
    bindtouchstart="onCheckinPressStart"
    bindtouchend="onCheckinPressEnd"
    bindtouchcancel="onCheckinPressEnd"
    bindtap="onCheckin"
    role="button"
    aria-label="当前位置快捷打卡"
  >
    <cover-view class="map-checkin-icon">
      <cover-image class="map-checkin-icon-image" src="/assets/icons/locate-white.png" />
    </cover-view>
    <cover-view class="map-checkin-copy">
      <cover-view class="map-checkin-title">快捷打卡</cover-view>
      <cover-view class="map-checkin-subtitle">记录此刻位置</cover-view>
    </cover-view>
  </cover-view>
  </view>

  <scroll-view
    wx:if="{{activeFilterCount > 0}}"
    class="active-filter-bar {{mode === 'lighting' ? 'is-lighting' : ''}}"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="active-filter-list">
      <view
        wx:for="{{activeFilterChips}}"
        wx:key="key"
        class="active-filter-chip"
        hover-class="press-dim"
        data-key="{{item.key}}"
        bindtap="onFilterChipRemove"
        role="button"
        aria-label="移除筛选 {{item.label}}"
      >
        <text>{{item.label}}</text>
        <text class="active-filter-close">×</text>
      </view>
    </view>
  </scroll-view>

  <!-- 点亮地图：让已到访地区的真实轮廓成为视觉主角。 -->
  <view wx:if="{{mode === 'lighting' && lighting}}" class="lighting-panel">
    <view class="lighting-header">
      <text class="lighting-title">我的点亮版图</text>
      <text class="lighting-hint">点按地图上的省份，看看留在那里的回忆</text>
      <view class="lighting-add-city" bindtap="onAddCity" role="button" aria-label="继续点亮去过的城市">＋ 再点亮一城</view>
    </view>
    <view class="lighting-stats">
      <view class="lighting-stat">
        <text class="lighting-stat-value">{{lighting.cities}}</text>
        <text class="lighting-stat-label">城市</text>
      </view>
      <view class="lighting-stat">
        <text class="lighting-stat-value">{{provinceOverviews.length}}</text>
        <text class="lighting-stat-label">省区</text>
      </view>
      <view class="lighting-stat">
        <text class="lighting-stat-value">{{lighting.places}}</text>
        <text class="lighting-stat-label">地点</text>
      </view>
    </view>
    <scroll-view wx:if="{{provinceOverviews.length}}" scroll-x class="lighting-province-scroll" show-scrollbar="{{false}}">
      <view class="lighting-province-chips">
        <view wx:for="{{provinceOverviews}}" wx:key="name" class="lighting-province-chip {{selectedProvince === item.name ? 'is-selected' : ''}}" data-name="{{item.name}}" bindtap="onProvinceChipTap" role="button" aria-label="查看 {{item.name}} 的足迹">
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{mode === 'lighting' && selectedProvince}}" class="lighting-region-card">
    <view class="lighting-region-heading">
      <view>
        <text class="lighting-region-eyebrow">{{selectedProvinceOverview ? '已点亮的地方' : '尚未点亮'}}</text>
        <text class="lighting-region-title">{{selectedProvince}}</text>
      </view>
      <view class="lighting-region-close" bindtap="onProvinceCardClose" role="button" aria-label="收起地区卡片">×</view>
    </view>
    <view wx:if="{{selectedProvinceOverview}}" class="lighting-region-numbers">
      <text>{{selectedProvinceOverview.places}} 个地点</text>
      <text>{{selectedProvinceOverview.visits}} 次到访</text>
      <text wx:if="{{selectedProvinceOverview.cities}}">已点亮 {{selectedProvinceOverview.cities}} 城</text>
    </view>
    <scroll-view wx:if="{{selectedProvinceOverview && selectedProvinceOverview.cityNames.length}}" scroll-x class="lighting-city-scroll" show-scrollbar="{{false}}">
      <view class="lighting-city-list">
        <view wx:for="{{selectedProvinceOverview.cityNames}}" wx:key="*this" class="lighting-city" data-city="{{item}}" bindtap="onCityTap" role="button" aria-label="为 {{item}} 补具体地点">{{item}} <text>＋地点</text></view>
      </view>
    </scroll-view>
    <scroll-view wx:if="{{selectedProvinceOverview && selectedProvinceOverview.memories.length}}" scroll-x class="lighting-memory-scroll" show-scrollbar="{{false}}">
      <view class="lighting-memory-list">
        <view wx:for="{{selectedProvinceOverview.memories}}" wx:key="id" class="lighting-memory" data-id="{{item.id}}" bindtap="onProvinceMemoryTap" role="button" aria-label="查看 {{item.poiName}} 的足迹">
          <image wx:if="{{item.photo}}" class="lighting-memory-photo" src="{{item.photo}}" mode="aspectFill" lazy-load />
          <view wx:else class="lighting-memory-placeholder"><local-icon name="location" size="32rpx" /></view>
          <view class="lighting-memory-copy"><text class="lighting-memory-name">{{item.poiName}}</text><text class="lighting-memory-date">{{item.date}}</text></view>
        </view>
      </view>
    </scroll-view>
    <text wx:if="{{!selectedProvinceOverview}}" class="lighting-region-empty">点亮去过的城市，让这片地方成为你的版图。</text>
    <view wx:if="{{selectedProvinceOverview}}" class="lighting-region-actions">
      <view bindtap="onProvinceAddPlace">补一处具体地点</view>
      <view bindtap="onOpenCityAlbum">预览私人记忆图</view>
    </view>
  </view>

  <!-- Map controls (right side floating) -->
  <map-controls
    wx:if="{{tabReady && !(mode === 'lighting' && selectedProvince)}}"
    mode="{{mode}}"
    clusterEnabled="{{clusterEnabled}}"
    filterActive="{{activeFilterCount > 0}}"
    locating="{{locationStatus === 'locating'}}"
    raised="{{modeEmpty && mode !== 'lighting'}}"
    bind:filter="onFilter"
    bind:locate="onLocate"
    bind:reload="retryMapLoad"
    bind:clusterToggle="onMapControlClusterToggle"
  ></map-controls>

  <!-- Loading state -->
  <view wx:if="{{loading}}" class="map-loading">
    <view class="map-loading-dot"></view>
    <text class="map-loading-text">加载中…</text>
  </view>

  <!-- Footprint detail sheet (half screen) -->
  <view wx:if="{{(detailVisible || detailClosing) && selectedFootprint}}" class="detail-sheet-layer {{detailClosing ? 'is-closing' : ''}}">
    <view class="detail-sheet-mask" bindtap="onDetailClose" catchtouchmove="preventMove"></view>
    <view class="detail-sheet">
      <view class="detail-sheet-handle"></view>
      <footprint-card
        footprint="{{selectedFootprint}}"
        bind:tap="onDetailTap"
      ></footprint-card>
      <view class="detail-sheet-actions">
        <button class="text-button" bindtap="onDetailClose">收起</button>
        <button class="text-button" bindtap="onDetailTap">查看详情 ›</button>
      </view>
      <view class="safe-bottom"></view>
    </view>
  </view>

  <!-- Current-location check-in confirmation -->
  <view wx:if="{{checkinVisible || checkinClosing}}" class="checkin-sheet-layer {{checkinClosing ? 'is-closing' : ''}}">
    <view class="checkin-sheet-mask" bindtap="onCheckinClose" catchtouchmove="preventMove"></view>
    <view class="checkin-sheet" role="dialog" aria-modal="true" aria-labelledby="checkin-sheet-title">
      <view class="detail-sheet-handle"></view>
      <view class="checkin-sheet-heading">
        <view class="checkin-status-icon">
          <local-icon name="locate" size="38rpx" />
        </view>
        <view class="checkin-sheet-copy">
          <text id="checkin-sheet-title" class="checkin-sheet-title">当前位置打卡</text>
          <text class="checkin-location-status">当前位置已获取</text>
        </view>
      </view>

      <view wx:if="{{checkinCandidate}}" class="checkin-place-card">
        <text class="checkin-place-eyebrow">附近可打卡地点</text>
        <text class="checkin-place-name">{{checkinCandidate.footprint.poiName}}</text>
        <text wx:if="{{checkinCandidate.footprint.address}}" class="checkin-place-address">{{checkinCandidate.footprint.address}}</text>
        <view class="checkin-distance-row">
          <text>距当前位置约 {{checkinDistance}} 米</text>
          <text class="checkin-place-type">{{checkinCandidate.action === 'fulfill' ? '到访想去地点' : '再次到访'}}</text>
        </view>
      </view>

      <view wx:else class="checkin-place-card is-empty">
        <text class="checkin-place-eyebrow">附近暂无已保存地点</text>
        <text class="checkin-place-name">选择当前到访的地点</text>
        <text class="checkin-place-address">选择后会带入地点与坐标，完成本次到访记录。</text>
      </view>

      <button wx:if="{{checkinCandidate}}" class="primary-button checkin-primary" bindtap="onCheckinConfirm">继续记录这次到访</button>
      <button class="secondary-button checkin-secondary" bindtap="onCheckinChoosePlace">{{checkinCandidate ? '选择其他地点' : '选择地点打卡'}}</button>
      <button class="checkin-cancel" bindtap="onCheckinClose">取消</button>
      <view class="safe-bottom"></view>
    </view>
  </view>

  <!-- Filter sheet -->
  <filter-sheet
    regionCities="{{regionCities}}"
    visible="{{filterVisible}}"
    currentFilter="{{currentFilter}}"
    moods="{{moods}}"
    categories="{{categories}}"
    bind:apply="onFilterApply"
    bind:reset="onFilterReset"
    bind:close="onFilterClose"
  ></filter-sheet>

  <privacy-popup></privacy-popup>
</view>
