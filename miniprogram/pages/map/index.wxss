.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: var(--brand-bg);
}

.map-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.map-runtime-status,
.map-runtime-error {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 18;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  transform: translate(-50%, -50%);
  border: 1rpx solid rgba(91, 108, 255, 0.12);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 32rpx rgba(55, 64, 134, 0.14);
  color: var(--muted);
}
.map-data-error { z-index: 32; }
.map-locating-status { top: calc(var(--status-bar) + 270rpx); z-index: 24; }

.map-runtime-status {
  gap: 14rpx;
  padding: 20rpx 28rpx;
  border-radius: 99rpx;
  font-size: 24rpx;
}

.map-runtime-error {
  width: 520rpx;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  text-align: center;
}

.map-runtime-error-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.map-runtime-error-copy {
  font-size: 22rpx;
  line-height: 34rpx;
}

.map-runtime-retry {
  min-width: 240rpx;
  margin: 8rpx 0 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 99rpx;
  background: #5B6CFF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.map-runtime-retry::after { border: 0; }

.photo-marker-callout {
  position: relative;
  width: 150rpx;
  height: 136rpx;
  padding: 6rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(40, 45, 84, 0.24);
  overflow: hidden;
}

.photo-marker-image {
  width: 100%;
  height: 88rpx;
  border-radius: 14rpx 14rpx 8rpx 8rpx;
}

.photo-marker-caption {
  display: flex;
  height: 36rpx;
  align-items: center;
  padding: 0 8rpx;
  background: #FFFFFF;
}

.photo-marker-title {
  width: 100%;
  overflow: hidden;
  color: #17182B;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Top bar */
.map-topbar {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.map-status-spacer {
  height: calc(var(--status-bar) + 24rpx);
  width: 100%;
}

.map-topbar-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  pointer-events: auto;
}

.mode-switcher {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 5rpx 16rpx rgba(68, 76, 145, 0.11);
}

.mode-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 68rpx;
  padding: 0 20rpx;
  border-radius: 99rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  transition: all 160ms ease;
}

.mode-pill.is-active.visited {
  background: linear-gradient(135deg, #5B76FF, #7D76FF);
  color: #fff;
}

.mode-pill.is-active.wishlist {
  background: #FFF0D0;
  color: #93620B;
}

.mode-pill.is-active.lighting {
  background: linear-gradient(135deg, #5B76FF, var(--brand-lavender));
  color: #fff;
}

.mode-pill.is-active.visited local-icon,
.mode-pill.is-active.lighting local-icon { filter: brightness(0) invert(1); }

.active-filter-bar {
  position: absolute;
  top: calc(var(--status-bar) + 150rpx);
  right: 0;
  left: 0;
  z-index: 28;
  width: 100%;
  white-space: nowrap;
  pointer-events: auto;
}

.active-filter-bar.is-lighting { top: calc(var(--status-bar) + 438rpx); }

.active-filter-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 156rpx 8rpx 32rpx;
}

.active-filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.2);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 16rpx rgba(68, 76, 145, 0.1);
  color: var(--brand-primary-deep);
  font-size: 22rpx;
}

.active-filter-close {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1;
}

/* Lighting panel */
.lighting-panel {
  position: absolute;
  top: calc(var(--status-bar) + 160rpx);
  right: 32rpx;
  left: 32rpx;
  z-index: 20;
  padding: 22rpx 26rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 10rpx 30rpx rgba(55, 64, 134, .12);
  pointer-events: auto;
}

.lighting-header {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-bottom: 14rpx;
}

.lighting-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.lighting-hint { color: var(--muted); font-size: 20rpx; }

.lighting-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.lighting-stat {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
  padding: 8rpx 4rpx;
  border-radius: 14rpx;
  background: #F4F5FF;
}

.lighting-stat-value {
  color: var(--brand-primary-deep);
  font-size: 32rpx;
  font-weight: 700;
}

.lighting-stat-label {
  color: var(--muted);
  font-size: 20rpx;
}

.lighting-province-scroll,
.lighting-memory-scroll { width: 100%; white-space: nowrap; }

.lighting-province-chips,
.lighting-memory-list { display: inline-flex; gap: 10rpx; }

.lighting-province-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 99rpx;
  background: #ECF0FF;
  color: var(--brand-primary-deep);
  font-size: 21rpx;
  font-weight: 600;
}

.lighting-province-chip.is-selected { background: #5B6CFF; color: #fff; }

.lighting-region-card {
  position: absolute;
  right: 28rpx;
  bottom: calc(164rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 35;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 14rpx 46rpx rgba(33, 42, 101, .18);
}

.lighting-region-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.lighting-region-eyebrow { display: block; color: var(--brand-primary-deep); font-size: 20rpx; }
.lighting-region-title { display: block; margin-top: 2rpx; color: var(--ink); font-size: 32rpx; font-weight: 700; }
.lighting-region-close { width: 48rpx; height: 48rpx; color: var(--muted); font-size: 38rpx; line-height: 44rpx; text-align: center; }
.lighting-region-numbers { display: flex; gap: 22rpx; margin: 14rpx 0; color: var(--muted); font-size: 21rpx; }
.lighting-region-empty { display: block; margin-top: 14rpx; color: var(--muted); font-size: 22rpx; }
.lighting-add-city { width: max-content; margin-top: 12rpx; color: #5B6CFF; font-size: 23rpx; font-weight: 700; }
.lighting-city-scroll { white-space: nowrap; margin: 14rpx 0; }
.lighting-city-list { display: flex; gap: 12rpx; }
.lighting-city { flex-shrink: 0; padding: 12rpx 18rpx; border-radius: 18rpx; background: #F0F3FF; color: #3543A5; font-size: 22rpx; }
.lighting-city text { color: #6875CB; }
.lighting-region-actions { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 18rpx; color: #5B6CFF; font-size: 22rpx; }
.lighting-memory { display: flex; flex-shrink: 0; align-items: center; gap: 10rpx; width: 230rpx; padding: 8rpx; border-radius: 16rpx; background: #F5F6FF; }
.lighting-memory-photo,
.lighting-memory-placeholder { flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 12rpx; }
.lighting-memory-placeholder { display: flex; align-items: center; justify-content: center; background: #E8ECFF; }
.lighting-memory-copy { display: flex; min-width: 0; flex-direction: column; gap: 2rpx; }
.lighting-memory-name { overflow: hidden; color: var(--ink); font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.lighting-memory-date { color: var(--muted); font-size: 18rpx; }

@media (max-height: 650px) {
  .lighting-panel { top: calc(var(--status-bar) + 140rpx); }
  .lighting-region-card { bottom: calc(145rpx + env(safe-area-inset-bottom)); }
}

/* 底部浮层栈：子项自上而下排列,容器锚定在 tab 栏上方,间距 14rpx 互不遮挡。
   右侧留 120rpx 让位给 map-controls 的悬浮按钮列。 */
.map-bottom-stack {
  position: absolute;
  right: 24rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 34;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  pointer-events: none;
  transition: opacity 200ms ease, visibility 200ms ease;
}

.map-bottom-stack.is-covered {
  opacity: 0;
  visibility: hidden;
}

.map-checkin-cta {
  display: flex;
  box-sizing: border-box;
  width: 264rpx;
  min-height: 84rpx;
  align-items: center;
  align-self: flex-start;
  gap: 14rpx;
  padding: 10rpx 18rpx 10rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  border-radius: 28rpx;
  background-color: #5B6CFF;
  box-shadow: 0 12rpx 30rpx rgba(62, 71, 200, 0.28);
  pointer-events: auto;
  transition: opacity 160ms ease, transform 160ms ease;
}

.map-checkin-cta--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.map-checkin-cta.is-loading {
  opacity: 0.88;
}

.map-checkin-cta.is-loading .map-checkin-icon-image {
  animation: checkin-locating 900ms ease-in-out infinite alternate;
}

@keyframes checkin-locating {
  from { transform: scale(0.88); opacity: 0.62; }
  to { transform: scale(1); opacity: 1; }
}

.map-checkin-icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.18);
}

.map-checkin-icon-image {
  width: 30rpx;
  height: 30rpx;
}

.map-checkin-copy {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.map-checkin-title {
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.map-checkin-subtitle {
  color: rgba(255, 255, 255, 0.76);
  font-size: 18rpx;
  line-height: 25rpx;
}


/* Map empty overlay */
.map-empty {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 18rpx 20rpx;
  margin-right: 120rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.98), rgba(238,240,255,.96));
  box-shadow: 0 12rpx 44rpx rgba(68, 76, 145, 0.18);
  pointer-events: auto;
}

.map-empty-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.map-empty-title { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.map-empty-description { color: var(--muted); font-size: 22rpx; line-height: 1.4; }

.map-empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 36rpx;
  background: var(--brand-gradient);
  box-shadow: 0 10rpx 24rpx rgba(91, 108, 255, 0.28);
  color: #FFFFFF;
}
.map-empty-action.is-city-entry { flex: 0 0 auto; width: auto; max-width: none; padding: 0 28rpx; border-radius: 36rpx; font-size: 23rpx; font-weight: 700; }

.map-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 25;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 40rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-control);
  pointer-events: none;
}

.map-loading-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--moss-soft);
  border-top-color: var(--moss);
  border-radius: 50%;
  animation: map-spin 720ms linear infinite;
}

.map-loading-text {
  color: var(--muted);
  font-size: 24rpx;
}

@keyframes map-spin {
  to {
    transform: rotate(360deg);
  }
}

.unplaced-panel {
  align-self: stretch;
  max-height: 336rpx;
  margin-right: 120rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, .9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 8rpx 24rpx rgba(55, 64, 134, .14);
  pointer-events: auto;
  overflow: hidden;
}

.unplaced-head {
  display: flex;
  height: 64rpx;
  align-items: center;
  gap: 10rpx;
  border-bottom: 1rpx solid rgba(88, 86, 108, .08);
}

.unplaced-title {
  color: #555163;
  font-size: 21rpx;
  font-weight: 700;
}

.unplaced-count {
  display: flex;
  min-width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  padding: 0 9rpx;
  border-radius: 99rpx;
  background: #eeecf5;
  color: #777184;
  font-size: 18rpx;
  font-weight: 700;
}

.unplaced-list { max-height: 224rpx; }
.unplaced-more { padding: 12rpx 0; color: var(--brand-primary-deep); font-size: 21rpx; font-weight: 700; text-align: center; }
.unplaced-head-action { margin-left: auto; color: var(--brand-primary-deep); font-size: 20rpx; }

.unplaced-row {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(88, 86, 108, .08);
}

.unplaced-row:last-child { border-bottom: 0; }
.unplaced-row.is-selected .unplaced-name { color: var(--brand-primary-deep); }
.unplaced-edit {
  flex: 0 0 auto;
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: #f1efff;
  color: var(--brand-primary-deep);
  font-size: 19rpx;
  font-weight: 700;
}

.unplaced-thumb {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #efefff, #e5e4f4);
  overflow: hidden;
}

.unplaced-photo { width: 100%; height: 100%; }
.unplaced-placeholder { display: flex; align-items: center; justify-content: center; }
.unplaced-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }
.unplaced-name { overflow: hidden; color: var(--ink); font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.unplaced-meta { display: flex; align-items: center; gap: 10rpx; }
.unplaced-status { color: var(--brand-primary-deep); font-size: 19rpx; font-weight: 600; }
.unplaced-status.is-wishlist { color: #9b6a15; }
.unplaced-date { color: var(--muted); font-size: 19rpx; }
.unplaced-arrow { flex: 0 0 auto; color: #aaa5b5; font-size: 38rpx; font-weight: 300; line-height: 1; }

.theme-journal .map-canvas { filter: sepia(0.16) saturate(0.88); }
.theme-night .map-canvas { filter: brightness(0.62) saturate(0.7); }

/* Detail sheet */
.detail-sheet-layer {
  position: fixed;
  z-index: 200;
  inset: 0;
}

.detail-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 27, 24, 0.4);
  animation: detail-mask-in 180ms ease-out both;
}

.detail-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
  padding: 16rpx 32rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -24rpx 80rpx rgba(28, 27, 24, 0.18);
  animation: detail-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.detail-sheet-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: var(--surface-highest);
}

.detail-sheet-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

/* Current-location check-in sheet */
.checkin-sheet-layer {
  position: fixed;
  z-index: 240;
  inset: 0;
}

.checkin-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 27, 45, 0.46);
  animation: detail-mask-in 180ms ease-out both;
}

.checkin-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
  padding: 16rpx 32rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -24rpx 80rpx rgba(28, 27, 45, 0.2);
  animation: detail-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.checkin-sheet-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.checkin-status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 22rpx;
  background: var(--brand-surface-tint);
  color: var(--brand-primary-deep);
}

.checkin-sheet-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.checkin-sheet-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.3;
}

.checkin-location-status {
  color: #2f875f;
  font-size: 22rpx;
  font-weight: 600;
}

.checkin-location-status::before { content: '●  '; }

.checkin-place-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.2);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f8f9ff, #eff1ff);
}

.checkin-place-card.is-empty {
  border-color: var(--line);
  background: var(--surface-soft);
}

.checkin-place-eyebrow {
  color: var(--brand-primary-deep);
  font-size: 20rpx;
  font-weight: 600;
}

.checkin-place-name {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.35;
}

.checkin-place-address {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.checkin-distance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
  color: var(--ink-body);
  font-size: 22rpx;
}

.checkin-place-type {
  padding: 5rpx 12rpx;
  border-radius: 99rpx;
  background: rgba(91, 108, 255, 0.12);
  color: var(--brand-primary-deep);
  font-weight: 600;
}

.checkin-primary,
.checkin-secondary {
  min-height: 84rpx;
  margin-top: 10rpx;
  font-size: 27rpx;
}

.checkin-cancel {
  min-height: 72rpx;
  margin-top: 4rpx;
  background: transparent;
  color: var(--muted);
  font-size: 24rpx;
}

.checkin-cancel::after { border: 0; }

@keyframes detail-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes detail-sheet-in {
  from {
    transform: translateY(48rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 弹层退场：mask 淡出 + 面板下滑 */
.detail-sheet-layer.is-closing .detail-sheet-mask,
.checkin-sheet-layer.is-closing .checkin-sheet-mask {
  animation: detail-mask-out 200ms ease both;
}

.detail-sheet-layer.is-closing .detail-sheet,
.checkin-sheet-layer.is-closing .checkin-sheet {
  animation: detail-sheet-out 240ms cubic-bezier(0.5, 0, 0.75, 0.4) both;
}

@keyframes detail-mask-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes detail-sheet-out {
  from {
    transform: translateY(0);
    opacity: 1;
  }
  to {
    transform: translateY(100%);
    opacity: 0;
  }
}

/* 按压反馈过渡 */
.mode-pill,
.map-empty-action { transition: transform 160ms ease; }
.active-filter-chip { transition: opacity 160ms ease; }
.map-runtime-status.is-delayed {
  /* Keep the retry chip below the mode switcher and above nearby map pins. */
  top: calc(var(--status-bar) + 190rpx);
  z-index: 24;
  max-width: 90%;
  white-space: nowrap;
}
.map-runtime-status.is-delayed.is-lighting { top: calc(var(--status-bar) + 400rpx); }
.map-empty-action.is-clear-filter {
  flex-basis: 128rpx;
  width: 128rpx;
  min-width: 128rpx;
  max-width: 128rpx;
  font-size: 22rpx;
}
