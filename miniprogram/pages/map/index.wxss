.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: var(--brand-bg);
}

.map-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.photo-marker-callout {
  position: relative;
  width: 150rpx;
  height: 136rpx;
  padding: 6rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(40, 45, 84, 0.24);
  overflow: hidden;
}

.photo-marker-image {
  width: 100%;
  height: 88rpx;
  border-radius: 14rpx 14rpx 8rpx 8rpx;
}

.photo-marker-caption {
  display: flex;
  height: 36rpx;
  align-items: center;
  padding: 0 8rpx;
  background: #FFFFFF;
}

.photo-marker-title {
  width: 100%;
  overflow: hidden;
  color: #17182B;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Top bar */
.map-topbar {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.map-status-spacer {
  height: calc(var(--status-bar) + 24rpx);
  width: 100%;
}

.map-topbar-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  pointer-events: auto;
}

.mode-switcher {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 5rpx 16rpx rgba(68, 76, 145, 0.11);
}

.mode-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 68rpx;
  padding: 0 20rpx;
  border-radius: 99rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
  transition: all 160ms ease;
}

.mode-pill.is-active.visited {
  background: linear-gradient(135deg, #5B76FF, #7D76FF);
  color: #fff;
}

.mode-pill.is-active.wishlist {
  background: #FFF0D0;
  color: #93620B;
}

.mode-pill.is-active.lighting {
  background: linear-gradient(135deg, #5B76FF, var(--brand-lavender));
  color: #fff;
}

.mode-pill.is-active.visited local-icon,
.mode-pill.is-active.lighting local-icon { filter: brightness(0) invert(1); }

.active-filter-bar {
  position: absolute;
  top: calc(var(--status-bar) + 150rpx);
  right: 0;
  left: 0;
  z-index: 28;
  width: 100%;
  white-space: nowrap;
  pointer-events: auto;
}

.active-filter-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 156rpx 8rpx 32rpx;
}

.active-filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.2);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 16rpx rgba(68, 76, 145, 0.1);
  color: var(--brand-primary-deep);
  font-size: 22rpx;
}

.active-filter-close {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1;
}

/* Lighting panel */
.lighting-panel {
  position: absolute;
  top: calc(var(--status-bar) + 160rpx);
  right: 32rpx;
  left: 32rpx;
  z-index: 20;
  padding: 36rpx 32rpx 28rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  pointer-events: auto;
}

.lighting-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 24rpx;
}

.lighting-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.lighting-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.lighting-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.lighting-stat-value {
  color: var(--moss-deep);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.lighting-stat-label {
  color: var(--muted);
  font-size: 22rpx;
}

.lighting-list {
  margin-top: 8rpx;
}

.lighting-list-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.lighting-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 底部浮层栈：子项自上而下排列,容器锚定在 tab 栏上方,间距 14rpx 互不遮挡。
   右侧留 120rpx 让位给 map-controls 的悬浮按钮列。 */
.map-bottom-stack {
  position: absolute;
  right: 24rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 34;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  pointer-events: none;
  transition: opacity 200ms ease, visibility 200ms ease;
}

.map-bottom-stack.is-covered {
  opacity: 0;
  visibility: hidden;
}

.map-checkin-cta {
  display: flex;
  width: 226rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  gap: 10rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.16);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 7rpx 20rpx rgba(55, 64, 134, 0.14);
  pointer-events: auto;
  transition: opacity 160ms ease, transform 160ms ease;
}

.map-checkin-cta--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.map-checkin-icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #F0F1FF;
}

.map-checkin-icon-image {
  width: 24rpx;
  height: 24rpx;
}

.map-checkin-title {
  color: #3E47C8;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}


/* Map empty overlay */
.map-empty {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 18rpx 20rpx;
  margin-right: 120rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.98), rgba(238,240,255,.96));
  box-shadow: 0 12rpx 44rpx rgba(68, 76, 145, 0.18);
  pointer-events: auto;
}

.map-empty-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.map-empty-title { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.map-empty-description { color: var(--muted); font-size: 22rpx; line-height: 1.4; }

.map-empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 36rpx;
  background: var(--brand-gradient);
  box-shadow: 0 10rpx 24rpx rgba(91, 108, 255, 0.28);
  color: #FFFFFF;
}

.map-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 25;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 40rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-control);
  pointer-events: none;
}

.map-loading-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--moss-soft);
  border-top-color: var(--moss);
  border-radius: 50%;
  animation: map-spin 720ms linear infinite;
}

.map-loading-text {
  color: var(--muted);
  font-size: 24rpx;
}

@keyframes map-spin {
  to {
    transform: rotate(360deg);
  }
}

.unplaced-panel {
  align-self: stretch;
  max-height: 336rpx;
  margin-right: 120rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, .9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 8rpx 24rpx rgba(55, 64, 134, .14);
  pointer-events: auto;
  overflow: hidden;
}

.unplaced-head {
  display: flex;
  height: 64rpx;
  align-items: center;
  gap: 10rpx;
  border-bottom: 1rpx solid rgba(88, 86, 108, .08);
}

.unplaced-title {
  color: #555163;
  font-size: 21rpx;
  font-weight: 700;
}

.unplaced-count {
  display: flex;
  min-width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  padding: 0 9rpx;
  border-radius: 99rpx;
  background: #eeecf5;
  color: #777184;
  font-size: 18rpx;
  font-weight: 700;
}

.unplaced-list { max-height: 272rpx; }

.unplaced-row {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(88, 86, 108, .08);
}

.unplaced-row:last-child { border-bottom: 0; }

.unplaced-thumb {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #efefff, #e5e4f4);
  overflow: hidden;
}

.unplaced-photo { width: 100%; height: 100%; }
.unplaced-placeholder { display: flex; align-items: center; justify-content: center; opacity: .48; }
.unplaced-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }
.unplaced-name { overflow: hidden; color: var(--ink); font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.unplaced-meta { display: flex; align-items: center; gap: 10rpx; }
.unplaced-status { color: var(--brand-primary-deep); font-size: 19rpx; font-weight: 600; }
.unplaced-status.is-wishlist { color: #9b6a15; }
.unplaced-date { color: var(--muted); font-size: 19rpx; }
.unplaced-arrow { flex: 0 0 auto; color: #aaa5b5; font-size: 38rpx; font-weight: 300; line-height: 1; }

.theme-journal .map-canvas { filter: sepia(0.16) saturate(0.88); }
.theme-night .map-canvas { filter: brightness(0.62) saturate(0.7); }

/* Detail sheet */
.detail-sheet-layer {
  position: fixed;
  z-index: 200;
  inset: 0;
}

.detail-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 27, 24, 0.4);
  animation: detail-mask-in 180ms ease-out both;
}

.detail-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -24rpx 80rpx rgba(28, 27, 24, 0.18);
  animation: detail-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.detail-sheet-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: var(--surface-highest);
}

.detail-sheet-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

/* Current-location check-in sheet */
.checkin-sheet-layer {
  position: fixed;
  z-index: 240;
  inset: 0;
}

.checkin-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 27, 45, 0.46);
  animation: detail-mask-in 180ms ease-out both;
}

.checkin-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -24rpx 80rpx rgba(28, 27, 45, 0.2);
  animation: detail-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.checkin-sheet-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.checkin-status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: var(--brand-surface-tint);
  color: var(--brand-primary-deep);
}

.checkin-sheet-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.checkin-sheet-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 750;
}

.checkin-location-status {
  color: #2f875f;
  font-size: 24rpx;
  font-weight: 600;
}

.checkin-location-status::before { content: '●  '; }

.checkin-place-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(91, 108, 255, 0.2);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f8f9ff, #eff1ff);
}

.checkin-place-card.is-empty {
  border-color: var(--line);
  background: var(--surface-soft);
}

.checkin-place-eyebrow {
  color: var(--brand-primary-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.checkin-place-name {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.checkin-place-address {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.checkin-distance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
  color: var(--ink-body);
  font-size: 22rpx;
}

.checkin-place-type {
  padding: 5rpx 12rpx;
  border-radius: 99rpx;
  background: rgba(91, 108, 255, 0.12);
  color: var(--brand-primary-deep);
  font-weight: 600;
}

.checkin-primary,
.checkin-secondary {
  margin-top: 14rpx;
}

.checkin-cancel {
  margin-top: 10rpx;
  background: transparent;
  color: var(--muted);
  font-size: 26rpx;
}

.checkin-cancel::after { border: 0; }

@keyframes detail-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes detail-sheet-in {
  from {
    transform: translateY(48rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 弹层退场：mask 淡出 + 面板下滑 */
.detail-sheet-layer.is-closing .detail-sheet-mask,
.checkin-sheet-layer.is-closing .checkin-sheet-mask {
  animation: detail-mask-out 200ms ease both;
}

.detail-sheet-layer.is-closing .detail-sheet,
.checkin-sheet-layer.is-closing .checkin-sheet {
  animation: detail-sheet-out 240ms cubic-bezier(0.5, 0, 0.75, 0.4) both;
}

@keyframes detail-mask-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes detail-sheet-out {
  from {
    transform: translateY(0);
    opacity: 1;
  }
  to {
    transform: translateY(100%);
    opacity: 0;
  }
}

/* 按压反馈过渡 */
.mode-pill,
.map-empty-action { transition: transform 160ms ease; }
.active-filter-chip { transition: opacity 160ms ease; }
