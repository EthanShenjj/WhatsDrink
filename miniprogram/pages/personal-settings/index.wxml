<view class="page-shell personal-settings-page">
  <view class="page-heading">
    <text class="display-title">个人设置</text>
    <text class="page-subtitle">管理你的资料、数据与隐私</text>
  </view>

  <view class="settings-group">
    <text class="group-label">个人资料</text>
    <view class="settings-card card">
      <view class="profile-row" bindtap="onProfileTap" role="button" aria-label="编辑个人资料">
        <image wx:if="{{profile.avatarUrl}}" class="profile-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="profile-avatar profile-avatar-empty">拾</view>
        <view class="row-copy">
          <text class="row-title">{{profile.nickname || '你好'}}</text>
          <text class="row-hint">{{isLoggedIn ? '修改头像和昵称' : '完善头像和昵称'}}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="settings-group">
    <text class="group-label">数据与隐私</text>
    <view class="settings-card card">
      <view class="settings-row" bindtap="onExport" role="button" aria-label="数据导出">
        <view class="row-icon"><local-icon name="download" size="34rpx" /></view>
        <view class="row-copy">
          <text class="row-title">{{exporting ? '正在整理记录…' : '数据导出'}}</text>
          <text class="row-hint">导出 JSON 记录（照片为文件引用）</text>
        </view>
        <text class="row-arrow">›</text>
      </view>

      <view class="settings-row" bindtap="onPrivacy" role="button" aria-label="隐私设置">
        <view class="row-icon"><local-icon name="lock" size="34rpx" /></view>
        <view class="row-copy">
          <text class="row-title">隐私设置</text>
          <text class="row-hint">管理位置、照片与系统权限</text>
        </view>
        <text class="row-arrow">›</text>
      </view>

      <view
        class="settings-row danger-row {{clearing ? 'is-disabled' : ''}}"
        bindtap="onClearAll"
        role="button"
        aria-label="清除所有记录"
        aria-disabled="{{clearing}}"
      >
        <view class="row-icon danger-icon"><local-icon name="delete" size="34rpx" /></view>
        <view class="row-copy">
          <text class="row-title danger-title">{{clearing ? '正在清除…' : '清除所有记录'}}</text>
          <text class="row-hint">删除足迹、照片、计划与胶囊</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <text class="danger-note">清除后无法恢复，请谨慎操作</text>
  </view>

  <view class="settings-group">
    <text class="group-label">账号管理</text>
    <view class="settings-card card">
      <view class="settings-row" bindtap="onSignOut" role="button" aria-label="退出登录">
        <view class="row-icon"><local-icon name="logout" size="34rpx" /></view>
        <view class="row-copy">
          <text class="row-title">退出登录</text>
          <text class="row-hint">隐藏本机记录，保留云端账号</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view class="settings-row danger-row {{deletingAccount ? 'is-disabled' : ''}}" bindtap="onDeleteAccount" role="button" aria-label="注销账号" aria-disabled="{{deletingAccount}}">
        <view class="row-icon danger-icon"><local-icon name="delete" size="34rpx" /></view>
        <view class="row-copy">
          <text class="row-title danger-title">{{deletingAccount ? '正在注销…' : '注销账号'}}</text>
          <text class="row-hint">永久删除个人资料和记录</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <text class="danger-note">重新进入时使用当前微信身份；注销后再次打开会创建空白账号。</text>
  </view>

  <wechat-login-sheet visible="{{loginSheetVisible}}" bind:success="onLoginSuccess" bind:cancel="onLoginCancel" />
  <privacy-popup />
</view>
