.hero {
  display: flex;
  flex-direction: column;
  padding: 12rpx 0 8rpx;
}

.hero-note {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.loading-card,
.overview-card,
.timeline,
.empty-state {
  border: 1rpx solid rgba(211, 195, 188, 0.18);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.loading-card {
  min-height: 260rpx;
  margin-top: 42rpx;
  padding: 42rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.loading-line {
  width: 48%;
  height: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 99rpx;
  background: var(--paper-deep);
}

.loading-line-wide {
  width: 82%;
  height: 38rpx;
}

.overview-card {
  position: relative;
  overflow: hidden;
  margin-top: 46rpx;
  padding: 48rpx;
}

.overview-label {
  color: var(--outline);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.summary {
  display: flex;
  align-items: center;
  margin: 32rpx 0 36rpx;
}

.summary-item {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 20rpx;
  color: var(--ink);
}

.summary-divider {
  width: 1rpx;
  height: 88rpx;
  margin: 0 28rpx;
  background: var(--line);
}

.summary-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.summary-icon-primary {
  background: rgba(255, 219, 200, 0.58);
}

.summary-icon-secondary {
  background: rgba(255, 219, 208, 0.6);
}

.summary-value {
  margin-right: 6rpx;
  color: var(--ink);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.summary-unit {
  color: var(--muted);
  font-size: 23rpx;
}

.summary-label {
  display: block;
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.record-button {
  width: 100% !important;
  max-width: none !important;
  gap: 14rpx;
  margin-right: 0 !important;
  margin-left: 0 !important;
}

.calorie-note {
  display: block;
  margin-top: 38rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 64rpx 0 28rpx;
}

.choice-shortcut {
  gap: 8rpx;
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background: var(--surface-high);
  color: var(--muted);
  font-size: 24rpx;
}

.timeline {
  display: flex;
  overflow: visible;
  flex-direction: column;
  gap: 20rpx;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.timeline-row {
  display: grid;
  min-height: 144rpx;
  grid-template-columns: 72rpx 112rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid rgba(211, 195, 188, 0.16);
  border-radius: 40rpx;
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.timeline-row:last-child {
  border-bottom: 1rpx solid rgba(211, 195, 188, 0.16);
}

.timeline-rail {
  display: none;
}

.record-time {
  color: var(--outline);
  font-size: 23rpx;
}

.record-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 36rpx;
  background: var(--paper-deep);
}

.record-main {
  min-width: 0;
}

.record-title,
.record-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 10rpx;
}

.record-title {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
}

.record-meta {
  min-width: 0;
  color: var(--muted);
  font-size: 21rpx;
}

.record-calorie {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 21rpx;
  font-weight: 600;
  white-space: nowrap;
}

.home-page > .empty-state {
  margin-top: 0;
}

.empty-state text {
  display: block;
}
