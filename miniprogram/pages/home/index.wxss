.hero {
  display: flex;
  flex-direction: column;
  padding: 28rpx 12rpx 8rpx;
}

.hero-note {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 27rpx;
}

.loading-card,
.overview-card,
.timeline,
.empty-state {
  border: 1rpx solid rgba(28, 27, 24, 0.045);
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.loading-card {
  min-height: 260rpx;
  margin-top: 42rpx;
  padding: 42rpx;
  color: var(--muted);
  font-size: var(--text-caption);
}

.loading-line {
  width: 48%;
  height: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 99rpx;
  background: var(--paper-deep);
}

.loading-line-wide {
  width: 82%;
  height: 38rpx;
}

.overview-card {
  margin-top: 38rpx;
  padding: 28rpx;
}

.overview-label {
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.summary {
  display: flex;
  align-items: center;
  margin: 26rpx 0 30rpx;
}

.summary-item {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 16rpx;
  color: var(--accent-deep);
}

.summary-divider {
  width: 1rpx;
  height: 76rpx;
  margin: 0 24rpx;
  background: var(--line);
}

.summary-value {
  margin-right: 7rpx;
  color: var(--ink);
  font-size: 46rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
}

.summary-unit {
  color: var(--muted);
  font-size: 23rpx;
}

.summary-label {
  display: block;
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.record-button {
  gap: 14rpx;
}

.calorie-note {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-align: center;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 52rpx 8rpx 24rpx;
}

.section-head .text-button {
  min-height: 68rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.64);
  font-size: 24rpx;
}

.timeline {
  overflow: hidden;
  padding: 0 26rpx;
}

.timeline-row {
  display: grid;
  grid-template-columns: 68rpx 94rpx minmax(0, 1fr);
  align-items: center;
  min-height: 158rpx;
  border-bottom: 1rpx solid var(--line);
}

.timeline-row:last-child {
  border-bottom: 0;
}

.timeline-rail {
  display: none;
}

.record-time {
  color: var(--muted);
  font-size: 22rpx;
}

.record-image {
  width: 78rpx;
  height: 94rpx;
  border-radius: 18rpx;
  background: var(--paper-deep);
}

.record-main {
  min-width: 0;
  padding-left: 18rpx;
}

.record-title,
.record-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 10rpx;
}

.record-title {
  font-size: 28rpx;
  font-weight: 600;
}

.record-meta {
  min-width: 0;
  color: var(--muted);
  font-size: 21rpx;
}

.record-calorie {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: 21rpx;
  white-space: nowrap;
}

.home-page > .empty-state {
  margin-top: 0;
}

.empty-state text {
  display: block;
}
