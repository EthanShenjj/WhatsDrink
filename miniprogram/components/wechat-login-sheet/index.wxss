.login-sheet-layer {
  position: fixed;
  z-index: 900;
  inset: 0;
}

.login-sheet-mask {
  position: absolute;
  inset: 0;
  animation: login-mask-in 180ms ease-out both;
  background: rgba(23, 24, 43, 0.46);
  backdrop-filter: blur(3rpx);
}

.login-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 16rpx 36rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-bottom: 0;
  border-radius: 40rpx 40rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -24rpx 80rpx rgba(49, 57, 121, 0.18);
  color: #17182b;
  animation: login-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.login-sheet-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 28rpx;
  border-radius: 999rpx;
  background: #dfe2f3;
}

.login-sheet-header {
  padding: 0 4rpx;
}

.login-sheet-brand {
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
  padding: 7rpx 15rpx;
  border-radius: 99rpx;
  background: #f0f1ff;
  color: #3e47c8;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 28rpx;
}

.login-sheet-brand-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #5b6cff;
  box-shadow: 0 0 0 5rpx rgba(91, 108, 255, 0.12);
}

.login-sheet-title {
  display: block;
  margin-top: 14rpx;
  color: #17182b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.login-sheet-description {
  display: block;
  margin-top: 12rpx;
  color: #6f7489;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-avatar-section {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  align-items: center;
  gap: 28rpx;
  margin: 30rpx 0 0;
  padding: 4rpx;
}

.login-avatar-button {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 120rpx;
  height: 120rpx;
  min-width: 120rpx;
  flex: 0 0 120rpx;
  align-items: center;
  justify-content: center;
  overflow: visible;
  margin: 0;
  padding: 0;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  background: linear-gradient(145deg, #eef0ff, #e2e5ff);
  box-shadow: 0 10rpx 28rpx rgba(91, 108, 255, 0.18), 0 0 0 2rpx #e7e9fb;
  color: #3e47c8;
  line-height: 1;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.login-avatar-button::after {
  border: 0;
}

.login-avatar-button image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.login-avatar-button-active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 18rpx rgba(91, 108, 255, 0.16), 0 0 0 2rpx #e7e9fb;
}

.login-avatar-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.login-avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -4rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b76ff, #a88bff);
  box-shadow: 0 5rpx 12rpx rgba(91, 108, 255, 0.28);
  color: #ffffff;
}

.login-avatar-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
  justify-content: center;
  line-height: 1.3;
}

.login-avatar-title {
  overflow: hidden;
  width: 100%;
  color: #17182b;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-avatar-hint {
  margin-top: 6rpx;
  color: #6f7489;
  font-size: 21rpx;
}

.login-avatar-action {
  margin-top: 8rpx;
  color: #3e47c8;
  font-size: 20rpx;
  font-weight: 600;
}

.login-nickname-field {
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.login-field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.login-field-label {
  color: #292b43;
  font-size: 23rpx;
  font-weight: 600;
}

.login-field-required {
  color: #5b6cff;
  font-size: 20rpx;
}

.login-nickname-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 94rpx;
  padding: 0 26rpx;
  border: 2rpx solid #e6e8f5;
  border-radius: 22rpx;
  background: #f8f8ff;
  color: #292b43;
  font-size: 28rpx;
}

.login-sheet-actions {
  display: flex;
  align-items: stretch;
  flex-direction: column;
  margin-top: 30rpx;
}

.login-confirm-button {
  display: flex;
  box-sizing: border-box;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 20rpx;
  border-radius: 47rpx;
  background: linear-gradient(135deg, #5b76ff 0%, #927dff 100%);
  box-shadow: 0 12rpx 28rpx rgba(91, 108, 255, 0.28);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
  transition: transform 160ms ease, opacity 160ms ease;
}

.login-confirm-button-active {
  transform: scale(0.985);
  opacity: 0.9;
}

.login-cancel-button {
  display: flex;
  box-sizing: border-box;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0 0 !important;
  padding: 0;
  border: 0;
  background: transparent;
  color: #3e47c8;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.login-cancel-button-active {
  opacity: 0.62;
}

.login-cancel-button::after,
.login-confirm-button::after {
  border: 0;
}

.login-cancel-button[disabled],
.login-confirm-button[disabled] {
  opacity: 0.6;
}

.login-sheet-footnote {
  display: block;
  margin-top: 20rpx;
  color: #a5a9bc;
  font-size: 19rpx;
  line-height: 1.4;
  text-align: center;
}

.login-sheet-safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

@keyframes login-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes login-sheet-in {
  from {
    transform: translateY(36rpx);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@media (max-width: 360px) {
  .login-sheet {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .login-sheet-title {
    font-size: 38rpx;
  }

  .login-avatar-section {
    gap: 22rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .login-sheet-mask,
  .login-sheet {
    animation: none;
  }

  .login-avatar-button,
  .login-confirm-button {
    transition: none;
  }
}
