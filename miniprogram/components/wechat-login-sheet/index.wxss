.login-sheet-layer {
  position: fixed;
  z-index: 900;
  inset: 0;
}

.login-sheet-mask {
  position: absolute;
  inset: 0;
  animation: login-mask-in 180ms ease-out both;
  background: rgba(28, 27, 24, 0.5);
}

.login-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 16rpx 36rpx 0;
  border-radius: 44rpx 44rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -24rpx 80rpx rgba(28, 27, 24, 0.18);
  color: #1c1b18;
  animation: login-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.login-sheet-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 32rpx;
  border-radius: 999rpx;
  background: #d8d4cd;
}

.login-sheet-header {
  padding: 0 4rpx;
}

.login-sheet-kicker {
  display: block;
  color: #a36a4d;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.login-sheet-title {
  display: block;
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.login-sheet-description {
  display: block;
  margin-top: 12rpx;
  color: #78746d;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-avatar-section {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  align-items: center;
  gap: 28rpx;
  margin: 32rpx 0 0;
  padding: 4rpx;
}

.login-avatar-button {
  position: relative;
  display: flex;
  box-sizing: border-box;
  width: 120rpx;
  height: 120rpx;
  min-width: 120rpx;
  flex: 0 0 120rpx;
  align-items: center;
  justify-content: center;
  overflow: visible;
  margin: 0;
  padding: 0;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #eee7de;
  box-shadow: 0 10rpx 26rpx rgba(84, 61, 47, 0.14);
  color: #7d4d36;
  line-height: 1;
}

.login-avatar-button::after {
  border: 0;
}

.login-avatar-button image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.login-avatar-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.login-avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -4rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #7d4d36;
  color: #ffffff;
}

.login-avatar-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
  justify-content: center;
  line-height: 1.3;
}

.login-avatar-title {
  overflow: hidden;
  width: 100%;
  color: #1c1b18;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-avatar-hint {
  margin-top: 6rpx;
  color: #8a857d;
  font-size: 21rpx;
}

.login-avatar-action {
  margin-top: 8rpx;
  color: #a36a4d;
  font-size: 20rpx;
  font-weight: 600;
}

.login-nickname-field {
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.login-field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.login-field-label {
  color: #4e4b46;
  font-size: 23rpx;
  font-weight: 600;
}

.login-field-required {
  color: #a36a4d;
  font-size: 20rpx;
}

.login-nickname-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 94rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.1);
  border-radius: 22rpx;
  background: #fbfaf8;
  font-size: 28rpx;
}

.login-sheet-actions {
  display: flex;
  align-items: stretch;
  flex-direction: column;
  margin-top: 30rpx;
}

.login-confirm-button {
  display: flex;
  box-sizing: border-box;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 20rpx;
  border-radius: 47rpx;
  background: #1f1e1b;
  box-shadow: 0 12rpx 24rpx rgba(28, 27, 24, 0.16);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
}

.login-cancel-button {
  display: flex;
  box-sizing: border-box;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0 0 !important;
  padding: 0;
  border: 0;
  background: transparent;
  color: #1c1b18;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.login-cancel-button::after,
.login-confirm-button::after {
  border: 0;
}

.login-cancel-button[disabled],
.login-confirm-button[disabled] {
  opacity: 0.6;
}

.login-sheet-footnote {
  display: block;
  margin-top: 20rpx;
  color: #aaa59d;
  font-size: 19rpx;
  line-height: 1.4;
  text-align: center;
}

.login-sheet-safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

@keyframes login-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes login-sheet-in {
  from {
    transform: translateY(36rpx);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@media (max-width: 360px) {
  .login-sheet {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .login-sheet-title {
    font-size: 38rpx;
  }

  .login-avatar-section {
    gap: 22rpx;
  }
}
