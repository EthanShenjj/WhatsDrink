.ip-feedback {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 54rpx 34rpx;
  border: 1rpx solid rgba(91, 108, 255, .08);
  border-radius: 32rpx;
  background: linear-gradient(150deg, #FFFFFF, var(--surface-high));
  box-shadow: 0 16rpx 48rpx rgba(68, 76, 145, .09);
  text-align: center;
}

.ip-feedback.is-compact { min-height: 128rpx; padding: 14rpx 18rpx; flex-direction: row; text-align: left; }
.feedback-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.feedback-title { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.feedback-description { max-width: 520rpx; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; line-height: 1.55; }
.feedback-action { min-height: 76rpx; margin-top: 24rpx; padding: 0 32rpx; border-radius: 40rpx; background: linear-gradient(135deg, #5B76FF, var(--brand-lavender)); color: #fff; font-size: 26rpx; font-weight: 650; line-height: 76rpx; }
.feedback-action::after { border: 0; }
.is-compact .feedback-copy { margin-left: 6rpx; }
.is-compact .feedback-title { font-size: 26rpx; }
.is-compact .feedback-description { margin-top: 3rpx; font-size: 20rpx; }
.is-compact .feedback-action { flex: none; min-height: 64rpx; margin: 0 0 0 12rpx; padding: 0 22rpx; line-height: 64rpx; }
.type-achievement { background: linear-gradient(145deg, #FFF9DF, #FFF0E8); }
.type-memory { background: linear-gradient(145deg, #FFFFFF, #F5EDFF); }

/* 原生 button 默认 hover 覆盖（组件样式隔离，本地定义） */
.button-hover { opacity: 0.78; }
.feedback-action { transition: opacity 160ms ease; }
