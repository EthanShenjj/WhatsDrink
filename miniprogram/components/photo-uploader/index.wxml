<view class="photo-grid">
  <view
    wx:for="{{photoList}}"
    wx:key="key"
    class="photo-cell"
  >
    <image
      class="photo-img"
      src="{{item.url}}"
      mode="aspectFill"
      lazy-load
      data-index="{{item.index}}"
      bindtap="onPreview"
      role="button"
      aria-label="预览照片"
    />
    <view wx:if="{{item.pending}}" class="photo-uploading">{{item.failed ? '上传失败' : '上传中'}}</view>
    <view
      wx:if="{{!disabled && (!item.pending || item.failed)}}"
      class="photo-remove"
      data-index="{{item.index}}"
      data-pending-index="{{item.pendingIndex}}"
      catchtap="onRemove"
      hover-class="press-scale"
      role="button"
      aria-label="{{item.pending ? '移除待上传照片' : '删除照片'}}"
    >
      <image class="photo-remove-icon" src="/assets/icons/delete.svg" mode="aspectFit" />
    </view>
  </view>

  <view
    wx:if="{{showAdd && !disabled}}"
    class="photo-add"
    bindtap="onAdd"
    hover-class="press-dim"
    role="button"
    aria-label="{{addLabel}}"
  >
    <image class="photo-add-icon" src="/assets/icons/add-circle.svg" mode="aspectFit" />
    <text class="photo-add-text">{{addLabel}}</text>
  </view>
</view>
