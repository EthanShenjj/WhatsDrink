.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
}

.photo-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  padding-bottom: calc((100% - 32rpx) / 3);
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--surface-highest);
}

.photo-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(23, 24, 43, 0.64);
  backdrop-filter: blur(4rpx);
}

.photo-remove-icon {
  width: 22rpx;
  height: 22rpx;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: calc((100% - 32rpx) / 3);
  padding-bottom: calc((100% - 32rpx) / 3);
  position: relative;
  border-radius: var(--radius-sm);
  border: 2rpx dashed var(--outline);
  background: var(--surface-soft);
  color: var(--muted);
  transition: all 160ms ease-out;
}

.photo-add::after {
  content: '';
  position: absolute;
  inset: 0;
}

.photo-add-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 56rpx;
  height: 56rpx;
  margin-top: -42rpx;
  margin-left: -28rpx;
  opacity: 0.55;
}

.photo-add-text {
  position: absolute;
  bottom: 18rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
}

.photo-add:active {
  background: var(--surface-highest);
  opacity: 0.8;
}
