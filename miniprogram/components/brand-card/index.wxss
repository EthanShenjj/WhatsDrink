.brand-card { border: 1rpx solid rgba(91,108,255,.08); border-radius: 32rpx; background: #fff; box-shadow: 0 16rpx 48rpx rgba(68,76,145,.09); overflow: hidden; }
.variant-tint { background: linear-gradient(145deg, #FFFFFF, #F0F1FF); }
.variant-gradient { background: linear-gradient(135deg, #5B76FF, #A88BFF); color: #fff; }
.variant-highlight { background: linear-gradient(145deg, #FFF8DB, #FFECE5); }
.variant-plus { background: linear-gradient(140deg, #202348, #5551B3 58%, #9272D8); color: #fff; }
.is-interactive { transition: transform 180ms ease, box-shadow 180ms ease; }
.is-interactive:active { transform: scale(.985); box-shadow: 0 8rpx 24rpx rgba(68,76,145,.12); }
