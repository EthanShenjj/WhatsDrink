.filter-layer {
  position: fixed;
  z-index: 800;
  inset: 0;
}

.filter-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 27, 24, 0.45);
  animation: filter-mask-in 180ms ease-out both;
}

.filter-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
  padding: 16rpx 32rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--paper);
  box-shadow: 0 -24rpx 80rpx rgba(28, 27, 24, 0.18);
  animation: filter-sheet-in 260ms cubic-bezier(0.22, 0.8, 0.35, 1) both;
}

.filter-handle {
  width: 64rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  border-radius: 99rpx;
  background: var(--outline);
  opacity: 0.45;
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.filter-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.filter-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface-highest);
}

.filter-close-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}

.filter-body {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
}

.filter-section {
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.filter-section:last-child {
  border-bottom: 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 650;
}

.section-clear {
  color: var(--amber-deep);
  font-size: 22rpx;
  font-weight: 500;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker {
  flex: 1;
  min-width: 0;
}

.date-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.date-pill-text {
  color: var(--ink-body);
  font-size: 26rpx;
}

.date-sep {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 24rpx;
}

.date-pill-icon,
.region-pill-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.55;
}

.region-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.region-picker {
  width: 100%;
}

.region-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.region-pill-text {
  color: var(--ink-body);
  font-size: 26rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 60rpx;
  padding: 6rpx 22rpx;
  border-radius: 99rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--ink-body);
  font-size: 24rpx;
  transition: all 160ms ease-out;
}

.chip-item.is-active {
  background: var(--moss-soft);
  border-color: var(--moss);
  color: var(--moss-deep);
  font-weight: 600;
}

.chip-item.is-mood.is-active {
  background: var(--amber-soft);
  border-color: var(--amber);
  color: var(--amber-deep);
}

.chip-emoji {
  font-size: 26rpx;
  line-height: 1;
}

.chip-text {
  font-size: 24rpx;
}

.filter-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 4rpx 16rpx;
  border-top: 1rpx solid var(--line);
}

.filter-reset {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 200rpx;
  min-height: 84rpx;
  border-radius: 42rpx;
  background: var(--surface-highest);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.filter-apply {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 84rpx;
  border-radius: 42rpx;
  background: var(--moss);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

@keyframes filter-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes filter-sheet-in {
  from { transform: translateY(48rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
