.privacy-mask {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  background: rgba(48, 31, 21, 0.42);
}

.privacy-dialog {
  width: 100%;
  padding: 42rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx;
  background: #fbf6ec;
  color: #4a2e1f;
  font-family: "Songti SC", serif;
}

.dialog-title,
.dialog-copy {
  display: block;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 600;
}

.dialog-copy {
  margin-top: 20rpx;
  color: #765d49;
  font-size: 27rpx;
  line-height: 1.75;
}

.privacy-link,
.disagree-button {
  min-height: var(--control-height, 88rpx);
  padding: 0 16rpx;
  background: transparent;
  color: var(--muted, #715946);
  font-size: var(--text-small, 26rpx);
}

.privacy-link {
  margin-top: 16rpx;
  text-align: left;
}

.agree-button {
  min-height: var(--control-height, 88rpx);
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: var(--accent-action, #b94e35);
  color: #fffaf1;
  font-size: 30rpx;
  font-weight: 600;
}

.disagree-button {
  margin-top: 12rpx;
}
