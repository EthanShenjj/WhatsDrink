.privacy-mask {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  background: rgba(28, 27, 24, 0.42);
}

.privacy-dialog {
  width: 100%;
  padding: 42rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(28, 27, 24, 0.18);
  color: #1c1b18;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.dialog-title,
.dialog-copy {
  display: block;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 600;
}

.dialog-copy {
  margin-top: 20rpx;
  color: #78746d;
  font-size: 27rpx;
  line-height: 1.75;
}

.privacy-link,
.disagree-button {
  min-height: var(--control-height, 88rpx);
  padding: 0 16rpx;
  background: transparent;
  color: var(--muted, #78746d);
  font-size: var(--text-small, 26rpx);
}

.privacy-link {
  margin-top: 16rpx;
  text-align: left;
}

.agree-button {
  min-height: var(--control-height, 88rpx);
  margin-top: 28rpx;
  border-radius: 44rpx;
  background: var(--accent-action, #1f1e1b);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.disagree-button {
  margin-top: 12rpx;
}
