.mood-wrap {
  position: relative;
}

.mood-scroll {
  width: 100%;
  white-space: nowrap;
}

.mood-row {
  display: inline-flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 4rpx;
}

.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 4rpx;
}

.mood-emoji-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--surface-highest);
  transition: background 160ms ease-out, box-shadow 160ms ease-out;
}

.is-selected .mood-emoji-wrap {
  background: var(--brand-surface-tint);
  box-shadow: 0 0 0 3rpx var(--brand-primary);
}

.mood-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.mood-label {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 500;
}

.is-selected .mood-label {
  color: var(--brand-primary-deep);
  font-weight: 600;
}

.mood-scroll-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 64rpx;
  background: linear-gradient(to left, var(--surface), rgba(255, 255, 255, 0));
  pointer-events: none;
}
