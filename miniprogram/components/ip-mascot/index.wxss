.ip-mascot {
  position: relative;
  display: block;
  flex: 0 0 auto;
  transform-origin: 50% 86%;
}

.ip-mascot-art {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  transform-origin: 50% 80%;
}

.ip-mascot-image,
.ip-mascot-accessory {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.ip-mascot-accessory { pointer-events: none; }

/* 身体和动作配件组成一个整体，与根节点的 motion 动画互不干扰。 */
.expression-happy .ip-mascot-art { transform: rotate(5deg) translateY(1rpx); }
.expression-think .ip-mascot-art,
.expression-thinking .ip-mascot-art { transform: rotate(-5deg) translate(3rpx, 2rpx); }
.expression-depart .ip-mascot-art { transform: scaleX(-1) rotate(-7deg) translateY(-1rpx); }
.expression-explore .ip-mascot-art { transform: rotate(-7deg) translate(2rpx, -3rpx); }
.expression-record .ip-mascot-art { transform: scaleX(-1) rotate(4deg) translateY(1rpx); }
.expression-companion .ip-mascot-art { transform: rotate(3deg) scale(1.06); }
.expression-collect .ip-mascot-art { transform: rotate(-4deg) scale(.96) translateY(2rpx); }
.expression-reunion .ip-mascot-art { transform: rotate(-8deg) scale(1.04) translateY(-2rpx); }

.motion-float { animation: mascot-float 3.2s ease-in-out infinite; }
.motion-pop { animation: mascot-pop 260ms cubic-bezier(.2,.85,.3,1.25) both; }

@keyframes mascot-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes mascot-pop {
  from { opacity: 0; transform: scale(.86) translateY(10rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
