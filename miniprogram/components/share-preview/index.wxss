.share-card {
  overflow: hidden;
  width: 100%;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 22rpx 60rpx rgba(68, 76, 145, 0.16);
  color: #17182B;
}

.share-brand,
.share-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}

.share-brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5B76FF, #A88BFF);
  overflow: hidden;
}

.share-brand > view:last-child {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.share-brand-name {
  font-size: 28rpx;
  font-weight: 700;
}

.share-brand-sub {
  color: #6F7489;
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.share-photos {
  display: grid;
  height: 470rpx;
  gap: 6rpx;
  background: #F0F1FF;
}

.share-photos-1 {
  grid-template-columns: 1fr;
}

.share-photos-2 {
  grid-template-columns: repeat(2, 1fr);
}

.share-photos-3 {
  grid-template-columns: 2fr 1fr;
  grid-template-rows: repeat(2, 1fr);
}

.share-photos-3 .share-photo:first-child {
  grid-row: 1 / 3;
}

.share-photo {
  width: 100%;
  height: 100%;
}

.share-photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  background: linear-gradient(145deg, #E9ECFF, #F4EAFF);
}

.share-content {
  padding: 34rpx 34rpx 26rpx;
}

.share-poi,
.share-location,
.share-meta,
.share-note {
  display: block;
}

.share-poi {
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.25;
}

.share-location,
.share-meta {
  margin-top: 10rpx;
  color: #6F7489;
  font-size: 23rpx;
}

.share-note {
  margin-top: 24rpx;
  color: #343650;
  font-size: 27rpx;
  line-height: 1.7;
}

.share-footer {
  border-top: 1rpx dashed rgba(91,108,255,.24);
  color: #6F7489;
  font-size: 18rpx;
}

.share-code-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border: 3rpx solid #3E47C8;
  color: #3E47C8;
  font-size: 14rpx;
  font-weight: 600;
  text-align: center;
}
