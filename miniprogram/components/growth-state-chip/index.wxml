<view
  class="state-chip state-{{state}} {{interactive ? 'is-interactive' : ''}}"
  hover-class="{{interactive ? 'press-dim' : 'none'}}"
  bindtap="onTap"
  role="{{interactive ? 'button' : ''}}"
  aria-label="{{label}} {{timeframe}}"
>
  <view class="state-dot"></view>
  <text class="state-label">{{label}}</text>
  <text wx:if="{{timeframe}}" class="state-time">· {{timeframe}}</text>
  <local-icon wx:if="{{locked}}" name="lock" size="24rpx" />
  <text wx:if="{{interactive}}" class="state-arrow">›</text>
</view>
