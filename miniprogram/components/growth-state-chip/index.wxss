.state-chip {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(91, 108, 255, .14);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 8rpx 22rpx rgba(68, 76, 145, .12);
  color: var(--brand-primary-deep);
  font-size: 22rpx;
  font-weight: 650;
  backdrop-filter: blur(18rpx);
}

.state-chip.is-interactive:active { transform: scale(.97); }
/* 顶部悬浮场景高度固定,单行截断,防止长标题换行把下方浮层顶偏 */
.state-label { overflow: hidden; max-width: 420rpx; text-overflow: ellipsis; white-space: nowrap; }
.state-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--brand-primary); }
.state-explore .state-dot { background: var(--state-explore); }
.state-discover .state-dot { background: var(--state-discover); }
.state-highlight .state-dot { background: var(--state-highlight); }
.state-companion .state-dot { background: var(--state-companion); }
.state-dawn .state-dot { background: #F39A79; }
.state-time { color: var(--muted); font-weight: 500; }
.state-arrow { margin-left: 2rpx; color: #8F94AC; font-size: 30rpx; line-height: 1; }

/* 按压反馈（组件样式隔离，本地定义） */
.press-dim { opacity: 0.78; }
.state-chip.is-interactive { transition: opacity 160ms ease; }
