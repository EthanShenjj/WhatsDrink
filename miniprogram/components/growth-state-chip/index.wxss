.state-chip {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(91, 108, 255, .14);
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 8rpx 22rpx rgba(68, 76, 145, .12);
  color: #3E47C8;
  font-size: 22rpx;
  font-weight: 650;
  backdrop-filter: blur(18rpx);
}

.state-chip.is-interactive:active { transform: scale(.97); }
.state-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #5B6CFF; }
.state-explore .state-dot { background: #FF8F84; }
.state-discover .state-dot { background: #42C8DF; }
.state-highlight .state-dot { background: #F4B93F; }
.state-companion .state-dot { background: #F16FA8; }
.state-dawn .state-dot { background: #F39A79; }
.state-time { color: #6F7489; font-weight: 500; }
.state-arrow { margin-left: 2rpx; color: #8F94AC; font-size: 30rpx; line-height: 1; }
