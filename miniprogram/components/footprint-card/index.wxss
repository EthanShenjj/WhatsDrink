.fp-card {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  align-items: stretch;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.fp-card.is-compact {
  gap: 18rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
}

.fp-card.is-no-photo {
  min-height: 148rpx;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(91, 108, 255, .07);
  background: linear-gradient(145deg, #FFFFFF 0%, #FBFAFF 100%);
  box-shadow: 0 10rpx 30rpx rgba(68, 76, 145, .08);
}

.fp-thumb {
  position: relative;
  display: flex;
  flex: 0 0 200rpx;
  width: 200rpx;
  height: 200rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--radius-md);
  background: var(--surface-highest);
}

.is-compact .fp-thumb {
  flex-basis: 144rpx;
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-sm);
}

.is-no-photo .fp-thumb {
  flex-basis: 92rpx;
  width: 92rpx;
  height: 92rpx;
  border: 1rpx solid rgba(111, 104, 210, .1);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #F0F1FF, #E8E7FA);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .8);
}

.is-compact.is-no-photo .fp-thumb {
  flex-basis: 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
}

.fp-thumb-img {
  width: 100%;
  height: 100%;
}

.fp-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.fp-thumb-icon {
  width: 38rpx;
  height: 38rpx;
  opacity: .48;
}

.fp-thumb-emoji { font-size: 42rpx; line-height: 1; }

.fp-status-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 99rpx;
  background: rgba(23, 24, 43, 0.62);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.is-wishlist .fp-status-badge {
  background: rgba(241, 185, 76, 0.85);
  color: #fff;
}

.fp-body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  gap: 12rpx;
}

.is-no-photo .fp-body { justify-content: center; gap: 9rpx; }

.fp-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.fp-title {
  display: -webkit-box;
  overflow: hidden;
  flex: 1;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.is-compact .fp-title {
  font-size: 28rpx;
  -webkit-line-clamp: 1;
}

.is-no-photo .fp-title { -webkit-line-clamp: 2; }

.fp-date {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.fp-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.fp-meta-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

.fp-meta-text {
  overflow: hidden;
  max-width: 320rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fp-no-photo-meta { display: flex; min-width: 0; align-items: center; gap: 12rpx; }
.fp-inline-status { flex: 0 0 auto; padding: 4rpx 12rpx; border-radius: 99rpx; background: #EEECF8; color: #625D78; font-size: 19rpx; font-weight: 600; }
.is-wishlist .fp-inline-status { background: var(--amber-soft); color: var(--amber-deep); }
.fp-inline-location { display: flex; min-width: 0; align-items: center; gap: 5rpx; color: var(--muted); font-size: 20rpx; }
.fp-inline-location .fp-meta-text { max-width: 260rpx; }

.fp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.fp-chip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 14rpx;
  border-radius: 99rpx;
  background: var(--surface-highest);
  color: var(--ink-body);
  font-size: 20rpx;
  font-weight: 500;
}

.fp-chip.is-mood {
  background: var(--amber-soft);
  color: var(--amber-deep);
}

.fp-chip-emoji {
  font-size: 22rpx;
  line-height: 1.2;
}

.is-no-photo .fp-chip { padding: 3rpx 11rpx; font-size: 18rpx; }
.is-no-photo .fp-chip-emoji { font-size: 19rpx; }

.fp-note {
  display: -webkit-box;
  overflow: hidden;
  color: var(--ink-body);
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.85;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 按压反馈与图片淡入（组件样式隔离，本地定义） */
.press-dim { opacity: 0.78; }
.fp-card { transition: opacity 160ms ease; }
.fp-thumb-img { opacity: 0; transition: opacity 280ms ease; }
.fp-thumb-img.is-loaded { opacity: 1; }
