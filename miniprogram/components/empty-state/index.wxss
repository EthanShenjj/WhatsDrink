.empty-wrap {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 64rpx 36rpx;
  border: 1rpx solid rgba(91,108,255,.07);
  border-radius: 32rpx;
  background: linear-gradient(150deg, #FFFFFF, #F0F1FF);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.empty-title { color: var(--ink); font-size: 32rpx; font-weight: 700; }
.empty-description { max-width: 520rpx; margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.65; }
.empty-action { min-height: 76rpx; margin-top: 26rpx; padding: 0 34rpx; border-radius: 40rpx; background: var(--brand-gradient); box-shadow: var(--shadow-fab); color: #fff; font-size: 26rpx; font-weight: 650; line-height: 76rpx; }
.empty-action::after { border: 0; }
