.map-controls {
  position: fixed;
  right: 32rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  z-index: 40;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 18rpx;
}

.map-controls.is-raised {
  bottom: calc(342rpx + env(safe-area-inset-bottom));
}

.mc-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,.9);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-control);
  backdrop-filter: blur(8rpx);
  transition: transform 140ms ease-out, background 140ms ease-out;
}

.mc-button:active {
  transform: scale(0.92);
  background: var(--brand-surface-tint);
}

.mc-icon {
  width: 44rpx;
  height: 44rpx;
}

.mc-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 1rpx rgba(91,108,255,.28);
}
