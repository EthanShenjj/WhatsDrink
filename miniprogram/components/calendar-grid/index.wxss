.cal-grid {
  width: 100%;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 14rpx;
  padding: 0 2rpx 12rpx;
  border-bottom: 1rpx solid #EFF0F6;
}

.cal-weekday {
  text-align: center;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 600;
}

.cal-cells {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx 6rpx;
}

.cal-cell {
  position: relative;
  display: flex;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: transparent;
  overflow: hidden;
  transition: background 160ms ease-out, box-shadow 160ms ease-out, transform 160ms ease;
}

.cal-cell.in-month:active {
  background: var(--surface-highest);
}

.cal-cell.out-month {
  background: transparent;
}

.cal-cell.out-month:active {
  background: var(--surface-highest);
}

.cell-day-out {
  color: var(--muted);
  opacity: 0.45;
  font-weight: 400;
}

@keyframes cal-slide-from-right {
  from {
    opacity: 0;
    transform: translateX(28rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes cal-slide-from-left {
  from {
    opacity: 0;
    transform: translateX(-28rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.cal-anim-next-0,
.cal-anim-next-1 {
  animation: cal-slide-from-right 220ms ease-out;
}

.cal-anim-prev-0,
.cal-anim-prev-1 {
  animation: cal-slide-from-left 220ms ease-out;
}

.cal-cell.is-today .cell-day {
  color: var(--brand-primary-deep);
  font-weight: 700;
}

.cal-cell.is-today:not(.is-selected) {
  background: #F2F3FF;
}

.cal-cell.is-selected {
  background: #EEF0FF !important;
  box-shadow: inset 0 0 0 3rpx var(--brand-primary);
}

.cal-cell.is-selected .cell-day {
  color: var(--brand-primary-deep);
  font-weight: 700;
}

.cal-cell.is-selected .cell-dot { background: var(--brand-primary-deep); }

.cell-default {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.cell-day {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}

.cell-day-on-thumb {
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  min-width: 30rpx;
  padding: 1rpx 7rpx;
  border-radius: 99rpx;
  background: rgba(23, 24, 43, 0.62);
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  text-align: center;
}

.cell-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--brand-primary);
}

.cell-thumb-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 4rpx;
}

.cell-thumb {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.cell-emoji {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rpx;
}

.cell-emoji-text {
  font-size: 28rpx;
  line-height: 1;
}

/* 按压反馈（组件样式隔离，本地定义） */
.press-scale { transform: scale(0.94); }
