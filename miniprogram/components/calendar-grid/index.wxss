.cal-grid {
  width: 100%;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.cal-weekday {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 500;
}

.cal-cells {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx 8rpx;
}

.cal-cell {
  position: relative;
  display: flex;
  aspect-ratio: 1 / 1;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: transparent;
  overflow: hidden;
  transition: background 160ms ease-out;
}

.cal-cell.in-month:active {
  background: var(--surface-highest);
}

.cal-cell.out-month {
  background: transparent;
}

.cal-cell.out-month:active {
  background: var(--surface-highest);
}

.cell-day-out {
  color: var(--muted);
  opacity: 0.45;
  font-weight: 400;
}

@keyframes cal-slide-from-right {
  from {
    opacity: 0;
    transform: translateX(28rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes cal-slide-from-left {
  from {
    opacity: 0;
    transform: translateX(-28rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.cal-anim-next-0,
.cal-anim-next-1 {
  animation: cal-slide-from-right 220ms ease-out;
}

.cal-anim-prev-0,
.cal-anim-prev-1 {
  animation: cal-slide-from-left 220ms ease-out;
}

.cal-cell.is-today .cell-day {
  color: var(--brand-primary-deep);
  font-weight: 600;
}

.cal-cell.is-today:not(.is-selected) {
  box-shadow: inset 0 0 0 2rpx rgba(91, 108, 255, 0.35);
}

.cal-cell.is-selected { background: linear-gradient(135deg, #5B76FF, #A88BFF) !important; box-shadow: 0 8rpx 20rpx rgba(91,108,255,.24); }
.cal-cell.is-selected .cell-day { color: #fff; }
.cal-cell.is-selected .cell-dot { background: #fff; }

.cell-default {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.cell-day {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
}

.cell-day-on-thumb {
  position: absolute;
  bottom: 6rpx;
  right: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 99rpx;
  background: rgba(23, 24, 43, 0.62);
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
}

.cell-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--brand-primary);
}

.cell-thumb-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.cell-thumb {
  width: 100%;
  height: 100%;
}

.cell-emoji {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.cell-emoji-text {
  font-size: 32rpx;
  line-height: 1;
}
