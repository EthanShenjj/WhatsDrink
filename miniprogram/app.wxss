page {
  --paper: #f4f2ed;
  --paper-deep: #ebe7df;
  --surface: #ffffff;
  --surface-soft: #faf9f6;
  --ink: #1c1b18;
  --muted: #78746d;
  --line: rgba(28, 27, 24, 0.09);
  --accent: #a36a4d;
  --accent-deep: #7d4d36;
  --accent-action: #1f1e1b;
  --blue: #718b96;
  --danger: #a84e42;
  --shadow-card: 0 12rpx 34rpx rgba(37, 30, 24, 0.055);
  --text-caption: 24rpx;
  --text-small: 26rpx;
  --text-body: 28rpx;
  --text-control: 30rpx;
  --radius-control: 20rpx;
  --radius-card: 28rpx;
  --control-height: 88rpx;
  min-height: 100%;
  background-color: var(--paper);
  background-image:
    radial-gradient(circle at 10% 0%, rgba(255, 255, 255, 0.92), transparent 30%),
    linear-gradient(180deg, #f1efea 0, #f6f5f2 560rpx, #f6f5f2 100%);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
}

view,
text,
button,
input,
textarea,
picker,
image,
canvas {
  box-sizing: border-box;
}

button {
  margin: 0;
  font-family: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(190rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: var(--accent-deep);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.display-title {
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 650;
  line-height: 1.16;
  letter-spacing: -1rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 650;
}

.hand-underline {
  display: inline-block;
  padding-bottom: 10rpx;
  border-bottom: 4rpx solid var(--accent);
}

.muted {
  color: var(--muted);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  border-radius: 48rpx;
  background: var(--accent-action);
  box-shadow: 0 12rpx 24rpx rgba(28, 27, 24, 0.14);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.primary-button[disabled],
.secondary-button[disabled] {
  opacity: 0.6;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 28rpx;
  border: 1rpx solid rgba(28, 27, 24, 0.14);
  border-radius: 44rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: var(--text-body);
}

.text-button {
  display: inline-flex;
  min-width: var(--control-height);
  min-height: var(--control-height);
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  background: transparent;
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.2;
}

.empty-state {
  padding: 72rpx 24rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.8;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
