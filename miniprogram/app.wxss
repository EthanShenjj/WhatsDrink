page {
  --paper: #fdfcfb;
  --paper-deep: #f2eee9;
  --surface: #ffffff;
  --surface-soft: #faf9f6;
  --surface-high: #f7f4f1;
  --surface-highest: #f2eee9;
  --ink: #321f13;
  --ink-body: #1c1c19;
  --muted: #4f453f;
  --outline: #81756e;
  --line: rgba(211, 195, 188, 0.42);
  --accent: #97472c;
  --accent-deep: #783017;
  --accent-action: #321f13;
  --accent-soft: #ffdbd0;
  --blue: #6d8ca4;
  --danger: #ba1a1a;
  --shadow-card: 0 20rpx 60rpx rgba(74, 52, 39, 0.055);
  --shadow-control: 0 14rpx 30rpx rgba(50, 31, 19, 0.1);
  --text-caption: 24rpx;
  --text-small: 27rpx;
  --text-body: 28rpx;
  --text-control: 30rpx;
  --radius-control: 32rpx;
  --radius-card: 48rpx;
  --control-height: 96rpx;
  min-height: 100%;
  background-color: var(--paper);
  color: var(--ink-body);
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
button,
input,
textarea,
picker,
image,
canvas {
  box-sizing: border-box;
}

button {
  margin: 0;
  font-family: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 40rpx 40rpx calc(176rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  display: block;
  color: var(--accent-deep);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  letter-spacing: 4rpx;
}

.display-title {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 64rpx;
  letter-spacing: -1rpx;
}

.section-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 650;
  line-height: 52rpx;
}

.hand-underline {
  display: inline-block;
  padding-bottom: 6rpx;
  border-bottom: 6rpx solid rgba(151, 71, 44, 0.14);
}

.muted {
  color: var(--muted);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 104rpx;
  border-radius: 52rpx;
  background: var(--accent-action);
  box-shadow: var(--shadow-control);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.primary-button[disabled],
.secondary-button[disabled] {
  opacity: 0.6;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--control-height);
  padding: 0 28rpx;
  border: 0;
  border-radius: 44rpx;
  background: var(--surface-highest);
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 600;
}

.text-button {
  display: inline-flex;
  min-width: var(--control-height);
  min-height: var(--control-height);
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  background: transparent;
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.2;
}

.empty-state {
  padding: 80rpx 24rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.75;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
