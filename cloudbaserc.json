{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "ethan-workspace-d7f7-d2a96457337",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "login",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "recordMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "wheelMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "accountMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "seedCatalog",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256
    },
    {
      "name": "subscriptionMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "SUBSCRIBE_TEMPLATE_ID": "hieR96ze7icSJ8tuvN7ZcjJUiaznG155yMEkbT-mHGA",
        "SUBSCRIBE_TEMPLATE_VERSION": "1.0.0",
        "SUBSCRIBE_TEMPLATE_CONTENT": "今晚喝了什么？记得来记录一下",
        "SUBSCRIBE_PAGE": "pages/home/index"
      }
    },
    {
      "name": "sendDrinkReminder",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "triggers": [
        {
          "name": "dailyDrinkReminder",
          "type": "timer",
          "config": "0 0 20 * * * *"
        }
      ]
    }
  ]
}
