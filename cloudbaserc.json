{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "ethan-workspace-d7f7k5ma0befbf77",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "login",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "footprintMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "aiAssistant",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "accountMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "travelPlanMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "timeCapsuleMutation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "shareCode",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256
    },
    {
      "name": "sendCapsuleReminder",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "triggers": [
        {
          "name": "dailyCapsuleReminder",
          "type": "timer",
          "config": "0 0 9 * * * *"
        }
      ]
    }
  ]
}
